generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model GameRound {
  id             String   @id @default(uuid())
  createdAt      DateTime @default(now())
  completedAt    DateTime?
  betAmount      Float
  mineCount      Int
  boardRows      Int      @default(5)
  boardColumns   Int      @default(5)
  minePositions  String   // JSON string array e.g. "[2, 5, 18]"
  selectedTiles  String   // JSON string array e.g. "[0, 1, 3]"
  houseEdge      Float
  multiplier     Float    @default(1.0)
  status         String   // "PLAYING", "WON", "LOST", "CASHED_OUT"
  payout         Float    @default(0.0)
}

model GameConfiguration {
  id                  String   @id @default("default")
  boardRows           Int      @default(5)
  boardColumns        Int      @default(5)
  defaultMineCount    Int      @default(5)
  minMineCount        Int      @default(1)
  maxMineCount        Int      @default(24)
  minBet              Float    @default(10)
  maxBet              Float    @default(50000)
  startingDemoBalance Float    @default(10000)
  maxDemoBalance      Float    @default(1000000)
  minDemoBalance      Float    @default(0)
  autoResetBalance    Boolean  @default(true)
  houseEdge           Float    @default(0.05) // 5%
  maxAllowedMultiplier Float   @default(10000.0)
  maxPayoutPerGame    Float    @default(1000000.0)
  emergencyStop       Boolean  @default(false)
  maintenanceMode     Boolean  @default(false)
  updatedAt           DateTime @updatedAt
}

model GameStatistics {
  id                   String   @id @default("default")
  totalGames           Int      @default(0)
  totalBets            Float    @default(0.0)
  totalPayouts         Float    @default(0.0)
  totalMineHits        Int      @default(0)
  totalCashOuts        Int      @default(0)
  updatedAt            DateTime @updatedAt
}

model DemoWallet {
  id        String   @id @default("default")
  balance   Float    @default(10000.0)
  updatedAt DateTime @updatedAt
}

model AdminSession {
  id        String   @id @default(uuid())
  token     String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
}
