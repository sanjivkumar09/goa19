<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <link rel="icon" type="image/x-icon" href="/images/bitbug_favicon.ico">
    <title>Activity - DiuWin Games</title>
    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="/css/pages-global.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.css" />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        html, body {
            height: 100%;
            width: 100%;
            margin: 0;
            padding: 0;
            background-color: #e8ecef;
            font-family: 'Outfit', sans-serif;
        }

        body {
            display: flex;
            justify-content: center;
            align-items: flex-start;
            overflow-y: auto;
        }

        .activity-app {
            width: 100%;
            max-width: 480px;
            min-height: 100vh;
            background: #F5F5F3;
            padding-bottom: 80px;
            box-shadow: 0 0 30px rgba(0, 0, 0, 0.12);
            box-sizing: border-box;
            position: relative;
        }
        
        /* Green Activity Header */
        .activity-top-header {
            background: linear-gradient(135deg, #20B96B 0%, #36C66B 100%);
            padding: 30px 20px 24px 20px;
            text-align: center;
            position: relative;
            box-shadow: 0 4px 15px rgba(32, 185, 107, 0.3);
            border-radius: 0 0 16px 16px;
        }

        .activity-header-brand {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            margin-bottom: 16px;
        }

        .activity-header-brand span {
            font-size: 26px;
            font-weight: 900;
            color: #ffffff;
            letter-spacing: -0.5px;
        }

        .activity-login-btn {
            background: #ffffff;
            color: #20B96B;
            padding: 9px 36px;
            border-radius: 25px;
            font-weight: 800;
            font-size: 14.5px;
            display: inline-block;
            text-decoration: none;
            box-shadow: 0 4px 14px rgba(0, 0, 0, 0.12);
            transition: all 0.25s ease;
            border: none;
            cursor: pointer;
        }

        .activity-login-btn:hover {
            transform: scale(1.03);
            box-shadow: 0 6px 18px rgba(0, 0, 0, 0.18);
        }

        /* 4 Quick Circular Awards Grid */
        .quick-awards-row {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 8px;
            padding: 16px 14px;
            margin-top: 4px;
        }

        .quick-award-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            text-decoration: none;
            gap: 6px;
            text-align: center;
        }

        .quick-award-icon-box {
            width: 52px;
            height: 52px;
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 2px 8px rgba(0,0,0,0.06);
            transition: transform 0.2s ease;
        }

        .quick-award-icon-box:hover {
            transform: translateY(-2px);
        }

        .quick-award-icon-box.award1 { background: linear-gradient(135deg, #e6f7f0 0%, #d1f2e3 100%); color: #20B96B; }
        .quick-award-icon-box.award2 { background: linear-gradient(135deg, #d8f5eb 0%, #ebfaf4 100%); color: #10b981; }
        .quick-award-icon-box.award3 { background: linear-gradient(135deg, #e4defa 0%, #f1edfd 100%); color: #8b5cf6; }
        .quick-award-icon-box.award4 { background: linear-gradient(135deg, #fedfc8 0%, #ffeedf 100%); color: #f97316; }

        .quick-award-icon-box i {
            font-size: 24px;
        }

        .quick-award-label {
            font-size: 11px;
            font-weight: 600;
            color: #5d6472;
            line-height: 1.2;
        }

        /* Feature Cards */
        .feature-cards-wrap {
            padding: 0 14px 14px 14px;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .activity-card {
            border-radius: 14px;
            padding: 16px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            text-decoration: none;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
            transition: transform 0.25s ease;
        }

        .activity-card:hover {
            transform: translateY(-2px);
        }

        .activity-card.gifts-card {
            background: linear-gradient(135deg, #e6f7f0 0%, #f4fbf8 100%);
            border: 1px solid #c2efe0;
        }

        .activity-card.attendance-card {
            background: linear-gradient(135deg, #e6f7f0 0%, #ffffff 100%);
            border: 1px solid #c2efe0;
        }

        .activity-card-info {
            display: flex;
            flex-direction: column;
            gap: 4px;
            max-width: 68%;
        }

        .activity-card-title {
            font-size: 16px;
            font-weight: 800;
            color: #0B1833;
            margin: 0;
        }

        .activity-card-desc {
            font-size: 11.5px;
            color: #7C8290;
            margin: 0;
            line-height: 1.35;
        }

        .activity-card-img {
            width: 72px;
            height: 72px;
            object-fit: contain;
        }

        /* Agent Luxury Rewards Banner */
        .agent-banner-card {
            margin: 0 14px 14px 14px;
            background: linear-gradient(135deg, #20B96B 0%, #36C66B 100%);
            border-radius: 14px;
            padding: 16px 18px;
            color: #ffffff;
            box-shadow: 0 4px 15px rgba(32, 185, 107, 0.3);
            display: flex;
            align-items: center;
            justify-content: space-between;
            text-decoration: none;
        }

        .agent-banner-card h4 {
            margin: 0 0 4px 0;
            font-size: 15px;
            font-weight: 800;
            color: #ffffff;
        }

        .agent-banner-card p {
            margin: 0;
            font-size: 11px;
            color: rgba(255, 255, 255, 0.9);
        }

        /* 7 Days Rewards Section */
        .checkin-section {
            padding: 0 14px 16px 14px;
        }

        .checkin-title-wrap {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 12px;
        }

        .checkin-title-wrap h3 {
            margin: 0;
            font-size: 16px;
            font-weight: 800;
            color: #0B1833;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .checkin-rule-btn {
            font-size: 12px;
            color: #20B96B;
            border: 1px solid #a3e9c5;
            border-radius: 12px;
            padding: 2px 10px;
            text-decoration: none;
            font-weight: 600;
            background: #ffffff;
        }

        .rewards-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 10px;
        }
        
        .reward-card {
            background: linear-gradient(135deg, #20B96B 0%, #36C66B 100%);
            border-radius: 12px;
            padding: 18px 14px;
            text-align: center;
            color: #ffffff;
            box-shadow: 0 4px 12px rgba(32, 185, 107, 0.25);
            transition: all 0.25s ease;
            cursor: pointer;
            position: relative;
            overflow: hidden;
            border: none;
        }
        
        .reward-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 16px rgba(32, 185, 107, 0.35);
        }
        
        .reward-card.claimed {
            background: #ffffff;
            cursor: not-allowed;
            color: #8b96a5;
            border: 1px solid #ebeef5;
            box-shadow: 0 2px 6px rgba(0,0,0,0.03);
        }
        
        .reward-amount {
            font-size: 24px;
            font-weight: 900;
            margin-bottom: 6px;
        }
        
        .reward-status {
            font-size: 12px;
            padding: 4px 14px;
            background: rgba(255, 255, 255, 0.25);
            border-radius: 15px;
            display: inline-block;
            font-weight: 700;
        }

        .reward-card.claimed .reward-status {
            background: #f4f5f8;
            color: #8b96a5;
        }
    </style>
</head>
<body>
    <div class="activity-app">
        <!-- Green Activity Top Header -->
        <div class="activity-top-header">
            <div class="activity-header-brand">
                <img src="/images/logo.png" alt="DiuWin Logo" style="height: 32px; width: auto; object-fit: contain;">
            </div>
            <a href="/login" class="activity-login-btn">Login</a>
        </div>

        <!-- 4 Quick Circular Awards Grid -->
        <div class="quick-awards-row">
            <a href="/redenvelopes" class="quick-award-item">
                <div class="quick-award-icon-box award1">
                    <i class="fa fa-trophy"></i>
                </div>
                <span class="quick-award-label">Activity Award</span>
            </a>
            <a href="/checkIn" class="quick-award-item">
                <div class="quick-award-icon-box award2">
                    <i class="fa fa-diamond"></i>
                </div>
                <span class="quick-award-label">Super Jackpot</span>
            </a>
            <a href="/redenvelopes" class="quick-award-item">
                <div class="quick-award-icon-box award3">
                    <i class="fa fa-gift"></i>
                </div>
                <span class="quick-award-label">First gift</span>
            </a>
            <a href="/redenvelopes" class="quick-award-item">
                <div class="quick-award-icon-box award4">
                    <i class="fa fa-pie-chart"></i>
                </div>
                <span class="quick-award-label">Invite Wheel</span>
            </a>
        </div>

        <!-- Gifts & Attendance Bonus Cards -->
        <div class="feature-cards-wrap">
            <a href="/redenvelopes" class="activity-card gifts-card">
                <div class="activity-card-info">
                    <h4 class="activity-card-title">Gifts</h4>
                    <p class="activity-card-desc">Enter the redemption code to receive gift rewards</p>
                </div>
                <img src="/asset/ass/turn_icon-0c8307cf.png" alt="Gifts" class="activity-card-img">
            </a>
            <a href="/checkIn" class="activity-card attendance-card">
                <div class="activity-card-info">
                    <h4 class="activity-card-title">Attendance bonus</h4>
                    <p class="activity-card-desc">The more consecutive days you sign in, the higher the reward will be.</p>
                </div>
                <img src="/asset/ass/vip_icon-0ce6fe20.png" alt="Attendance" class="activity-card-img">
            </a>
        </div>

        <!-- Agent Luxury Rewards Banner -->
        <a href="/promotion" class="agent-banner-card">
            <div>
                <h4>Become Agent Enjoy Luxury Rewards</h4>
                <p>Invite friends and earn daily agent commissions!</p>
            </div>
            <i class="fa fa-chevron-right" style="font-size: 16px;"></i>
        </a>

        <!-- 7 Days Recharge Rewards Section -->
        <div class="checkin-section">
            <div class="checkin-title-wrap">
                <h3><i class="fa fa-calendar" style="color: #20B96B;"></i> 7 Days Recharge Rewards</h3>
                <a href="/checkDes" class="checkin-rule-btn">Rules</a>
            </div>

            <div class="rewards-grid">
                <div class="reward-card" data-dpr="1">
                    <div class="reward-amount">₹50</div>
                    <div class="reward-status">Get it now</div>
                </div>
                <div class="reward-card" data-dpr="2">
                    <div class="reward-amount">₹100</div>
                    <div class="reward-status">Get it now</div>
                </div>
                <div class="reward-card" data-dpr="3">
                    <div class="reward-amount">₹150</div>
                    <div class="reward-status">Get it now</div>
                </div>
                <div class="reward-card" data-dpr="4">
                    <div class="reward-amount">₹200</div>
                    <div class="reward-status">Get it now</div>
                </div>
                <div class="reward-card" data-dpr="5">
                    <div class="reward-amount">₹250</div>
                    <div class="reward-status">Get it now</div>
                </div>
                <div class="reward-card" data-dpr="6">
                    <div class="reward-amount">₹300</div>
                    <div class="reward-status">Get it now</div>
                </div>
                <div class="reward-card" data-dpr="7">
                    <div class="reward-amount">₹400</div>
                    <div class="reward-status">Get it now</div>
                </div>
            </div>
        </div>

        <!-- Support Button -->
        <a href="/keFuMenu" class="support-btn">
            <img src="/images/customer-5ef38c22.png" alt="Support">
        </a>

        <!-- Bottom Navigation -->
        <%- include('../nav') -%>
    </div>

    <!-- Scripts -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script>
        function alertMess(text) {
            $('body').append(`
                <div style="position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); background: linear-gradient(135deg, #20B96B 0%, #36C66B 100%); color: #ffffff; padding: 14px 22px; border-radius: 12px; z-index: 99999; animation: fadeInOut 2s; font-weight: 700; box-shadow: 0 8px 25px rgba(32, 185, 107, 0.4);">
                    ${text}
                </div>
            `);
            setTimeout(() => {
                $('body > div:last').fadeOut(300, function() { $(this).remove(); });
            }, 1500);
        }

        function loadCheckInStatus() {
            $.ajax({
                type: "POST",
                url: "/api/webapi/checkIn",
                dataType: "json",
                success: function (response) {
                    if (response && response.datas && response.datas[0]) {
                        let data = response.datas[0];
                        if(data.total1 == 0) markClaimed(0);
                        if(data.total2 == 0) markClaimed(1);
                        if(data.total3 == 0) markClaimed(2);
                        if(data.total4 == 0) markClaimed(3);
                        if(data.total5 == 0) markClaimed(4);
                        if(data.total6 == 0) markClaimed(5);
                        if(data.total7 == 0) markClaimed(6);
                    }
                }
            });
        }

        function markClaimed(index) {
            $('.reward-card').eq(index)
                .addClass('claimed')
                .css('pointer-events', 'none')
                .find('.reward-status')
                .text('Received');
        }

        $('.reward-card').click(function (e) {
            e.preventDefault();
            if ($(this).hasClass('claimed')) return;
            let data = $(this).attr('data-dpr');
            let card = $(this);
            $.ajax({
                type: "POST",
                url: "/api/webapi/checkIn",
                data: { data: data },
                dataType: "json",
                success: function (response) {
                    alertMess(response.message);
                    if(response.status === true) {
                        card.addClass('claimed')
                            .css('pointer-events', 'none')
                            .find('.reward-status')
                            .text('Received');
                    }
                }
            });
        });

        $(document).ready(function() {
            loadCheckInStatus();
        });
    </script>
    <style>
        @keyframes fadeInOut {
            0% { opacity: 0; transform: translate(-50%, -40%); }
            20% { opacity: 1; transform: translate(-50%, -50%); }
            80% { opacity: 1; transform: translate(-50%, -50%); }
            100% { opacity: 0; transform: translate(-50%, -60%); }
        }
    </style>
</body>
</html>
