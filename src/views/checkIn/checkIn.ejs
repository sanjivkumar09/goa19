<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <link rel="icon" type="image/x-icon" href="/images/bitbug_favicon.ico">
    <title>Rewards - Goa Games</title>
    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="/css/pages-global.css">
    <style>
        body {
            background: var(--bg-gray);
            margin: 0;
            padding: 0;
        }
        
        .rewards-banner {
            background: linear-gradient(135deg, #ff6b6b 0%, #ee5a6f 50%, #f06595 100%);
            padding: 40px 20px;
            text-align: center;
            position: relative;
            overflow: hidden;
        }
        
        .rewards-banner::before {
            content: '🎉';
            position: absolute;
            font-size: 100px;
            opacity: 0.1;
            top: -20px;
            left: -20px;
            animation: float 3s ease-in-out infinite;
        }
        
        .rewards-banner::after {
            content: '🎁';
            position: absolute;
            font-size: 80px;
            opacity: 0.1;
            bottom: -10px;
            right: -10px;
            animation: float 4s ease-in-out infinite reverse;
        }
        
        @keyframes float {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-20px); }
        }
        
        .rewards-banner h1 {
            color: #fff;
            font-size: 24px;
            font-weight: bold;
            margin: 0 0 8px 0;
            text-shadow: 0 2px 4px rgba(0,0,0,0.2);
        }
        
        .rewards-banner p {
            color: rgba(255,255,255,0.9);
            font-size: 14px;
            margin: 0;
        }
        
        .rewards-actions {
            display: flex;
            justify-content: center;
            gap: 16px;
            margin-top: 16px;
        }
        
        .rewards-actions button {
            background: #fff;
            color: #ff6b6b;
            padding: 8px 20px;
            border-radius: 20px;
            border: none;
            font-weight: bold;
            cursor: pointer;
            font-size: 14px;
        }
        
        .rewards-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 12px;
            padding: 20px;
        }
        
        .reward-card {
            background: linear-gradient(135deg, var(--primary-green), var(--secondary-green));
            border-radius: 16px;
            padding: 24px;
            text-align: center;
            color: #fff;
            box-shadow: 0 4px 12px rgba(46, 204, 113, 0.3);
            transition: transform 0.2s, box-shadow 0.2s;
            cursor: pointer;
            position: relative;
            overflow: hidden;
        }
        
        .reward-card::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(255,255,255,0.2) 0%, transparent 70%);
            opacity: 0;
            transition: opacity 0.3s;
        }
        
        .reward-card:hover::before {
            opacity: 1;
        }
        
        .reward-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 20px rgba(46, 204, 113, 0.4);
        }
        
        .reward-card.claimed {
            background: linear-gradient(135deg, #95a5a6, #7f8c8d);
            cursor: not-allowed;
            opacity: 0.7;
        }
        
        .reward-card.claimed:hover {
            transform: none;
            box-shadow: 0 4px 12px rgba(127, 140, 141, 0.3);
        }
        
        .reward-amount {
            font-size: 32px;
            font-weight: bold;
            margin-bottom: 8px;
        }
        
        .reward-status {
            font-size: 14px;
            padding: 6px 16px;
            background: rgba(255,255,255,0.2);
            border-radius: 20px;
            display: inline-block;
        }
        
        .reward-card.claimed .reward-status {
            background: rgba(0,0,0,0.2);
        }
    </style>
</head>
<body>
    <!-- Rewards Banner -->
    <div class="rewards-banner">
        <h1>7 Days Recharge Rewards</h1>
        <p>Recharge daily and claim amazing rewards!</p>
        <div class="rewards-actions">
            <button onclick="location.href='/checkDes'">Rule</button>
            <button onclick="location.href='/checkRecord'">Registration Profile</button>
        </div>
    </div>

    <!-- Rewards Grid -->
    <div class="rewards-grid">
        <div class="reward-card" data-dpr="1">
            <div class="reward-amount">₹50</div>
            <div class="reward-status">Get it now</div>
        </div>
        <div class="reward-card" data-dpr="2">
            <div class="reward-amount">₹100</div>
            <div class="reward-status">Get it now</div>
        </div>
        <div class="reward-card" data-dpr="3">
            <div class="reward-amount">₹150</div>
            <div class="reward-status">Get it now</div>
        </div>
        <div class="reward-card" data-dpr="4">
            <div class="reward-amount">₹200</div>
            <div class="reward-status">Get it now</div>
        </div>
        <div class="reward-card" data-dpr="5">
            <div class="reward-amount">₹250</div>
            <div class="reward-status">Get it now</div>
        </div>
        <div class="reward-card" data-dpr="6">
            <div class="reward-amount">₹300</div>
            <div class="reward-status">Get it now</div>
        </div>
        <div class="reward-card" data-dpr="7">
            <div class="reward-amount">₹400</div>
            <div class="reward-status">Get it now</div>
        </div>
    </div>

    <!-- Support Button -->
    <a href="/keFuMenu" class="support-btn">
        <img src="/images/customer-5ef38c22.png" alt="Support">
    </a>

    <!-- Bottom Navigation -->
    <%- include('../nav') -%>

    <!-- Scripts -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script>
        // Alert message function
        function alertMess(text) {
            $('body').append(`
                <div style="position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); background: rgba(0,0,0,0.8); color: #fff; padding: 16px 24px; border-radius: 8px; z-index: 9999; animation: fadeInOut 2s;">
                    ${text}
                </div>
            `);
            setTimeout(() => {
                $('body > div:last').fadeOut(300, function() { $(this).remove(); });
            }, 1500);
        }

        // Load check-in status
        function loadCheckInStatus() {
            $.ajax({
                type: "POST",
                url: "/api/webapi/checkIn",
                dataType: "json",
                success: function (response) {
                    if (response && response.datas && response.datas[0]) {
                        let data = response.datas[0];
                        
                        // Mark claimed rewards
                        if(data.total1 == 0) markClaimed(0);
                        if(data.total2 == 0) markClaimed(1);
                        if(data.total3 == 0) markClaimed(2);
                        if(data.total4 == 0) markClaimed(3);
                        if(data.total5 == 0) markClaimed(4);
                        if(data.total6 == 0) markClaimed(5);
                        if(data.total7 == 0) markClaimed(6);
                    }
                }
            });
        }

        function markClaimed(index) {
            $('.reward-card').eq(index)
                .addClass('claimed')
                .css('pointer-events', 'none')
                .find('.reward-status')
                .text('Received');
        }

        // Claim reward
        $('.reward-card').click(function (e) {
            e.preventDefault();
            
            if ($(this).hasClass('claimed')) return;
            
            let data = $(this).attr('data-dpr');
            let card = $(this);
            
            $.ajax({
                type: "POST",
                url: "/api/webapi/checkIn",
                data: { data: data },
                dataType: "json",
                success: function (response) {
                    alertMess(response.message);
                    
                    if(response.status === true) {
                        card.addClass('claimed')
                            .css('pointer-events', 'none')
                            .find('.reward-status')
                            .text('Received');
                    }
                }
            });
        });

        // Load on page ready
        $(document).ready(function() {
            loadCheckInStatus();
        });
    </script>
    <style>
        @keyframes fadeInOut {
            0% { opacity: 0; transform: translate(-50%, -40%); }
            20% { opacity: 1; transform: translate(-50%, -50%); }
            80% { opacity: 1; transform: translate(-50%, -50%); }
            100% { opacity: 0; transform: translate(-50%, -60%); }
        }
    </style>
</body>
</html>
