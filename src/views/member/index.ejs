<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <link rel="icon" type="image/x-icon" href="/images/bitbug_favicon.ico">
    <title>Account - DiuWin</title>
    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.css" />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            padding: 0;
            background-color: #e8ecef;
            font-family: 'Outfit', sans-serif;
            color: #0B1833;
        }

        .member-app-wrap {
            max-width: 480px;
            margin: 0 auto;
            min-height: 100vh;
            background: #F5F5F3;
            padding-bottom: 85px;
            box-shadow: 0 0 30px rgba(0, 0, 0, 0.12);
            position: relative;
        }
        
        /* Profile Header - Green Gradient (#20B96B -> #36C66B) matching Reference Screenshot */
        .profile-header {
            background: linear-gradient(135deg, #20B96B 0%, #36C66B 100%);
            padding: 24px 20px 48px 20px;
            color: #ffffff;
            border-radius: 0 0 24px 24px;
            box-shadow: 0 4px 20px rgba(32, 185, 107, 0.3);
            position: relative;
            display: flex;
            align-items: center;
            gap: 14px;
        }
        
        .profile-avatar {
            width: 68px;
            height: 68px;
            border-radius: 50%;
            border: 2px solid rgba(255, 255, 255, 0.85);
            box-shadow: 0 4px 14px rgba(0, 0, 0, 0.15);
            background: #ffffff;
            object-fit: cover;
            flex-shrink: 0;
        }

        .profile-info-col {
            display: flex;
            flex-direction: column;
            gap: 4px;
            flex: 1;
        }
        
        .profile-name-row {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .profile-name {
            font-size: 16px;
            font-weight: 800;
            color: #ffffff;
            letter-spacing: -0.3px;
        }

        .vip-silver-badge {
            background: linear-gradient(135deg, #d1d5db 0%, #9ca3af 100%);
            color: #ffffff;
            font-size: 9.5px;
            font-weight: 800;
            padding: 2px 8px;
            border-radius: 10px;
            border: 1px solid rgba(255,255,255,0.6);
            display: inline-flex;
            align-items: center;
            gap: 3px;
        }

        .uid-badge-pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: rgba(255, 255, 255, 0.25);
            color: #ffffff;
            padding: 3px 10px;
            border-radius: 14px;
            font-size: 11px;
            font-weight: 700;
            width: fit-content;
            cursor: pointer;
        }

        .uid-badge-pill i {
            font-size: 11px;
            opacity: 0.9;
        }
        
        .last-login-time {
            font-size: 10.5px;
            color: rgba(255, 255, 255, 0.9);
            font-weight: 500;
            margin-top: 1px;
        }
        
        /* Total Balance Wallet Card (Overlapping Top Header - Screenshot Match) */
        .balance-card {
            background: #ffffff;
            border: 1px solid #ebeef5;
            margin: -25px 14px 14px 14px;
            padding: 18px;
            border-radius: 18px;
            box-shadow: 0 4px 18px rgba(0, 0, 0, 0.06);
            position: relative;
            z-index: 10;
        }

        .balance-top-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-bottom: 14px;
            border-bottom: 1px solid #f0f2f5;
        }

        .balance-col {
            display: flex;
            flex-direction: column;
            gap: 2px;
        }

        .balance-label {
            font-size: 13px;
            color: #7C8290;
            font-weight: 600;
        }

        .balance-amount-row {
            display: flex;
            align-items: center;
            gap: 8px;
        }
        
        .balance-amount {
            font-size: 24px;
            font-weight: 900;
            color: #0B1833;
            letter-spacing: -0.5px;
        }

        .refresh-btn-icon {
            color: #7C8290;
            font-size: 13px;
            cursor: pointer;
            transition: transform 0.3s ease;
        }

        .refresh-btn-icon:hover {
            transform: rotate(180deg);
            color: #20B96B;
        }

        .enter-wallet-btn {
            background: #20B96B;
            color: #ffffff;
            padding: 7px 16px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: 700;
            text-decoration: none;
            box-shadow: 0 2px 8px rgba(32, 185, 107, 0.3);
            transition: all 0.2s ease;
        }

        .enter-wallet-btn:hover {
            background: #199955;
            transform: translateY(-1px);
        }

        /* 4 Quick Actions Row (ARWallet, Deposit, Withdraw, VIP) */
        .quick-actions-row {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 8px;
            padding-top: 14px;
        }
        
        .action-item-btn {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 6px;
            text-decoration: none;
            color: #0B1833;
            cursor: pointer;
        }
        
        .action-icon-circle {
            width: 44px;
            height: 44px;
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.04);
            transition: transform 0.2s ease;
        }

        .action-item-btn:active .action-icon-circle {
            transform: scale(0.94);
        }

        .bg-pink { background: #FFE5E8; color: #FF4D4F; }
        .bg-orange { background: #FFF0E5; color: #FF9500; }
        .bg-blue { background: #E5F0FF; color: #007AFF; }
        .bg-mint { background: #E6F7F0; color: #20B96B; }
        
        .action-item-btn span {
            font-size: 12px;
            font-weight: 700;
            color: #0B1833;
        }

        /* Safe / Savings Card (Screenshot Match!) */
        .safe-card-wrapper {
            background: #ffffff;
            border-radius: 16px;
            padding: 14px 16px;
            margin: 0 14px 12px 14px;
            border: 1px solid #ebeef5;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
        }

        .safe-card-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 6px;
        }

        .safe-header-left {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .safe-box-icon {
            width: 36px;
            height: 36px;
            border-radius: 10px;
            background: #FFF9E6;
            color: #FFB800;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
        }

        .safe-title {
            font-size: 16px;
            font-weight: 800;
            color: #0B1833;
        }

        .safe-amount-pill {
            background: #FFF2E5;
            color: #FF9500;
            font-size: 12px;
            font-weight: 800;
            padding: 3px 10px;
            border-radius: 12px;
            display: inline-flex;
            align-items: center;
            gap: 4px;
            cursor: pointer;
        }

        .safe-card-subtext {
            font-size: 11px;
            color: #7C8290;
            line-height: 1.35;
            margin: 0;
            font-weight: 500;
        }

        /* 2-Column Grid Account Menu Cards (Screenshot Match!) */
        .account-grid-2col {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 10px;
            margin: 0 14px 12px 14px;
        }

        .menu-card-item {
            background: #ffffff;
            border-radius: 16px;
            padding: 14px;
            border: 1px solid #ebeef5;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
            text-decoration: none;
            color: #0B1833;
            display: flex;
            align-items: flex-start;
            gap: 10px;
            transition: transform 0.2s ease;
        }

        .menu-card-item:active {
            transform: scale(0.98);
        }

        .menu-card-icon-box {
            width: 38px;
            height: 38px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            flex-shrink: 0;
        }

        .menu-card-info {
            display: flex;
            flex-direction: column;
            gap: 2px;
        }

        .menu-card-title {
            font-size: 13.5px;
            font-weight: 800;
            color: #0B1833;
        }

        .menu-card-sub {
            font-size: 11px;
            color: #7C8290;
            font-weight: 500;
        }

        /* Full Width Notification Row Card */
        .notification-card-row {
            background: #ffffff;
            border-radius: 16px;
            padding: 14px 16px;
            margin: 0 14px 12px 14px;
            border: 1px solid #ebeef5;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
            text-decoration: none;
            color: #0B1833;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .notification-left {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .notification-icon-box {
            width: 34px;
            height: 34px;
            border-radius: 10px;
            background: #E6F7F0;
            color: #20B96B;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
        }

        .notification-title {
            font-size: 14px;
            font-weight: 800;
            color: #0B1833;
        }

        .chevron-arrow {
            color: #7C8290;
            font-size: 16px;
        }

        /* Customer Service & Logout Buttons */
        .extra-action-section {
            padding: 0 14px 20px 14px;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .logout-btn {
            background: #ffffff;
            color: #ff4d4f;
            border: 1.5px solid #ff4d4f;
            padding: 13px;
            border-radius: 25px;
            text-align: center;
            font-weight: 800;
            cursor: pointer;
            font-size: 14.5px;
            width: 100%;
            transition: all 0.25s ease;
            box-shadow: 0 2px 8px rgba(255, 77, 79, 0.1);
        }
        
        .logout-btn:hover {
            background: #fff2f0;
        }

        /* Toast Alert */
        .alert-toast {
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            z-index: 10000;
            width: 80%;
            max-width: 320px;
        }
        .msg-content {
            background: linear-gradient(135deg, #20B96B 0%, #36C66B 100%);
            border-radius: 12px;
            color: #ffffff;
            padding: 12px 20px;
            text-align: center;
            font-size: 13.5px;
            font-weight: 700;
            box-shadow: 0 8px 25px rgba(32, 185, 107, 0.4);
        }
    </style>
</head>
<body>
    <div class="member-app-wrap">
        <!-- Top Green Profile Header (Screenshot Match!) -->
        <div class="profile-header">
            <img src="/images/avatar.svg" alt="Avatar" class="profile-avatar" id="userAvatarImg">
            <div class="profile-info-col">
                <div class="profile-name-row">
                    <span class="profile-name" id="userName">User</span>
                    <span class="vip-silver-badge" id="userVipBadge"><i class="fa fa-star"></i> VIP0</span>
                </div>
                <div class="uid-badge-pill" onclick="copyUID()">
                    <span>UID &nbsp;|&nbsp; <span id="userId">---</span></span>
                    <i class="fa fa-clone"></i>
                </div>
                <div class="last-login-time" id="lastLoginTime">Last login: 2026-08-24 15:30:00</div>
            </div>
        </div>

        <!-- Total Balance Wallet Card (Overlapping Header - Screenshot Match!) -->
        <div class="balance-card">
            <div class="balance-top-row">
                <div class="balance-col">
                    <span class="balance-label">Total balance</span>
                    <div class="balance-amount-row">
                        <span class="balance-amount" id="userBalance">₹0.00</span>
                        <i class="fa fa-refresh refresh-btn-icon" onclick="loadUserData()" title="Refresh balance"></i>
                    </div>
                </div>
                <a href="/wallet" class="enter-wallet-btn">Enter wallet</a>
            </div>

            <!-- Quick Actions Grid (ARWallet, Deposit, Withdraw, VIP) -->
            <div class="quick-actions-row">
                <a href="/wallet" class="action-item-btn">
                    <div class="action-icon-circle bg-pink">
                        <i class="fa fa-credit-card"></i>
                    </div>
                    <span>ARWallet</span>
                </a>
                <a href="/wallet/recharge" class="action-item-btn">
                    <div class="action-icon-circle bg-orange">
                        <i class="fa fa-[#FF9500] fa-database"></i>
                    </div>
                    <span>Deposit</span>
                </a>
                <a href="/wallet/withdrawal" class="action-item-btn">
                    <div class="action-icon-circle bg-blue">
                        <i class="fa fa-bank"></i>
                    </div>
                    <span>Withdraw</span>
                </a>
                <a href="/checkIn" class="action-item-btn">
                    <div class="action-icon-circle bg-mint">
                        <i class="fa fa-diamond"></i>
                    </div>
                    <span>VIP</span>
                </a>
            </div>
        </div>

        <!-- Safe / Savings Card (Screenshot Match!) -->
        <div class="safe-card-wrapper">
            <div class="safe-card-header">
                <div class="safe-header-left">
                    <div class="safe-box-icon">
                        <i class="fa fa-archive"></i>
                    </div>
                    <span class="safe-title">Safe</span>
                </div>
                <div class="safe-amount-pill" onclick="location.href='/wallet'">
                    <span>₹0.00</span>
                    <i class="fa fa-angle-right"></i>
                </div>
            </div>
            <p class="safe-card-subtext">The daily interest rate is 0.1%, and the income is calculated once every 1 minutes.</p>
        </div>

        <!-- 2-Column Grid Account Menu Cards (Screenshot Match!) -->
        <div class="account-grid-2col">
            <!-- Game History -->
            <a href="/wallet/rechargerecord" class="menu-card-item">
                <div class="menu-card-icon-box bg-blue">
                    <i class="fa fa-file-text-o"></i>
                </div>
                <div class="menu-card-info">
                    <span class="menu-card-title">Game History</span>
                    <span class="menu-card-sub">My game history</span>
                </div>
            </a>

            <!-- Transaction -->
            <a href="/wallet/withdrawalrecord" class="menu-card-item">
                <div class="menu-card-icon-box bg-mint">
                    <i class="fa fa-exchange"></i>
                </div>
                <div class="menu-card-info">
                    <span class="menu-card-title">Transaction</span>
                    <span class="menu-card-sub">My transaction history</span>
                </div>
            </a>

            <!-- Deposit -->
            <a href="/wallet/rechargerecord" class="menu-card-item">
                <div class="menu-card-icon-box bg-pink">
                    <i class="fa fa-[#FF4D4F] fa-arrow-circle-down"></i>
                </div>
                <div class="menu-card-info">
                    <span class="menu-card-title">Deposit</span>
                    <span class="menu-card-sub">My deposit history</span>
                </div>
            </a>

            <!-- Withdraw -->
            <a href="/wallet/withdrawalrecord" class="menu-card-item">
                <div class="menu-card-icon-box bg-orange">
                    <div class="action-icon">💼</div>
                </div>
                <div class="menu-card-info">
                    <span class="menu-card-title">Withdraw</span>
                    <span class="menu-card-sub">My withdraw history</span>
                </div>
            </a>
        </div>

        <!-- Full Width Notification Row Card -->
        <a href="/notification" class="notification-card-row">
            <div class="notification-left">
                <div class="notification-icon-box">
                    <i class="fa fa-bell-o"></i>
                </div>
                <span class="notification-title">Notification</span>
            </div>
            <i class="fa fa-angle-right chevron-arrow"></i>
        </a>

        <!-- Extra Action Section -->
        <div class="extra-action-section">
            <a href="/keFuMenu" class="notification-card-row" style="margin: 0;">
                <div class="notification-left">
                    <div class="notification-icon-box" style="background: #E5F0FF; color: #007AFF;">
                        <i class="fa fa-headphones"></i>
                    </div>
                    <span class="notification-title">24/7 Customer service</span>
                </div>
                <i class="fa fa-angle-right chevron-arrow"></i>
            </a>

            <button class="logout-btn" onclick="logout()">Log out</button>
        </div>

        <div class="alert-toast"></div>

        <!-- Bottom Navigation -->
        <%- include('../nav') -%>
    </div>

    <!-- Scripts -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script>
        function setCookie(cname, cvalue, exdays) {
            const d = new Date();
            d.setTime(d.getTime() + (exdays * 24 * 60 * 60 * 1000));
            let expires = "expires=" + d.toUTCString();
            document.cookie = cname + "=" + cvalue + ";" + expires + ";path=/";
        }

        function unsetCookie() {
            setCookie('token', '', 0);
            setCookie('auth', '', 0);
        }

        function alertMess(text) {
            let length = $('.alert-toast .msg').length;
            if (length == 0) {
                $('.alert-toast').append(
                    `
                    <div class="msg" style="animation: zoom-in 0.3s ease;">
                        <div class="msg-content"> ${text} </div>
                    </div>
                    `
                );
                setTimeout(() => {
                    $('.msg').fadeOut(200, function() {
                        $('.alert-toast .msg').remove();
                    });
                }, 1800);
            }
        }

        function copyUID() {
            const uidText = $('#userId').text();
            if (uidText && uidText !== '---') {
                navigator.clipboard.writeText(uidText).then(() => {
                    alertMess('UID copied to clipboard!');
                }).catch(() => {
                    alertMess('UID: ' + uidText);
                });
            }
        }

        // Load user data dynamically from API
        function loadUserData() {
            $.ajax({
                type: "GET",
                url: "/api/webapi/GetUserInfo",
                dataType: "json",
                success: function (response) {
                    if (response && response.data) {
                        let user = response.data;
                        $('#userName').text(user.name_user || 'MEMBER' + (user.id_user || '10959639'));
                        $('#userId').text(user.id_user || '10959639');
                        $('#userBalance').text("₹" + parseFloat(user.money_user || 0).toFixed(2));
                        if (user.user_level !== undefined) {
                            $('#userVipBadge').html('<i class="fa fa-star"></i> VIP' + user.user_level);
                        }
                    }
                },
                error: function() {
                    console.error("Failed to load user data");
                }
            });
        }

        // Logout function
        function logout() {
            if (confirm("Do you want to log out?")) {
                unsetCookie();
                window.location.href = '/login';
            }
        }

        $(document).ready(function() {
            loadUserData();
        });
    </script>
</body>
</html>
