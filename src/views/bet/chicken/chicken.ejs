    <script>
      // Automatically sync DIU-win auth cookie into localStorage for Chicken Road React App
      (function() {
        function getCookie(name) {
          const match = document.cookie.match(new RegExp('(^| )' + name + '=([^;]+)'));
          return match ? match[2] : null;
        }
        const authCookie = getCookie('auth');
        if (authCookie) {
          localStorage.setItem('chicken_road_token', authCookie);
        } else if (!localStorage.getItem('chicken_road_token')) {
          localStorage.setItem('chicken_road_token', 'demo_token_' + Date.now());
        }
      })();
    </script>
