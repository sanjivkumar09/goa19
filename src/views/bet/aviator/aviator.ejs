<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Aviator - Real-time Crash Game</title>
  <script src="/socket.io/socket.io.js"></script>
  <script>if (typeof io === 'undefined') { document.write('<script src="https://cdn.socket.io/4.4.1/socket.io.min.js"><\/script>'); }</script>
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;800;900&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Montserrat', -apple-system, BlinkMacSystemFont, sans-serif;
      user-select: none;
      -webkit-tap-highlight-color: transparent;
    }

    html, body {
      height: 100%;
      max-height: 100vh;
      overflow: hidden;
      background-color: #07090e;
      color: #ffffff;
      display: flex;
      flex-direction: column;
    }

    /* Top Navbar */
    .navbar {
      background: #0d0e12;
      border-bottom: 1px solid rgba(51, 65, 85, 0.8);
      padding: 4px 10px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 44px;
      flex-shrink: 0;
    }

    .brand-logo-img {
      height: 36px;
      max-width: 200px;
      object-fit: contain;
      filter: drop-shadow(0 0 12px rgba(229, 9, 56, 0.7));
    }

    .user-info {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .wallet-box {
      background: #18191c;
      border: 1px solid rgba(51, 65, 85, 0.8);
      padding: 4px 10px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      gap: 6px;
      font-weight: 900;
      color: #10b981;
      font-size: 0.85rem;
      box-shadow: inset 0 2px 4px rgba(0,0,0,0.4);
    }

    .btn-back {
      background: #18191c;
      color: #94a3b8;
      border: 1px solid rgba(51, 65, 85, 0.5);
      padding: 4px 10px;
      border-radius: 8px;
      text-decoration: none;
      font-weight: 800;
      font-size: 0.75rem;
      transition: all 0.2s;
    }
    .btn-back:hover {
      background: #334155;
      color: #fff;
    }

    /* History Bar */
    .history-bar {
      background: #0d0e12;
      border-bottom: 1px solid rgba(51, 65, 85, 0.5);
      padding: 3px 8px;
      display: flex;
      align-items: center;
      gap: 5px;
      overflow-x: auto;
      scrollbar-width: none;
      white-space: nowrap;
      height: 30px;
      flex-shrink: 0;
    }
    .history-bar::-webkit-scrollbar { display: none; }

    .history-pill {
      padding: 2px 8px;
      border-radius: 10px;
      font-size: 0.7rem;
      font-weight: 900;
      flex-shrink: 0;
    }
    .pill-blue { background: rgba(59, 130, 246, 0.2); color: #60a5fa; border: 1px solid rgba(59, 130, 246, 0.4); }
    .pill-purple { background: rgba(168, 85, 247, 0.2); color: #c084fc; border: 1px solid rgba(168, 85, 247, 0.4); }
    .pill-gold { background: rgba(234, 179, 8, 0.2); color: #facc15; border: 1px solid rgba(234, 179, 8, 0.4); }

    /* Main Flex Layout */
    .game-layout {
      flex: 1;
      display: flex;
      flex-direction: column;
      height: calc(100vh - 74px);
      overflow: hidden;
      padding: 4px;
      gap: 4px;
    }

    @media (min-width: 1024px) {
      html, body { max-height: none; overflow: auto; }
      .game-layout {
        display: grid;
        grid-template-columns: 3.2fr 1fr;
        height: auto;
        padding: 10px;
        gap: 10px;
      }
    }

    .game-main {
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 4px;
      min-height: 0;
    }

    /* Viewport Area (Canvas Expands Dynamically) */
    .viewport {
      flex: 1;
      position: relative;
      width: 100%;
      min-height: 160px;
      max-height: 48vh;
      background: #000000;
      border: 1px solid rgba(30, 41, 59, 0.8);
      border-radius: 14px;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 15px 20px -5px rgba(0, 0, 0, 0.5);
    }

    canvas {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      display: block;
    }

    .multiplier-overlay {
      position: absolute;
      z-index: 10;
      text-align: center;
      pointer-events: none;
    }

    .multiplier-value {
      font-size: 3.2rem;
      font-weight: 900;
      color: #ffffff;
      text-shadow: 0 0 35px rgba(255, 255, 255, 0.8);
      line-height: 1;
      letter-spacing: -1px;
    }
    @media (min-width: 640px) {
      .multiplier-value { font-size: 4.8rem; }
    }

    .multiplier-label {
      font-size: 0.82rem;
      font-weight: 800;
      letter-spacing: 2px;
      color: #94a3b8;
      margin-top: 3px;
      text-transform: uppercase;
    }

    .crashed-text {
      color: #ff2a54 !important;
      text-shadow: 0 0 40px rgba(255, 42, 84, 0.9) !important;
    }

    /* Countdown Bar */
    .countdown-bar-wrapper {
      width: 180px;
      height: 6px;
      background: rgba(255, 255, 255, 0.15);
      border-radius: 4px;
      margin: 8px auto 0 auto;
      overflow: hidden;
    }

    .countdown-bar-fill {
      height: 100%;
      width: 100%;
      background: linear-gradient(90deg, #e50938, #ffb800);
      border-radius: 4px;
      transition: width 0.05s linear;
    }

    /* Mobile Bet Panel Tabs & Cards */
    .mobile-panel-tabs {
      display: flex;
      background: #141518;
      padding: 2px;
      border-radius: 8px;
      gap: 2px;
      border: 1px solid rgba(51, 65, 85, 0.6);
    }
    @media (min-width: 640px) {
      .mobile-panel-tabs { display: none; }
    }

    .panel-tab-btn {
      flex: 1;
      padding: 4px;
      border: none;
      background: transparent;
      color: #64748b;
      font-weight: 800;
      font-size: 0.7rem;
      border-radius: 6px;
      cursor: pointer;
    }
    .panel-tab-btn.active {
      background: #1f2024;
      color: #ff2a54;
    }

    .bet-panels-grid {
      display: flex;
      flex-direction: column;
      gap: 4px;
      flex-shrink: 0;
    }

    @media (min-width: 640px) {
      .bet-panels-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px;
      }
    }

    .bet-card {
      background: #141518;
      border: 1px solid rgba(51, 65, 85, 0.8);
      border-radius: 14px;
      padding: 8px 10px;
      display: flex;
      flex-direction: column;
      gap: 5px;
      box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.3);
    }

    .bet-card-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid rgba(51, 65, 85, 0.4);
      padding-bottom: 3px;
    }

    .bet-card-title {
      font-size: 0.7rem;
      font-weight: 800;
      color: #94a3b8;
      letter-spacing: 1px;
      text-transform: uppercase;
    }

    .auto-cashout-toggle {
      display: flex;
      align-items: center;
      gap: 5px;
      font-size: 0.68rem;
      font-weight: 700;
      color: #94a3b8;
      cursor: pointer;
    }

    .toggle-switch {
      width: 30px;
      height: 16px;
      background: #334155;
      border-radius: 10px;
      position: relative;
      transition: background 0.2s;
    }
    .toggle-switch.active { background: #e50938; }
    .toggle-knob {
      width: 12px;
      height: 12px;
      background: #fff;
      border-radius: 50%;
      position: absolute;
      top: 2px;
      left: 2px;
      transition: transform 0.2s;
    }
    .toggle-switch.active .toggle-knob { transform: translateX(14px); }

    .bet-input-row {
      display: flex;
      gap: 6px;
      align-items: stretch;
    }

    .amount-controls {
      flex: 1;
      min-width: 0;
      display: flex;
      flex-direction: column;
      gap: 3px;
    }

    .input-box-wrapper {
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: #1f2024;
      border: 1px solid rgba(51, 65, 85, 0.8);
      border-radius: 10px;
      padding: 2px 4px;
    }

    .btn-step {
      background: #27282d;
      border: none;
      color: #e2e8f0;
      width: 26px;
      height: 26px;
      border-radius: 50%;
      font-weight: 900;
      font-size: 0.9rem;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .btn-step:hover { background: #334155; }

    .input-box-wrapper input {
      flex: 1;
      background: transparent;
      border: none;
      outline: none;
      color: #fff;
      font-size: 0.95rem;
      font-weight: 900;
      text-align: center;
      width: 100%;
      min-width: 0;
    }

    .quick-btns {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 3px;
    }

    .btn-quick {
      background: #1f2024;
      border: 1px solid rgba(51, 65, 85, 0.4);
      color: #94a3b8;
      padding: 2px 0;
      border-radius: 6px;
      font-size: 0.68rem;
      font-weight: 800;
      cursor: pointer;
      transition: all 0.15s;
    }
    .btn-quick:hover {
      background: #334155;
      color: #fff;
    }

    .auto-val-box {
      display: flex;
      align-items: center;
      background: #1f2024;
      border: 1px solid rgba(51, 65, 85, 0.6);
      border-radius: 6px;
      padding: 2px 5px;
    }
    .auto-val-box span { font-size: 0.62rem; color: #64748b; font-weight: 800; }
    .auto-val-box input {
      background: transparent;
      border: none;
      outline: none;
      color: #fff;
      font-size: 0.78rem;
      font-weight: 800;
      text-align: right;
      width: 100%;
    }

    /* Fixed Action Button on Right Side */
    .btn-action {
      width: 120px;
      flex-shrink: 0;
      border: none;
      border-radius: 12px;
      font-size: 1.1rem;
      font-weight: 900;
      color: #fff;
      cursor: pointer;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      box-shadow: 0 4px 18px rgba(39, 184, 70, 0.4);
      transition: transform 0.1s, filter 0.2s;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 2px;
    }
    @media (min-width: 640px) {
      .btn-action { width: 135px; }
    }

    .btn-action:active { transform: scale(0.98); }

    .btn-bet { background: #27b846; }
    .btn-bet:hover { background: #2ed251; }

    .btn-cashout {
      background: linear-gradient(135deg, #f59e0b, #eab308);
      color: #000;
      box-shadow: 0 0 25px rgba(245, 158, 11, 0.7);
      animation: pulse 1s infinite alternate;
    }

    .btn-cancel { background: linear-gradient(135deg, #e50914, #dc2626); }

    @keyframes pulse {
      0% { box-shadow: 0 0 8px rgba(245, 158, 11, 0.4); }
      100% { box-shadow: 0 0 24px rgba(245, 158, 11, 0.9); }
    }

    .btn-subtext {
      font-size: 0.7rem;
      font-weight: 900;
      opacity: 0.95;
    }

    /* Bottom Collapsible Bets List */
    .bottom-drawer {
      background: #141518;
      border: 1px solid rgba(51, 65, 85, 0.8);
      border-radius: 12px;
      padding: 5px;
      display: flex;
      flex-direction: column;
      height: 110px;
      flex-shrink: 0;
    }

    @media (min-width: 1024px) {
      .bottom-drawer { height: 100%; max-height: none; }
    }

    .tab-header {
      display: flex;
      background: #0f1015;
      padding: 2px;
      border-radius: 6px;
      gap: 3px;
      margin-bottom: 4px;
    }

    .tab-btn {
      flex: 1;
      padding: 4px;
      border: none;
      background: transparent;
      color: #64748b;
      font-weight: 800;
      font-size: 0.7rem;
      border-radius: 5px;
      cursor: pointer;
    }
    .tab-btn.active {
      background: #18191c;
      color: #fff;
    }

    .bets-list {
      flex: 1;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      gap: 3px;
    }

    .bet-item {
      background: #18191c;
      border: 1px solid rgba(51, 65, 85, 0.4);
      border-radius: 6px;
      padding: 4px 6px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 0.68rem;
    }

    .bet-item-user { font-weight: 700; color: #cbd5e1; }
    .bet-item-mult { font-weight: 900; color: #10b981; }
    .bet-item-mult.lost { color: #ff2a54; }

    /* Toast Notification */
    .toast-popup {
      position: fixed;
      top: 50px;
      right: 12px;
      z-index: 100;
      background: #18191c;
      border: 1px solid #e50914;
      padding: 6px 12px;
      border-radius: 8px;
      color: #fff;
      font-weight: 800;
      font-size: 0.78rem;
      box-shadow: 0 4px 20px rgba(0,0,0,0.7);
      display: none;
    }
  </style>
</head>
<body>

  <!-- Top Navbar -->
  <header class="navbar">
    <a href="/home" class="brand">
      <img src="/assets/logo.png" alt="Aviator Logo" class="brand-logo-img">
    </a>

    <div class="user-info">
      <div class="wallet-box">
        <i class="fas fa-wallet"></i>
        <span>₹<span id="user-balance">0.00</span></span>
      </div>
      <a href="/home" class="btn-back"><i class="fas fa-arrow-left mr-1"></i> Exit</a>
    </div>
  </header>

  <!-- History Bar -->
  <div class="history-bar" id="history-strip">
    <!-- Multiplier Pills -->
  </div>

  <!-- Toast Notification Popup -->
  <div id="toast" class="toast-popup"></div>

  <!-- Main Game Layout (Locked to 100vh) -->
  <div class="game-layout">
    <div class="game-main">
      <!-- HTML5 Canvas Viewport -->
      <div class="viewport">
        <canvas id="flight-canvas"></canvas>
        <div class="multiplier-overlay">
          <div id="mult-val" class="multiplier-value">1.00x</div>
          <div id="mult-label" class="multiplier-label">WAITING FOR NEXT ROUND</div>
          <div id="countdown-wrapper" class="countdown-bar-wrapper" style="display:none;">
            <div id="countdown-progress" class="countdown-bar-fill"></div>
          </div>
        </div>
      </div>

      <!-- Mobile Panel Switcher Tabs -->
      <div class="mobile-panel-tabs">
        <button class="panel-tab-btn active" id="mtab-1" onclick="switchMobilePanel(1)">BET 1</button>
        <button class="panel-tab-btn" id="mtab-2" onclick="switchMobilePanel(2)">BET 2</button>
      </div>

      <!-- Dual Betting Panels -->
      <div class="bet-panels-grid">
        <!-- Panel 1 -->
        <div class="bet-card" id="panel-card-1">
          <div class="bet-card-header">
            <span class="bet-card-title">Bet Station #1</span>
            <div class="auto-cashout-toggle" onclick="toggleAutoCashout(1)">
              <span>Auto Cash Out</span>
              <div class="toggle-switch" id="p1-toggle-switch">
                <div class="toggle-knob"></div>
              </div>
            </div>
          </div>

          <div class="bet-input-row">
            <div class="amount-controls">
              <div class="input-box-wrapper">
                <button class="btn-step" onclick="stepAmount('p1-amount', -10)">-</button>
                <input type="number" id="p1-amount" value="10.00" min="1" step="1">
                <button class="btn-step" onclick="stepAmount('p1-amount', 10)">+</button>
              </div>
              <div class="quick-btns">
                <button class="btn-quick" onclick="setQuickAmount('p1-amount', 10)">10</button>
                <button class="btn-quick" onclick="setQuickAmount('p1-amount', 50)">50</button>
                <button class="btn-quick" onclick="setQuickAmount('p1-amount', 100)">100</button>
                <button class="btn-quick" onclick="setQuickAmount('p1-amount', 500)">500</button>
              </div>
              <div class="auto-val-box" id="p1-auto-box" style="display:none;">
                <span>AUTO MULT</span>
                <input type="number" id="p1-auto-val" value="2.00" min="1.05" step="0.1">
              </div>
            </div>

            <button id="p1-btn" class="btn-action btn-bet" onclick="handlePanelAction(1)">
              <span>BET</span>
              <span id="p1-sub" class="btn-subtext">₹10.00</span>
            </button>
          </div>
        </div>

        <!-- Panel 2 -->
        <div class="bet-card" id="panel-card-2">
          <div class="bet-card-header">
            <span class="bet-card-title">Bet Station #2</span>
            <div class="auto-cashout-toggle" onclick="toggleAutoCashout(2)">
              <span>Auto Cash Out</span>
              <div class="toggle-switch" id="p2-toggle-switch">
                <div class="toggle-knob"></div>
              </div>
            </div>
          </div>

          <div class="bet-input-row">
            <div class="amount-controls">
              <div class="input-box-wrapper">
                <button class="btn-step" onclick="stepAmount('p2-amount', -10)">-</button>
                <input type="number" id="p2-amount" value="50.00" min="1" step="1">
                <button class="btn-step" onclick="stepAmount('p2-amount', 10)">+</button>
              </div>
              <div class="quick-btns">
                <button class="btn-quick" onclick="setQuickAmount('p2-amount', 10)">10</button>
                <button class="btn-quick" onclick="setQuickAmount('p2-amount', 50)">50</button>
                <button class="btn-quick" onclick="setQuickAmount('p2-amount', 100)">100</button>
                <button class="btn-quick" onclick="setQuickAmount('p2-amount', 500)">500</button>
              </div>
              <div class="auto-val-box" id="p2-auto-box" style="display:none;">
                <span>AUTO MULT</span>
                <input type="number" id="p2-auto-val" value="2.00" min="1.05" step="0.1">
              </div>
            </div>

            <button id="p2-btn" class="btn-action btn-bet" onclick="handlePanelAction(2)">
              <span>BET</span>
              <span id="p2-sub" class="btn-subtext">₹50.00</span>
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom Drawer (Bets List) -->
    <div class="bottom-drawer">
      <div class="tab-header">
        <button class="tab-btn active" id="tab-all-btn" onclick="switchTab('all')">All Bets</button>
        <button class="tab-btn" id="tab-my-btn" onclick="switchTab('my')">My Bets</button>
      </div>

      <div class="bets-list" id="bets-list-container">
        <!-- Live Player Bets -->
      </div>
    </div>
  </div>

  <script>
    // --- STATE MANAGEMENT ---
    let socket = null;
    let currentUserPhone = '';
    let currentGameState = null;
    let panelState = {
      1: { betId: null, status: 'NONE', amount: 10, auto: false },
      2: { betId: null, status: 'NONE', amount: 50, auto: false }
    };

    // Preload Image Assets
    const bgImg = new Image();
    bgImg.src = '/assets/game-bg.png';

    const planeImg = new Image();
    planeImg.src = '/assets/plane.png';

    // --- PLANE & PARTICLE RENDER ENGINE ---
    class PlaneRenderer {
      constructor() {
        this.particles = [];
      }

      emitEngineTrail(x, y, angle, intensity = 1) {
        const count = Math.floor(2 * intensity);
        for (let i = 0; i < count; i++) {
          const spread = (Math.random() - 0.5) * 0.5;
          const speed = (2 + Math.random() * 3) * intensity;
          const vx = -Math.cos(angle + spread) * speed;
          const vy = -Math.sin(angle + spread) * speed;

          const colors = ['#00F2FE', '#4FACFE', '#00E676', '#FFFFFF', '#e50938'];
          const color = colors[Math.floor(Math.random() * colors.length)];

          this.particles.push({
            x, y, vx, vy,
            size: (2 + Math.random() * 3) * intensity,
            color,
            alpha: 1,
            maxLife: 20 + Math.random() * 15,
            life: 0
          });
        }
      }

      emitExplosion(x, y) {
        for (let i = 0; i < 40; i++) {
          const angle = Math.random() * Math.PI * 2;
          const speed = 2 + Math.random() * 8;
          const vx = Math.cos(angle) * speed;
          const vy = Math.sin(angle) * speed;

          const colors = ['#FF2A54', '#FFB800', '#FF5252', '#FFA000'];
          const color = colors[Math.floor(Math.random() * colors.length)];

          this.particles.push({
            x, y, vx, vy,
            size: 3 + Math.random() * 5,
            color,
            alpha: 1,
            maxLife: 30 + Math.random() * 25,
            life: 0
          });
        }
      }

      updateParticles() {
        for (let i = this.particles.length - 1; i >= 0; i--) {
          const p = this.particles[i];
          p.x += p.vx;
          p.y += p.vy;
          p.life++;
          p.alpha = 1 - p.life / p.maxLife;

          if (p.life >= p.maxLife) {
            this.particles.splice(i, 1);
          }
        }
      }

      drawParticles(ctx) {
        ctx.save();
        for (const p of this.particles) {
          ctx.globalAlpha = Math.max(p.alpha, 0);
          ctx.fillStyle = p.color;
          ctx.shadowColor = p.color;
          ctx.shadowBlur = 8;
          ctx.beginPath();
          ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
          ctx.fill();
        }
        ctx.restore();
      }

      drawPlaneSprite(ctx, img, x, y, angle, isCrashed = false) {
        ctx.save();
        ctx.translate(x, y);
        ctx.rotate(angle);

        if (img && img.complete && img.naturalWidth > 0) {
          const planeWidth = 72;
          const planeHeight = (img.naturalHeight / img.naturalWidth) * planeWidth;

          if (isCrashed) {
            ctx.globalAlpha = 0.8;
            ctx.shadowColor = '#e50938';
            ctx.shadowBlur = 20;
          } else {
            ctx.shadowColor = 'rgba(229, 9, 56, 0.6)';
            ctx.shadowBlur = 10;
          }

          ctx.drawImage(img, -planeWidth * 0.4, -planeHeight * 0.5, planeWidth, planeHeight);
        } else {
          ctx.fillStyle = isCrashed ? '#FF2A54' : '#e50938';
          ctx.beginPath();
          ctx.arc(0, 0, 10, 0, Math.PI * 2);
          ctx.fill();
        }

        ctx.restore();
      }
    }

    // --- FLIGHT PATH BEZIER MATH ---
    class FlightPath {
      static getPosition(progress, width, height) {
        const p = Math.min(Math.max(progress, 0), 1);

        const startX = width * 0.08;
        const startY = height * 0.85;
        const targetX = width * 0.85;
        const targetY = height * 0.20;

        const cp1x = startX + (targetX - startX) * 0.4;
        const cp1y = startY;
        const cp2x = startX + (targetX - startX) * 0.8;
        const cp2y = startY - (startY - targetY) * 0.7;

        const t = p;
        const u = 1 - t;
        const tt = t * t;
        const uu = u * u;
        const uuu = uu * u;
        const ttt = tt * t;

        const x = uuu * startX + 3 * uu * t * cp1x + 3 * u * tt * cp2x + ttt * targetX;
        const y = uuu * startY + 3 * uu * t * cp1y + 3 * u * tt * cp2y + ttt * targetY;

        return { x, y };
      }

      static getRotationAngle(progress, width, height) {
        const p = Math.min(Math.max(progress, 0), 1);
        const delta = 0.01;
        const p1 = this.getPosition(p, width, height);
        const p2 = this.getPosition(Math.min(p + delta, 1), width, height);

        const dx = p2.x - p1.x;
        const dy = p2.y - p1.y;

        return Math.atan2(dy, dx);
      }
    }

    // --- CONTINUOUS 60FPS RENDER LOOP ---
    const canvas = document.getElementById('flight-canvas');
    const ctx = canvas.getContext('2d');
    const planeRenderer = new PlaneRenderer();

    let targetMultiplier = 1.00;
    let animatedMultiplier = 1.00;
    let gameStatus = 'WAITING';
    let crashAnimation = { active: false, x: 0, y: 0, vx: 0, vy: 0 };

    function renderLoop() {
      // 1. Smooth lerp multiplier during flight for 60FPS fluid text & curve
      if (gameStatus === 'FLYING') {
        animatedMultiplier += (targetMultiplier - animatedMultiplier) * 0.15;
        
        // Update live cashout button payout in real-time on every frame
        [1, 2].forEach(pNum => {
          if (panelState[pNum].status === 'BET_PLACED') {
            const winVal = (panelState[pNum].amount * animatedMultiplier).toFixed(2);
            $(`#p${pNum}-sub`).text('₹' + winVal);
          }
        });
      } else if (gameStatus === 'WAITING' || gameStatus === 'BETTING_OPEN') {
        animatedMultiplier = 1.00;
      }

      // 2. High-DPI Canvas Resizing
      const dpr = window.devicePixelRatio || 1;
      const width = canvas.clientWidth;
      const height = canvas.clientHeight;

      if (canvas.width !== width * dpr || canvas.height !== height * dpr) {
        canvas.width = width * dpr;
        canvas.height = height * dpr;
      }

      ctx.save();
      ctx.scale(dpr, dpr);

      // 3. Draw Background (game-bg.png)
      if (bgImg.complete && bgImg.naturalWidth > 0) {
        ctx.drawImage(bgImg, 0, 0, width, height);
      } else {
        const bgGrad = ctx.createLinearGradient(0, 0, 0, height);
        bgGrad.addColorStop(0, '#07090e');
        bgGrad.addColorStop(1, '#000000');
        ctx.fillStyle = bgGrad;
        ctx.fillRect(0, 0, width, height);
      }

      // 4. Render Flight Trajectory Graph & Jet Plane
      if (gameStatus === 'FLYING' || gameStatus === 'CRASHED' || gameStatus === 'RESULT') {
        const maxLog = Math.log(100);
        const displayMult = (gameStatus === 'FLYING') ? animatedMultiplier : targetMultiplier;
        const progress = Math.min(Math.log(Math.max(displayMult, 1)) / maxLog, 0.95);

        const currentPos = FlightPath.getPosition(progress, width, height);
        const rotationAngle = FlightPath.getRotationAngle(progress, width, height);
        const startPos = FlightPath.getPosition(0, width, height);

        // Filled Area under Curve (Solid Crimson Red Graph)
        ctx.save();
        ctx.beginPath();
        ctx.moveTo(startPos.x, startPos.y);

        const steps = 50;
        for (let i = 1; i <= steps; i++) {
          const pStep = (progress * i) / steps;
          const posStep = FlightPath.getPosition(pStep, width, height);
          ctx.lineTo(posStep.x, posStep.y);
        }

        ctx.lineTo(currentPos.x, height);
        ctx.lineTo(startPos.x, height);
        ctx.closePath();

        const fillGrad = ctx.createLinearGradient(0, height * 0.3, 0, height);
        fillGrad.addColorStop(0, 'rgba(229, 9, 56, 0.7)');
        fillGrad.addColorStop(0.7, 'rgba(180, 0, 40, 0.4)');
        fillGrad.addColorStop(1, 'rgba(100, 0, 20, 0.2)');
        ctx.fillStyle = fillGrad;
        ctx.fill();

        // Top Crimson Red Trajectory Line
        ctx.beginPath();
        ctx.moveTo(startPos.x, startPos.y);
        for (let i = 1; i <= steps; i++) {
          const pStep = (progress * i) / steps;
          const posStep = FlightPath.getPosition(pStep, width, height);
          ctx.lineTo(posStep.x, posStep.y);
        }
        ctx.lineWidth = 4;
        ctx.strokeStyle = '#e50938';
        ctx.shadowColor = '#e50938';
        ctx.shadowBlur = 12;
        ctx.stroke();
        ctx.restore();

        // Emit Engine Smoke Trail
        if (gameStatus === 'FLYING') {
          const intensity = Math.min(1 + displayMult * 0.05, 3);
          planeRenderer.emitEngineTrail(currentPos.x, currentPos.y, rotationAngle, intensity);
        }

        // Draw Jet Sprite
        if (gameStatus === 'CRASHED' && crashAnimation.active) {
          crashAnimation.x += crashAnimation.vx;
          crashAnimation.y += crashAnimation.vy;
          crashAnimation.vy += 0.4;

          const crashAngle = Math.atan2(crashAnimation.vy, crashAnimation.vx);
          planeRenderer.drawPlaneSprite(ctx, planeImg, crashAnimation.x, crashAnimation.y, crashAngle, true);
        } else if (gameStatus === 'FLYING') {
          planeRenderer.drawPlaneSprite(ctx, planeImg, currentPos.x, currentPos.y, rotationAngle, false);
        }
      }

      // 5. Update & Draw Particles
      planeRenderer.updateParticles();
      planeRenderer.drawParticles(ctx);

      ctx.restore();

      requestAnimationFrame(renderLoop);
    }

    // Start 60FPS loop
    requestAnimationFrame(renderLoop);

    // --- SOUND EFFECTS ---
    const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    function playChime(freq = 800, type = 'sine') {
      try {
        let osc = audioCtx.createOscillator();
        let gain = audioCtx.createGain();
        osc.type = type;
        osc.frequency.setValueAtTime(freq, audioCtx.currentTime);
        gain.gain.setValueAtTime(0.08, audioCtx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.3);
        osc.connect(gain);
        gain.connect(audioCtx.destination);
        osc.start();
        osc.stop(audioCtx.currentTime + 0.3);
      } catch(e){}
    }

    // --- UI HELPERS & TIMER ---
    let countdownInterval = null;
    function startCountdownTimer(seconds = 5) {
      if (countdownInterval) clearInterval(countdownInterval);
      $('#countdown-wrapper').show();
      
      let startTime = Date.now();
      let totalMs = seconds * 1000;

      countdownInterval = setInterval(() => {
        let elapsed = Date.now() - startTime;
        let remainingMs = Math.max(0, totalMs - elapsed);
        let remainingSec = (remainingMs / 1000).toFixed(1);
        let pct = (remainingMs / totalMs) * 100;

        $('#countdown-progress').css('width', pct + '%');
        $('#mult-label').html(`NEXT ROUND IN <span style="color:#ffb800; font-weight:900;">${remainingSec}s</span>`);

        if (remainingMs <= 0) {
          clearInterval(countdownInterval);
          $('#countdown-wrapper').hide();
        }
      }, 50);
    }

    function stopCountdownTimer() {
      if (countdownInterval) clearInterval(countdownInterval);
      $('#countdown-wrapper').hide();
    }

    function showToast(msg) {
      $('#toast').text(msg).fadeIn().delay(3000).fadeOut();
    }

    function toggleAutoCashout(panelNum) {
      const sw = $(`#p${panelNum}-toggle-switch`);
      const box = $(`#p${panelNum}-auto-box`);
      sw.toggleClass('active');
      panelState[panelNum].auto = sw.hasClass('active');
      if (panelState[panelNum].auto) box.slideDown(150);
      else box.slideUp(150);
    }

    function stepAmount(inputId, delta) {
      let el = $('#' + inputId);
      let cur = parseFloat(el.val()) || 0;
      let next = Math.max(1, Math.round((cur + delta) * 100) / 100);
      el.val(next.toFixed(2));
      let pNum = inputId.startsWith('p1') ? 1 : 2;
      if (panelState[pNum].status === 'NONE') {
        $(`#p${pNum}-sub`).text('₹' + next.toFixed(2));
      }
    }

    function setQuickAmount(inputId, val) {
      let el = $('#' + inputId);
      el.val(parseFloat(val).toFixed(2));
      let pNum = inputId.startsWith('p1') ? 1 : 2;
      if (panelState[pNum].status === 'NONE') {
        $(`#p${pNum}-sub`).text('₹' + parseFloat(val).toFixed(2));
      }
    }

    function switchMobilePanel(panelNum) {
      if (window.innerWidth >= 640) return;
      $('.panel-tab-btn').removeClass('active');
      $(`#mtab-${panelNum}`).addClass('active');
      if (panelNum === 1) {
        $('#panel-card-1').show();
        $('#panel-card-2').hide();
      } else {
        $('#panel-card-1').hide();
        $('#panel-card-2').show();
      }
    }

    function checkResponsivePanels() {
      if (window.innerWidth < 640) {
        switchMobilePanel(1);
      } else {
        $('#panel-card-1, #panel-card-2').show();
      }
    }
    $(window).on('resize', checkResponsivePanels);

    $('#p1-amount').on('input', function() { if (panelState[1].status === 'NONE') $('#p1-sub').text('₹' + parseFloat($(this).val() || 0).toFixed(2)); });
    $('#p2-amount').on('input', function() { if (panelState[2].status === 'NONE') $('#p2-sub').text('₹' + parseFloat($(this).val() || 0).toFixed(2)); });

    function fetchUserInfo() {
      $.ajax({
        url: '/api/webapi/GetUserInfo',
        type: 'GET',
        success: function(res) {
          if (res && res.data) {
            currentUserPhone = String(res.data.phone_user || res.data.phone || currentUserPhone || '');
            const bal = (res.data.money_user !== undefined && res.data.money_user !== null)
              ? res.data.money_user
              : (res.data.money !== undefined ? res.data.money : 0);
            $('#user-balance').text(parseFloat(bal).toFixed(2));
            if (currentGameState) {
              updateGameStateUI(currentGameState);
            }
          }
        }
      });
    }

    // --- SOCKET HANDLING ---
    function initSocket() {
      socket = io();

      socket.on('connect', function() {
        socket.emit('aviator:join');
      });

      socket.on('aviator:state', function(state) {
        currentGameState = state;
        gameStatus = state.status;
        targetMultiplier = parseFloat(state.currentMultiplier || 1.00);
        updateGameStateUI(state);
      });

      socket.on('aviator:betting', function(data) {
        gameStatus = 'BETTING_OPEN';
        targetMultiplier = 1.00;
        animatedMultiplier = 1.00;
        crashAnimation.active = false;
        $('#mult-val').removeClass('crashed-text').text('1.00x');
        
        [1, 2].forEach(p => {
          if (panelState[p].status === 'QUEUED') {
            panelState[p].status = 'BET_PLACED';
            updatePanelButtonUI(p);
          }
        });

        const durationSec = data ? (data.durationMs / 1000) : 5;
        startCountdownTimer(durationSec);
      });

      socket.on('aviator:flying', function() {
        gameStatus = 'FLYING';
        crashAnimation.active = false;
        stopCountdownTimer();
        $('#mult-label').text('FLYING');
        playChime(600, 'sine');
        [1, 2].forEach(p => {
          if (panelState[p].status === 'QUEUED') {
            panelState[p].status = 'BET_PLACED';
          }
          updatePanelButtonUI(p);
        });
      });

      socket.on('aviator:multiplier', function(data) {
        gameStatus = 'FLYING';
        stopCountdownTimer();
        targetMultiplier = parseFloat(data.multiplier);
        const multStr = targetMultiplier.toFixed(2);
        $('#mult-val').removeClass('crashed-text').text(multStr + 'x');
        $('#mult-label').text('FLYING');
      });

      socket.on('aviator:crashed', function(data) {
        gameStatus = 'CRASHED';
        stopCountdownTimer();
        const crashMult = parseFloat(data.crashMultiplier);
        targetMultiplier = crashMult;
        $('#mult-val').addClass('crashed-text').text(crashMult.toFixed(2) + 'x');
        $('#mult-label').text('FLEW AWAY!');

        // Trigger crash animation launch
        const width = canvas.clientWidth;
        const height = canvas.clientHeight;
        const maxLog = Math.log(100);
        const progress = Math.min(Math.log(Math.max(crashMult, 1)) / maxLog, 0.95);
        const pos = FlightPath.getPosition(progress, width, height);

        crashAnimation = {
          active: true,
          x: pos.x,
          y: pos.y,
          vx: 14 + Math.random() * 6,
          vy: -8 - Math.random() * 4
        };
        planeRenderer.emitExplosion(pos.x, pos.y);

        playChime(200, 'sawtooth');

        [1, 2].forEach(p => {
          // Only reset active bet from this round; preserve QUEUED bets for next round
          if (panelState[p].status === 'BET_PLACED') {
            panelState[p].status = 'NONE';
            panelState[p].betId = null;
            updatePanelButtonUI(p);
          }
        });
        fetchUserInfo();
      });

      socket.on('aviator:player_cashout', function(data) {
        let isMe = false;
        if (currentUserPhone && (String(data.username) === String(currentUserPhone) || String(data.phone) === String(currentUserPhone))) {
          isMe = true;
        }
        [1, 2].forEach(pNum => {
          if (panelState[pNum].betId == data.betId) {
            isMe = true;
            panelState[pNum].status = 'CASHED_OUT';
            updatePanelButtonUI(pNum);
          }
        });
        if (isMe) {
          playChime(1200, 'triangle');
          confetti({ particleCount: 50, spread: 60, origin: { y: 0.8 } });
          showToast(`🎉 CASHED OUT @ ${parseFloat(data.multiplier).toFixed(2)}x (+₹${parseFloat(data.payout).toFixed(2)})`);
          fetchUserInfo();
        }
      });

      socket.on('aviator:player_cancel', function(data) {
        let isMe = false;
        if (currentUserPhone && (String(data.username) === String(currentUserPhone) || String(data.phone) === String(currentUserPhone))) {
          isMe = true;
        }
        [1, 2].forEach(pNum => {
          if (panelState[pNum].betId == data.betId) {
            isMe = true;
            panelState[pNum].status = 'NONE';
            panelState[pNum].betId = null;
            updatePanelButtonUI(pNum);
          }
        });
        if (isMe) {
          showToast(`↩️ Bet cancelled! Refunded ₹${parseFloat(data.amount).toFixed(2)}`);
          fetchUserInfo();
        }
      });
    }

    function updateGameStateUI(state) {
      if (!state) return;

      if (state.recentHistory) {
        let stripHtml = '';
        state.recentHistory.forEach(h => {
          const val = parseFloat(h).toFixed(2);
          let pillClass = 'pill-blue';
          if (val >= 2.0) pillClass = 'pill-purple';
          if (val >= 10.0) pillClass = 'pill-gold';
          stripHtml += `<span class="history-pill ${pillClass}">${val}x</span>`;
        });
        $('#history-strip').html(stripHtml);
      }

      if (state.activeBets) {
        let listHtml = '';
        state.activeBets.forEach(b => {
          let multClass = b.status === 1 ? 'bet-item-mult' : (b.status === 2 ? 'bet-item-mult lost' : '');
          let statusStr = b.status === 1 ? `${parseFloat(b.cashoutMultiplier).toFixed(2)}x` : (b.status === 2 ? 'LOST' : '-');
          listHtml += `
            <div class="bet-item">
              <span class="bet-item-user">${b.username || 'Player'}</span>
              <span>₹${parseFloat(b.money || b.amount).toFixed(2)}</span>
              <span class="${multClass}">${statusStr}</span>
            </div>
          `;

          // Sync local bet state for logged in user
          if (currentUserPhone && (String(b.phone) === String(currentUserPhone) || String(b.username) === String(currentUserPhone)) && b.status === 0) {
            let pNum = b.panelNum || 1;
            if (panelState[pNum].status === 'NONE' || panelState[pNum].status === 'QUEUED') {
              panelState[pNum].status = 'BET_PLACED';
              panelState[pNum].betId = b.id;
              panelState[pNum].amount = parseFloat(b.money || b.amount);
              updatePanelButtonUI(pNum);
            }
          }
        });
        $('#bets-list-container').html(listHtml);
      }
    }

    // Panel Action Handler (Bet, Cancel & Cashout)
    function handlePanelAction(panelNum) {
      const p = panelState[panelNum];
      if (p.isProcessing) return;

      // 1. PLACE NEW BET
      if (p.status === 'NONE') {
        const amount = parseFloat($(`#p${panelNum}-amount`).val());
        const autoVal = p.auto ? parseFloat($(`#p${panelNum}-auto-val`).val()) : null;

        if (isNaN(amount) || amount <= 0) {
          showToast('Please enter a valid bet amount!');
          return;
        }

        p.isProcessing = true;
        $.ajax({
          url: '/api/webapi/aviator/bet',
          type: 'POST',
          data: JSON.stringify({ amount, autoCashout: autoVal, panelNum }),
          contentType: 'application/json',
          success: function(res) {
            p.isProcessing = false;
            if (res.status) {
              p.status = res.isQueued ? 'QUEUED' : 'BET_PLACED';
              p.betId = res.betId;
              p.amount = amount;
              showToast(res.message);
              if (res.newBalance !== undefined) {
                $('#user-balance').text(parseFloat(res.newBalance).toFixed(2));
              }
              updatePanelButtonUI(panelNum);
            } else {
              showToast(res.message || 'Bet failed');
            }
          },
          error: function(err) {
            p.isProcessing = false;
            showToast(err.responseJSON ? err.responseJSON.message : 'Bet failed');
          }
        });
      }
      // 2. CANCEL QUEUED BET (Waiting for next round)
      else if (p.status === 'QUEUED') {
        if (!p.betId) {
          p.status = 'NONE';
          updatePanelButtonUI(panelNum);
          return;
        }
        p.isProcessing = true;
        $.ajax({
          url: '/api/webapi/aviator/cancel_bet',
          type: 'POST',
          data: JSON.stringify({ betId: p.betId }),
          contentType: 'application/json',
          success: function(res) {
            p.isProcessing = false;
            if (res.status) {
              p.status = 'NONE';
              p.betId = null;
              showToast(res.message || 'Bet cancelled!');
              if (res.newBalance !== undefined) {
                $('#user-balance').text(parseFloat(res.newBalance).toFixed(2));
              }
              fetchUserInfo();
              updatePanelButtonUI(panelNum);
            } else {
              showToast(res.message || 'Cancel failed');
            }
          },
          error: function(err) {
            p.isProcessing = false;
            showToast(err.responseJSON ? err.responseJSON.message : 'Cancel failed');
          }
        });
      }
      // 3. BET PLACED (FLYING -> Cashout, WAITING/BETTING_OPEN -> Cancel)
      else if (p.status === 'BET_PLACED') {
        if (gameStatus === 'FLYING') {
          // --- CASH OUT ---
          if (!p.betId) return;
          p.isProcessing = true;
          $.ajax({
            url: '/api/webapi/aviator/cashout',
            type: 'POST',
            data: JSON.stringify({ betId: p.betId }),
            contentType: 'application/json',
            success: function(res) {
              p.isProcessing = false;
              if (res.status) {
                p.status = 'CASHED_OUT';
                showToast(`🎉 CASHED OUT @ ${parseFloat(res.multiplier).toFixed(2)}x (+₹${parseFloat(res.payout).toFixed(2)})`);
                if (res.newBalance !== undefined) {
                  $('#user-balance').text(parseFloat(res.newBalance).toFixed(2));
                }
                confetti({ particleCount: 50, spread: 60, origin: { y: 0.8 } });
                playChime(1200, 'triangle');
                fetchUserInfo();
                updatePanelButtonUI(panelNum);
              } else {
                showToast(res.message || 'Cashout failed');
              }
            },
            error: function(err) {
              p.isProcessing = false;
              showToast(err.responseJSON ? err.responseJSON.message : 'Cashout failed');
            }
          });
        } else {
          // --- CANCEL BET BEFORE FLIGHT ---
          if (!p.betId) {
            p.status = 'NONE';
            updatePanelButtonUI(panelNum);
            return;
          }
          p.isProcessing = true;
          $.ajax({
            url: '/api/webapi/aviator/cancel_bet',
            type: 'POST',
            data: JSON.stringify({ betId: p.betId }),
            contentType: 'application/json',
            success: function(res) {
              p.isProcessing = false;
              if (res.status) {
                p.status = 'NONE';
                p.betId = null;
                showToast(res.message || 'Bet cancelled!');
                if (res.newBalance !== undefined) {
                  $('#user-balance').text(parseFloat(res.newBalance).toFixed(2));
                }
                fetchUserInfo();
                updatePanelButtonUI(panelNum);
              } else {
                showToast(res.message || 'Cancel failed');
              }
            },
            error: function(err) {
              p.isProcessing = false;
              showToast(err.responseJSON ? err.responseJSON.message : 'Cancel failed');
            }
          });
        }
      }
      else if (p.status === 'CASHED_OUT') {
        p.status = 'NONE';
        p.betId = null;
        updatePanelButtonUI(panelNum);
      }
    }

    function updatePanelButtonUI(panelNum) {
      const btn = $(`#p${panelNum}-btn`);
      const sub = $(`#p${panelNum}-sub`);
      const p = panelState[panelNum];

      if (p.status === 'NONE') {
        const amt = parseFloat($(`#p${panelNum}-amount`).val() || 0);
        btn.attr('class', 'btn-action btn-bet').find('span:first').text('BET');
        sub.text('₹' + amt.toFixed(2));
      } else if (p.status === 'QUEUED') {
        btn.attr('class', 'btn-action btn-cancel').find('span:first').text('CANCEL');
        sub.text('WAITING (₹' + p.amount.toFixed(2) + ')');
      } else if (p.status === 'BET_PLACED') {
        if (gameStatus === 'FLYING') {
          const winVal = (p.amount * animatedMultiplier).toFixed(2);
          btn.attr('class', 'btn-action btn-cashout').find('span:first').text('CASHOUT');
          sub.text('₹' + winVal);
        } else {
          btn.attr('class', 'btn-action btn-cancel').find('span:first').text('CANCEL');
          sub.text('₹' + p.amount.toFixed(2));
        }
      } else if (p.status === 'CASHED_OUT') {
        const amt = parseFloat($(`#p${panelNum}-amount`).val() || 0);
        btn.attr('class', 'btn-action btn-bet').find('span:first').text('BET');
        sub.text('₹' + amt.toFixed(2));
        p.status = 'NONE';
        p.betId = null;
      }
    }

    function switchTab(tab) {
      $('.tab-btn').removeClass('active');
      if (tab === 'all') {
        $('#tab-all-btn').addClass('active');
        if (currentGameState) updateGameStateUI(currentGameState);
      } else {
        $('#tab-my-btn').addClass('active');
        fetchMyBets();
      }
    }

    function fetchMyBets() {
      $.ajax({
        url: '/api/webapi/aviator/my_bets',
        type: 'GET',
        success: function(res) {
          if (res.status && res.data) {
            let html = '';
            res.data.forEach(b => {
              let resStr = b.status === 1 ? `WIN ₹${parseFloat(b.get).toFixed(2)} (${parseFloat(b.cashout_multiplier).toFixed(2)}x)` : 'LOST';
              let color = b.status === 1 ? '#10b981' : '#ff2a54';
              html += `
                <div class="bet-item">
                  <span>#${b.period}</span>
                  <span>₹${parseFloat(b.money).toFixed(2)}</span>
                  <span style="color:${color}; font-weight:800;">${resStr}</span>
                </div>
              `;
            });
            $('#bets-list-container').html(html);
          }
        }
      });
    }

    $(document).ready(function() {
      checkResponsivePanels();
      fetchUserInfo();
      setInterval(fetchUserInfo, 3000);
      initSocket();
    });
  </script>
</body>
</html>
