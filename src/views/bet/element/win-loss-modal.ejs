<!-- DiuWin / Raja Club Official Receipt Win & Loss Modal (Pure DOM & CSS) -->
<style id="diuwin-receipt-modal-styles">
  .diuwin-result-overlay {
    position: fixed !important;
    top: 0 !important;
    left: 0 !important;
    right: 0 !important;
    bottom: 0 !important;
    width: 100vw !important;
    height: 100vh !important;
    background: rgba(0, 0, 0, 0.72) !important;
    z-index: 2147483647 !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    flex-direction: column !important;
    opacity: 0 !important;
    visibility: hidden !important;
    transition: opacity 0.3s ease, visibility 0.3s ease !important;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif !important;
  }

  .diuwin-result-overlay.active {
    opacity: 1 !important;
    visibility: visible !important;
  }

  .diuwin-modal-card {
    position: relative !important;
    width: 86% !important;
    max-width: 320px !important;
    border-radius: 26px !important;
    padding: 38px 20px 20px 20px !important;
    text-align: center !important;
    box-sizing: border-box !important;
    transform: scale(0.85) translateY(20px) !important;
    transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1) !important;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5) !important;
  }

  .diuwin-result-overlay.active .diuwin-modal-card {
    transform: scale(1) translateY(0) !important;
  }

  /* Loss Theme (Silver / Ice Blue) */
  .diuwin-modal-card.loss-card {
    background: linear-gradient(180deg, #dbeafe 0%, #e0f2fe 30%, #eff6ff 100%) !important;
    border: 2px solid #bfdbfe !important;
  }

  /* Win Theme (Golden / Amber) */
  .diuwin-modal-card.win-card {
    background: linear-gradient(180deg, #fef3c7 0%, #fef9c3 30%, #fffbeb 100%) !important;
    border: 2px solid #fde047 !important;
  }

  /* Top Winged Rocket Badge */
  .diuwin-top-emblem {
    position: absolute !important;
    top: -46px !important;
    left: 50% !important;
    transform: translateX(-50%) !important;
    width: 150px !important;
    height: 90px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    pointer-events: none !important;
  }

  .emblem-svg {
    width: 100% !important;
    height: 100% !important;
    filter: drop-shadow(0 6px 12px rgba(0,0,0,0.25)) !important;
  }

  .diuwin-modal-title {
    font-size: 26px !important;
    font-weight: 900 !important;
    margin: 10px 0 12px 0 !important;
    letter-spacing: 0.5px !important;
  }

  .loss-card .diuwin-modal-title {
    color: #475569 !important;
  }

  .win-card .diuwin-modal-title {
    color: #dc2626 !important;
    text-shadow: 0 1px 2px rgba(0,0,0,0.1) !important;
  }

  /* Lottery Results Row */
  .diuwin-lottery-results-row {
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 6px !important;
    margin-bottom: 16px !important;
    font-size: 13px !important;
    color: #64748b !important;
    font-weight: 600 !important;
  }

  .lottery-badge {
    padding: 3px 10px !important;
    border-radius: 12px !important;
    font-size: 12px !important;
    font-weight: 700 !important;
    color: #ffffff !important;
    display: inline-block !important;
  }

  .badge-red { background: #ef4444 !important; }
  .badge-green { background: #10b981 !important; }
  .badge-violet { background: #8b5cf6 !important; }
  .badge-num { background: #64748b !important; min-width: 18px !important; }
  .badge-size { background: #3b82f6 !important; }

  /* Slit opening for receipt */
  .receipt-slit-box {
    position: relative !important;
    width: 92% !important;
    margin: 0 auto !important;
  }

  .receipt-slit {
    height: 12px !important;
    background: #94a3b8 !important;
    border-radius: 6px !important;
    box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.4) !important;
    margin: 0 auto !important;
  }

  /* White paper receipt sliding out */
  .receipt-paper {
    background: #ffffff !important;
    border-radius: 0 0 16px 16px !important;
    padding: 16px 14px 14px 14px !important;
    margin: -6px 8px 0 8px !important;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15) !important;
    position: relative !important;
  }

  .receipt-result-text {
    font-size: 26px !important;
    font-weight: 900 !important;
    margin: 0 0 4px 0 !important;
  }

  .loss-card .receipt-result-text {
    color: #64748b !important;
  }

  .win-card .receipt-result-text {
    color: #10b981 !important;
  }

  .receipt-amount-text {
    font-size: 24px !important;
    font-weight: 900 !important;
    color: #10b981 !important;
    margin: 2px 0 6px 0 !important;
  }

  .receipt-period-text {
    font-size: 11px !important;
    color: #94a3b8 !important;
    font-weight: 600 !important;
    margin: 0 !important;
    letter-spacing: 0.3px !important;
  }

  /* Auto-close line */
  .auto-close-row {
    margin-top: 16px !important;
    font-size: 13px !important;
    color: #64748b !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 6px !important;
    font-weight: 500 !important;
  }

  .auto-close-circle {
    width: 14px !important;
    height: 14px !important;
    border-radius: 50% !important;
    border: 1.5px solid #94a3b8 !important;
    display: inline-block !important;
  }

  /* Bottom Floating Close Button */
  .diuwin-modal-close-btn {
    margin-top: 22px !important;
    width: 40px !important;
    height: 40px !important;
    border-radius: 50% !important;
    border: 2px solid rgba(255, 255, 255, 0.85) !important;
    background: rgba(0, 0, 0, 0.3) !important;
    color: #ffffff !important;
    font-size: 22px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    cursor: pointer !important;
    transition: transform 0.2s, background 0.2s !important;
  }

  .diuwin-modal-close-btn:active {
    transform: scale(0.9) !important;
    background: rgba(255, 255, 255, 0.2) !important;
  }
</style>

<!-- Receipt Modal DOM -->
<div id="diuwin-receipt-overlay" class="diuwin-result-overlay">
  <div id="diuwin-receipt-card" class="diuwin-modal-card loss-card">
    
    <!-- Top Emblem SVG -->
    <div class="diuwin-top-emblem">
      <svg class="emblem-svg" viewBox="0 0 160 100" fill="none" xmlns="http://www.w3.org/2000/svg">
        <!-- Wings Background -->
        <path d="M20 55 C35 30, 60 40, 80 50 C100 40, 125 30, 140 55 C125 65, 100 55, 80 60 C60 55, 35 65, 20 55 Z" fill="#93c5fd" opacity="0.9"/>
        <path d="M10 65 C30 45, 55 52, 80 58 C105 52, 130 45, 150 65 C130 75, 105 65, 80 68 C55 65, 30 75, 10 65 Z" fill="#60a5fa" opacity="0.7"/>
        <!-- Central Shield / Circle -->
        <circle cx="80" cy="46" r="32" fill="url(#emblemGrad)" stroke="#ffffff" stroke-width="3.5"/>
        <!-- Ribbon Banner -->
        <path d="M36 76 Q80 88 124 76 Q80 94 36 76 Z" fill="#3b82f6"/>
        <!-- Rocket / Trophy Icon -->
        <g id="emblem-icon-group" transform="translate(62, 28) scale(0.9)">
          <path d="M20 2 C20 2, 28 10, 28 22 C28 26, 26 30, 24 32 L16 32 C14 30, 12 26, 12 22 C12 10, 20 2, 20 2 Z" fill="#ffffff"/>
          <circle cx="20" cy="16" r="3.5" fill="#3b82f6"/>
          <path d="M12 24 L6 30 L12 30 Z" fill="#ffffff" opacity="0.85"/>
          <path d="M28 24 L34 30 L28 30 Z" fill="#ffffff" opacity="0.85"/>
          <path d="M16 33 L20 38 L24 33 Z" fill="#f59e0b"/>
        </g>
        <defs>
          <linearGradient id="emblemGrad" x1="48" y1="14" x2="112" y2="78" gradientUnits="userSpaceOnUse">
            <stop stop-color="#93c5fd"/>
            <stop offset="1" stop-color="#3b82f6"/>
          </linearGradient>
        </defs>
      </svg>
    </div>

    <!-- Title -->
    <div id="diuwin-modal-title" class="diuwin-modal-title">Sorry</div>

    <!-- Lottery Results Badges -->
    <div class="diuwin-lottery-results-row">
      <span>Lottery results</span>
      <span id="badge-color" class="lottery-badge badge-red">Red</span>
      <span id="badge-num" class="lottery-badge badge-num">2</span>
      <span id="badge-size" class="lottery-badge badge-size">Small</span>
    </div>

    <!-- Slit and Receipt Paper -->
    <div class="receipt-slit-box">
      <div class="receipt-slit"></div>
      <div class="receipt-paper">
        <div id="receipt-result-text" class="receipt-result-text">Lose</div>
        <div id="receipt-amount-text" class="receipt-amount-text" style="display: none;">+ ₹ 0.00</div>
        <div id="receipt-period-text" class="receipt-period-text">Period: 202608270045</div>
      </div>
    </div>

    <!-- Auto Close -->
    <div class="auto-close-row">
      <span class="auto-close-circle"></span>
      <span id="auto-close-text">3 seconds auto close</span>
    </div>

  </div>

  <!-- Close (X) button -->
  <div id="diuwin-modal-close-btn" class="diuwin-modal-close-btn">&times;</div>
</div>
