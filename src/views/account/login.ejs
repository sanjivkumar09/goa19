<!DOCTYPE html>
<html translate="no" data-dpr="1" style="font-size: 47.68px">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="robots" content="noindex,nofollow" />
    <meta content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no" name="viewport" />
    <title>DiuWin Games - Login</title>
    <link href="/css/account/chunk-vendors.css" rel="stylesheet" />
    <link href="/css/account/app.css?v=<%= Date.now() %>" rel="stylesheet" />
    <link href="/css/main.css" rel="stylesheet" />
    <link rel="shortcut icon" href="/images/bitbug_favicon.ico" type="image/x-icon" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.css" />
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800&family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        html, body {
            height: 100%;
            width: 100%;
            padding: 0;
            margin: 0;
            font-family: 'Outfit', sans-serif;
            background-color: #071224;
            color: #ffffff;
        }

        body {
            background-image: linear-gradient(rgba(7, 18, 36, 0.93), rgba(15, 41, 74, 0.93)), url('/images/dark_blue_damask.jpg');
            background-size: cover, 320px 320px;
            background-repeat: no-repeat, repeat;
            background-attachment: fixed;
            display: flex;
            justify-content: center;
            align-items: flex-start;
            overflow-y: auto;
        }

        #app {
            width: 100%;
            max-width: 480px;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            position: relative;
            background: transparent;
            box-shadow: 0 0 30px rgba(0, 0, 0, 0.6);
            padding: 24px 20px;
            box-sizing: border-box;
        }

        /* Top Nav Header */
        .nav-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            width: 100%;
            height: 50px;
            margin-bottom: 10px;
        }

        .back-btn {
            font-size: 28px;
            color: #ffffff;
            cursor: pointer;
            transition: transform 0.2s ease, color 0.2s ease;
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .back-btn:hover {
            color: #FFD700;
            transform: translateX(-3px);
        }

        .lang-selector {
            display: flex;
            align-items: center;
            gap: 6px;
            background: rgba(255, 255, 255, 0.08);
            padding: 6px 12px;
            border-radius: 20px;
            font-weight: 500;
            font-size: 14px;
            cursor: pointer;
            border: 1px solid rgba(255, 255, 255, 0.1);
            transition: all 0.3s ease;
        }

        .lang-selector:hover {
            border-color: #FFD700;
            background: rgba(255, 215, 0, 0.1);
        }

        .lang-flag {
            width: 20px;
            height: 20px;
            border-radius: 50%;
            object-fit: cover;
        }

        /* Logo Area */
        .raja-logo-container {
            text-align: center;
            margin-top: 10px;
            margin-bottom: 25px;
        }

        .raja-logo-title {
            font-family: 'Cinzel', serif;
            font-size: 38px;
            font-weight: 800;
            letter-spacing: 5px;
            background: linear-gradient(180deg, #FFF 10%, #FFD700 60%, #E5A93B 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            filter: drop-shadow(0 2px 8px rgba(255, 215, 0, 0.25));
            line-height: 1.1;
        }

        .raja-logo-sub {
            font-family: 'Cinzel', serif;
            font-size: 15px;
            font-weight: 600;
            letter-spacing: 7px;
            color: #D4AF37;
            margin-top: 2px;
            text-shadow: 0 1px 4px rgba(0, 0, 0, 0.5);
        }

        /* Main Form Section */
        .login-box {
            flex: 1;
            display: flex;
            flex-direction: column;
            background: transparent;
        }

        .login-box .tit {
            font-size: 26px;
            font-weight: 700;
            color: #FFD700;
            margin-bottom: 8px;
            text-shadow: 0 2px 4px rgba(0,0,0,0.5);
        }

        .login-box .sub-desc {
            font-size: 13px;
            color: rgba(255, 255, 255, 0.7);
            line-height: 1.5;
            margin-bottom: 25px;
        }

        /* Tabs Styling */
        .tabs-container {
            display: flex;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            margin-bottom: 25px;
            position: relative;
        }

        .tab-item {
            flex: 1;
            text-align: center;
            padding: 12px 0;
            font-size: 15px;
            font-weight: 600;
            color: rgba(255, 255, 255, 0.5);
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 6px;
            position: relative;
        }

        .tab-item i {
            font-size: 18px;
        }

        .tab-item.active {
            color: #FFD700;
        }

        .tab-item.active::after {
            content: '';
            position: absolute;
            bottom: -1px;
            left: 15%;
            right: 15%;
            height: 3px;
            background: #FFD700;
            border-radius: 3px 3px 0 0;
            box-shadow: 0 -2px 10px rgba(255, 215, 0, 0.6);
        }

        /* Form Inputs */
        .input-label-container {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 10px;
            color: rgba(255, 255, 255, 0.9);
            font-size: 14px;
            font-weight: 500;
        }

        .input-label-container i {
            color: #FFD700;
            font-size: 16px;
        }

        .input-wrapper {
            display: flex;
            align-items: center;
            background: rgba(10, 25, 47, 0.7);
            border: 1px solid rgba(212, 175, 55, 0.35);
            border-radius: 12px;
            padding: 4px 14px;
            margin-bottom: 20px;
            min-height: 52px;
            transition: all 0.3s ease;
        }

        .input-wrapper:focus-within {
            border-color: #FFD700;
            box-shadow: 0 0 10px rgba(255, 215, 0, 0.25);
            background: rgba(10, 25, 47, 0.85);
        }

        .country-select {
            display: flex;
            align-items: center;
            gap: 6px;
            color: #ffffff;
            font-size: 15px;
            font-weight: 600;
            padding-right: 12px;
            margin-right: 12px;
            border-right: 1px solid rgba(255, 255, 255, 0.15);
            cursor: pointer;
        }

        .country-select i {
            font-size: 12px;
            color: rgba(255,255,255,0.6);
        }

        .input-field {
            flex: 1;
            background: transparent !important;
            border: none !important;
            outline: none !important;
            color: #ffffff !important;
            font-size: 15px;
            font-family: 'Outfit', sans-serif;
            height: 44px;
            padding: 0;
        }

        .input-field::placeholder {
            color: rgba(255, 255, 255, 0.4);
        }

        .toggle-password {
            font-size: 16px;
            color: rgba(255, 255, 255, 0.5);
            cursor: pointer;
            padding: 10px;
            transition: color 0.2s ease;
        }

        .toggle-password:hover {
            color: #FFD700;
        }

        /* Checkbox */
        .remember-container {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 30px;
            cursor: pointer;
            user-select: none;
            font-size: 13.5px;
            color: rgba(255, 255, 255, 0.75);
        }

        .checkbox-custom {
            width: 18px;
            height: 18px;
            border: 2px solid rgba(255, 255, 255, 0.4);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s ease;
        }

        .remember-container.checked .checkbox-custom {
            border-color: #FFD700;
            background: #FFD700;
        }

        .checkbox-custom::after {
            content: '';
            width: 6px;
            height: 6px;
            background: #071224;
            border-radius: 50%;
            display: none;
        }

        .remember-container.checked .checkbox-custom::after {
            display: block;
        }

        /* Buttons styling */
        .btn-action-container {
            display: flex;
            flex-direction: column;
            gap: 15px;
            margin-bottom: 35px;
        }

        .btn-primary-gold {
            background: linear-gradient(180deg, #1d3d63 0%, #0f294a 100%);
            border: 1.5px solid #D4AF37;
            color: #FFD700;
            height: 52px;
            border-radius: 26px;
            font-size: 17px;
            font-weight: 700;
            letter-spacing: 0.5px;
            cursor: pointer;
            box-shadow: 0 4px 15px rgba(212, 175, 55, 0.25);
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .btn-primary-gold:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(212, 175, 55, 0.4);
            background: linear-gradient(180deg, #244975 0%, #13335c 100%);
        }

        .btn-primary-gold:active {
            transform: translateY(0);
        }

        .btn-secondary-outlined {
            background: rgba(10, 25, 47, 0.5);
            border: 1px solid rgba(255, 255, 255, 0.2);
            color: rgba(255, 255, 255, 0.85);
            height: 52px;
            border-radius: 26px;
            font-size: 17px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .btn-secondary-outlined:hover {
            border-color: #FFD700;
            color: #FFD700;
            background: rgba(255, 215, 0, 0.05);
            transform: translateY(-2px);
        }

        /* Footer Options */
        .footer-shortcuts {
            display: flex;
            justify-content: space-around;
            margin-top: auto;
            padding-top: 20px;
            border-top: 1px solid rgba(255, 255, 255, 0.08);
        }

        .shortcut-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 8px;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .shortcut-item:hover {
            transform: translateY(-3px);
        }

        .shortcut-icon-circle {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.06);
            border: 1.5px solid rgba(212, 175, 55, 0.35);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #FFD700;
            font-size: 20px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.3);
            transition: all 0.3s ease;
        }

        .shortcut-item:hover .shortcut-icon-circle {
            border-color: #FFD700;
            box-shadow: 0 0 12px rgba(255, 215, 0, 0.4);
            background: rgba(255, 215, 0, 0.1);
        }

        .shortcut-label {
            font-size: 12px;
            font-weight: 500;
            color: rgba(255, 255, 255, 0.7);
        }

        .shortcut-item:hover .shortcut-label {
            color: #FFD700;
        }

        /* Msg Toast Override */
        .alert-toast {
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            z-index: 10000;
            width: 80%;
            max-width: 320px;
        }
        .msg-content {
            background: rgba(10, 25, 47, 0.95);
            border: 1px solid #FFD700;
            border-radius: 12px;
            color: #ffffff;
            padding: 12px 20px;
            text-align: center;
            font-size: 14px;
            font-weight: 500;
            box-shadow: 0 10px 25px rgba(0,0,0,0.6);
        }
    </style>
</head>
