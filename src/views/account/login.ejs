<!DOCTYPE html>
<html translate="no" data-dpr="1" style="font-size: 47.68px">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="robots" content="noindex,nofollow" />
    <meta content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no" name="viewport" />
    <title>DiuWin Games - Login</title>
    <link href="/css/account/chunk-vendors.css" rel="stylesheet" />
    <link href="/css/account/app.css?v=<%= Date.now() %>" rel="stylesheet" />
    <link href="/css/main.css" rel="stylesheet" />
    <link rel="shortcut icon" href="/images/bitbug_favicon.ico" type="image/x-icon" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.css" />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        * {
            box-sizing: border-box;
        }

        html, body {
            height: 100%;
            width: 100%;
            padding: 0;
            margin: 0;
            font-family: 'Outfit', sans-serif;
            background-color: #e8ecef;
            color: #0B1833;
        }

        body {
            background-color: #e8ecef;
            display: flex;
            justify-content: center;
            align-items: flex-start;
            overflow-y: auto;
        }

        #app {
            width: 100%;
            max-width: 480px;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            position: relative;
            background: #F5F5F3;
            box-shadow: 0 0 30px rgba(0, 0, 0, 0.12);
            padding: 0;
            box-sizing: border-box;
        }

        /* Top Header Banner - Primary Green Gradient (#20B96B -> #36C66B) matching Screenshot 4 */
        .auth-top-banner {
            background: linear-gradient(135deg, #20B96B 0%, #36C66B 100%);
            padding: 16px 20px 24px 20px;
            color: #ffffff;
            position: relative;
            box-shadow: 0 4px 15px rgba(32, 185, 107, 0.3);
        }

        .auth-banner-nav {
            display: flex;
            align-items: center;
            justify-content: space-between;
            width: 100%;
            height: 40px;
            margin-bottom: 14px;
        }

        .banner-back-btn {
            font-size: 22px;
            color: #ffffff;
            cursor: pointer;
            width: 36px;
            height: 36px;
            display: flex;
            align-items: center;
            justify-content: flex-start;
            transition: transform 0.2s ease;
        }

        .banner-back-btn:hover {
            transform: translateX(-3px);
        }

        .banner-brand-center {
            display: flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
            margin-right: 36px;
            flex: 1;
            justify-content: center;
        }

        .banner-brand-logo {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            border: 1.5px solid #ffffff;
            object-fit: cover;
        }

        .banner-brand-title {
            font-size: 22px;
            font-weight: 900;
            color: #ffffff;
            letter-spacing: -0.3px;
        }

        .lang-selector {
            display: flex;
            align-items: center;
            gap: 4px;
            background: rgba(255, 255, 255, 0.2);
            padding: 3px 8px;
            border-radius: 12px;
            font-size: 11px;
            font-weight: 700;
        }

        .auth-banner-title {
            font-size: 22px;
            font-weight: 800;
            color: #ffffff;
            margin: 0 0 6px 0;
            letter-spacing: -0.3px;
        }

        .auth-banner-sub {
            font-size: 12px;
            color: rgba(255, 255, 255, 0.92);
            line-height: 1.45;
            margin: 0;
        }

        /* Form Area Container */
        .login-content-box {
            flex: 1;
            display: flex;
            flex-direction: column;
            background: #ffffff;
            border-radius: 20px 20px 0 0;
            margin-top: -12px;
            padding: 20px 20px 30px 20px;
            box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.05);
        }

        /* Tabs Styling (Screenshot 4) */
        .tabs-container {
            display: flex;
            border-bottom: 1px solid #ebeef5;
            margin-bottom: 22px;
            position: relative;
        }

        .tab-item {
            flex: 1;
            text-align: center;
            padding: 10px 0;
            font-size: 14px;
            font-weight: 600;
            color: #7C8290;
            cursor: pointer;
            transition: all 0.25s ease;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 6px;
            position: relative;
        }

        .tab-item i {
            font-size: 20px;
        }

        .tab-item.active {
            color: #20B96B;
            font-weight: 800;
        }

        .tab-item.active::after {
            content: '';
            position: absolute;
            bottom: -1px;
            left: 20%;
            right: 20%;
            height: 3px;
            background: #20B96B;
            border-radius: 3px 3px 0 0;
        }

        /* Form Inputs */
        .input-label-container {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 8px;
            color: #0B1833;
            font-size: 13.5px;
            font-weight: 700;
        }

        .label-icon-box {
            width: 22px;
            height: 22px;
            border-radius: 6px;
            background: #e6f7f0;
            color: #20B96B;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
        }

        .input-wrapper {
            display: flex;
            align-items: center;
            background: #ffffff;
            border: 1px solid #e1e4e8;
            border-radius: 12px;
            padding: 4px 14px;
            margin-bottom: 18px;
            min-height: 48px;
            transition: all 0.25s ease;
        }

        .input-wrapper:focus-within {
            border-color: #20B96B;
            box-shadow: 0 0 8px rgba(32, 185, 107, 0.2);
        }

        .country-select {
            display: flex;
            align-items: center;
            gap: 6px;
            color: #0B1833;
            font-size: 14px;
            font-weight: 700;
            padding-right: 12px;
            margin-right: 12px;
            border-right: 1px solid #ebeef5;
            cursor: pointer;
        }

        .country-select i {
            font-size: 11px;
            color: #7C8290;
        }

        .input-field {
            flex: 1;
            background: transparent !important;
            border: none !important;
            outline: none !important;
            color: #0B1833 !important;
            font-size: 14px;
            font-family: 'Outfit', sans-serif;
            height: 42px;
            padding: 0;
        }

        .input-field::placeholder {
            color: #a8b0bd;
            font-size: 13px;
        }

        .toggle-password {
            font-size: 16px;
            color: #7C8290;
            cursor: pointer;
            padding: 10px;
            transition: color 0.2s ease;
        }

        .toggle-password:hover {
            color: #20B96B;
        }

        /* Options Row: Remember Password & Forgot Password */
        .login-options-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 24px;
            font-size: 13px;
        }

        .remember-container {
            display: flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
            user-select: none;
            color: #7C8290;
        }

        .checkbox-custom {
            width: 18px;
            height: 18px;
            border: 2px solid #c5cbda;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s ease;
        }

        .remember-container.checked .checkbox-custom {
            border-color: #20B96B;
            background: #20B96B;
        }

        .checkbox-custom::after {
            content: '';
            width: 6px;
            height: 6px;
            background: #ffffff;
            border-radius: 50%;
            display: none;
        }

        .remember-container.checked .checkbox-custom::after {
            display: block;
        }

        .forgot-password-link {
            color: #20B96B;
            text-decoration: none;
            font-weight: 700;
            font-size: 12.5px;
            cursor: pointer;
        }

        .forgot-password-link:hover {
            text-decoration: underline;
        }

        /* Action Buttons (Primary Green & Outlined Green) */
        .btn-action-container {
            display: flex;
            flex-direction: column;
            gap: 12px;
            margin-bottom: 25px;
        }

        .btn-login-submit {
            background: linear-gradient(135deg, #20B96B 0%, #36C66B 100%);
            border: none;
            color: #ffffff;
            height: 48px;
            border-radius: 25px;
            font-size: 16px;
            font-weight: 800;
            letter-spacing: 0.3px;
            cursor: pointer;
            box-shadow: 0 4px 14px rgba(32, 185, 107, 0.35);
            transition: all 0.25s ease;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .btn-login-submit:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 18px rgba(32, 185, 107, 0.45);
        }

        .btn-login-submit:active {
            transform: translateY(0);
        }

        .btn-register-outlined {
            background: #ffffff;
            border: 1.5px solid #20B96B;
            color: #20B96B;
            height: 48px;
            border-radius: 25px;
            font-size: 16px;
            font-weight: 800;
            cursor: pointer;
            transition: all 0.25s ease;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .btn-register-outlined:hover {
            background: #e6f7f0;
            transform: translateY(-2px);
        }

        /* Floating Support Bubble */
        .floating-support-bubble {
            position: fixed;
            bottom: 30px;
            right: calc(50% - 240px + 16px);
            width: 52px;
            height: 52px;
            border-radius: 50%;
            background: #ffffff;
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 9999;
            cursor: pointer;
            text-decoration: none;
            transition: transform 0.25s ease;
            border: 2px solid #20B96B;
        }

        @media (max-width: 480px) {
            .floating-support-bubble {
                right: 16px;
            }
        }

        .floating-support-bubble:hover {
            transform: scale(1.08);
        }

        .floating-support-bubble img {
            width: 32px;
            height: 32px;
            object-fit: contain;
        }

        /* Msg Toast */
        .alert-toast {
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            z-index: 10000;
            width: 80%;
            max-width: 320px;
        }
        .msg-content {
            background: linear-gradient(135deg, #20B96B 0%, #36C66B 100%);
            border: none;
            border-radius: 12px;
            color: #ffffff;
            padding: 12px 20px;
            text-align: center;
            font-size: 14px;
            font-weight: 700;
            box-shadow: 0 8px 25px rgba(32, 185, 107, 0.4);
        }
    </style>
</head>
<body style="font-size: 12px">
    <div id="app">
        <!-- Top Header Banner (Screenshot 4 Style) -->
        <div class="auth-top-banner">
            <div class="auth-banner-nav">
                <div class="banner-back-btn" onclick="location.href='/home'">
                    <i class="fa fa-angle-left"></i>
                </div>
                <div class="banner-brand-center" onclick="location.href='/home'">
                    <img src="/images/logo.png" alt="DiuWin Logo" class="banner-brand-logo" style="height: 32px; width: auto; object-fit: contain; border-radius: 0; border: none;">
                </div>
                <div class="lang-selector">
                    <i class="fa fa-globe"></i>
                    <span>EN</span>
                </div>
            </div>

            <h1 class="auth-banner-title">Log in</h1>
            <p class="auth-banner-sub">
                Please log in with your phone number or email<br>
                If you forget your password, please contact customer service
            </p>
        </div>

        <!-- Login Form Container -->
        <div class="login-content-box">
            <!-- Tabs -->
            <div class="tabs-container">
                <div class="tab-item active" data-tab="phone">
                    <i class="fa fa-mobile" style="font-size: 22px;"></i>
                    <span>Phone Number</span>
                </div>
                <div class="tab-item" data-tab="email">
                    <i class="fa fa-envelope-o"></i>
                    <span>Email</span>
                </div>
            </div>

            <!-- Form -->
            <div class="mian-from">
                <!-- Username Input Wrapper -->
                <div class="input-label-container">
                    <div class="label-icon-box">
                        <i class="fa fa-mobile" id="input-label-icon" style="font-size: 14px;"></i>
                    </div>
                    <span id="input-label-text">Phone number</span>
                </div>
                <div class="input-wrapper">
                    <!-- Country Code Picker -->
                    <div class="country-select" id="country-code-container">
                        <span>+91</span>
                        <i class="fa fa-chevron-down"></i>
                    </div>
                    <input type="tel" maxlength="10" placeholder="Please enter the phone number" class="input-field" oninput="value=value.replace(/\D/g,'')" id="username-field" />
                </div>

                <!-- Password Input Wrapper -->
                <div class="input-label-container">
                    <div class="label-icon-box">
                        <i class="fa fa-lock" style="font-size: 13px;"></i>
                    </div>
                    <span>Password</span>
                </div>
                <div class="input-wrapper">
                    <input type="password" placeholder="Password" class="input-field pw-input" id="pass_log_id" />
                    <span class="fa fa-fw fa-eye field_icon toggle-password"></span>
                </div>

                <!-- Options Row: Remember Password & Forgot Password -->
                <div class="login-options-row">
                    <div class="remember-container" id="remember-checkbox-trigger">
                        <div class="checkbox-custom"></div>
                        <span>Remember password</span>
                    </div>
                    <a class="forgot-password-link" onclick="location.href='/keFuMenu'">Forgot password?</a>
                </div>

                <!-- Action Buttons -->
                <div class="btn-action-container">
                    <button class="btn-login-submit" id="btn-login">
                        Log In
                    </button>
                    <button class="btn-register-outlined" onclick="location.href='/register'">
                        Register
                    </button>
                </div>
            </div>
        </div>

        <!-- Floating Customer Support Widget -->
        <a href="/keFuMenu" class="floating-support-bubble" title="Customer Support">
            <img src="/images/customer-5ef38c22.png" alt="Support">
        </a>
    </div>

    <!-- Overlay Loader -->
    <div class="van-overlay" style="z-index: 2003; display: none; background: rgba(0,0,0,0.5); position: fixed; top: 0; left: 0; width: 100%; height: 100%;">
        <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); display: flex; flex-direction: column; align-items: center; gap: 10px;">
            <div class="van-loading__spinner" style="color: #20B96B; width: 30px; height: 30px; border: 3px solid rgba(32,185,107,0.2); border-top-color: #20B96B; border-radius: 50%; animation: spin 1s linear infinite;"></div>
        </div>
    </div>
    <div class="alert-toast"></div>

    <style>
        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
    </style>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script>
        function setCookie(cname, cvalue, exdays) {
            const d = new Date();
            d.setTime(d.getTime() + (exdays * 24 * 60 * 60 * 1000));
            let expires = "expires=" + d.toUTCString();
            document.cookie = cname + "=" + cvalue + ";" + expires + ";path=/";
        }
        function getCookie(cname) {
            let name = cname + "=";
            let decodedCookie = decodeURIComponent(document.cookie);
            let ca = decodedCookie.split(';');
            for (let i = 0; i < ca.length; i++) {
                let c = ca[i];
                while (c.charAt(0) == ' ') {
                    c = c.substring(1);
                }
                if (c.indexOf(name) == 0) {
                    return c.substring(name.length, c.length);
                }
            }
            return "";
        }
    </script>
    <script>
        function alertMess(text) {
            let length = $('.alert-toast .msg').length;
            if (length == 0) {
                $('.alert-toast').append(
                    `
                    <div class="msg" style="animation: zoom-in 0.3s ease;">
                        <div class="msg-content"> ${text} </div>
                    </div>
                    `
                );
                setTimeout(() => {
                    $('.msg').fadeOut(200, function() {
                        $('.alert-toast .msg').remove();
                    });
                }, 1800);
            }
        }

        function validateForm(username, password, text) {
            if (!username || !password) {
                alertMess(text);
                return false;
            } else {
                return true;
            }
        }

        // Tab Switching logic
        $('.tab-item').click(function() {
            $('.tab-item').removeClass('active');
            $(this).addClass('active');
            
            const selectedTab = $(this).data('tab');
            const usernameField = $('#username-field');
            const iconElement = $('#input-label-icon');
            const labelTextElement = $('#input-label-text');
            const countryContainer = $('#country-code-container');

            if (selectedTab === 'phone') {
                labelTextElement.text('Phone number');
                iconElement.removeClass('fa-envelope-o').addClass('fa-mobile');
                countryContainer.show();
                usernameField.attr('type', 'tel');
                usernameField.attr('maxlength', '10');
                usernameField.attr('placeholder', 'Please enter the phone number');
                usernameField.attr('oninput', "value=value.replace(/\\D/g,'')");
                usernameField.val(usernameField.val().replace(/\D/g,''));
            } else {
                labelTextElement.text('Email Login');
                iconElement.removeClass('fa-mobile').addClass('fa-envelope-o');
                countryContainer.hide();
                usernameField.attr('type', 'text');
                usernameField.removeAttr('maxlength');
                usernameField.attr('placeholder', 'Please enter the email address');
                usernameField.removeAttr('oninput');
            }
        });

        // Remember password toggle
        $('#remember-checkbox-trigger').click(function() {
            $(this).toggleClass('checked');
            if ($(this).hasClass('checked')) {
                setCookie('remember_me', 'true', 30);
            } else {
                setCookie('remember_me', '', 0);
            }
        });

        // Password visibility toggle
        $(document).on('click', '.toggle-password', function() {
            $(this).toggleClass("fa-eye fa-eye-slash");
            var input = $("#pass_log_id");
            input.attr('type') === 'password' ? input.attr('type','text') : input.attr('type','password');
        });

        // Handle Form Submission
        $('#btn-login').click(async (e) => {
            e.preventDefault();
            let username = $('#username-field').val().trim();
            let password = $('#pass_log_id').val().trim();
            let status = validateForm(username, password, 'Please fill in the necessary fields.');
            
            if (status) {
                $('.van-overlay').fadeIn(100);
                $.ajax({
                    type: "POST",
                    url: "/api/webapi/login",
                    data: {
                        username: username,
                        pwd: password,
                    },
                    dataType: "json",
                    success: function (response) {
                        if (response.status === true) {
                            $('.van-overlay').fadeOut(100);
                            setCookie('token', response.token, 1);
                            setCookie('auth', response.value, 1);
                            
                            alertMess('Login successful!');
                            setTimeout(() => {
                                if (response.level >= 1) {
                                    location.href = '/admin/manager/index';
                                } else {
                                    location.href = '/home';
                                }
                            }, 800);
                        } else {
                            $('.van-overlay').fadeOut(100);
                            alertMess(response.message);
                        }
                    },
                    error: function() {
                        $('.van-overlay').fadeOut(100);
                        alertMess('Network error, please try again.');
                    }
                });
            }
        });
    </script>
    <script>
        $(document).ready(function() {
            if (getCookie('remember_me') === 'true') {
                $('#remember-checkbox-trigger').addClass('checked');
            }
        });

        let getWBody = $('#app').width();
        $('html').css('font-size', `${getWBody / 10}px`);
        $(window).resize(() => {
            let getWBody = $('#app').width();
            $('html').css('font-size', `${getWBody / 10}px`);
        });
    </script>
</body>
</html>