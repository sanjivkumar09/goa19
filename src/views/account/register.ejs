<!DOCTYPE html>
<html translate="no" data-dpr="1" style="font-size: 49.36px;">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="robots" content="noindex,nofollow">
    <meta content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no" name="viewport">
    <title>DiuWin Games - Register</title>
    <link href="/css/account/chunk-vendors.css" rel="stylesheet" /> 
    <link href="/css/account/app.css" rel="stylesheet" />
    <link href="/css/account/chunk.css" rel="stylesheet" />
    <link href="/css/account/chunk-3abb8cfe.27bda068.css" rel="stylesheet" />
    <link href="/css/main.css" rel="stylesheet" />
    <link rel="shortcut icon" href="/images/bitbug_favicon.ico" type="image/x-icon" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.css" />
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800&family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        html, body {
            height: 100%;
            width: 100%;
            padding: 0;
            margin: 0;
            font-family: 'Outfit', sans-serif;
            background-color: #071224;
            color: #ffffff;
        }

        body {
            background-image: linear-gradient(rgba(7, 18, 36, 0.93), rgba(15, 41, 74, 0.93)), url('/images/dark_blue_damask.jpg');
            background-size: cover, 320px 320px;
            background-repeat: no-repeat, repeat;
            background-attachment: fixed;
            display: flex;
            justify-content: center;
            align-items: flex-start;
            overflow-y: auto;
        }

        #app {
            width: 100%;
            max-width: 480px;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            position: relative;
            background: transparent;
            box-shadow: 0 0 30px rgba(0, 0, 0, 0.6);
            padding: 24px 20px;
            box-sizing: border-box;
        }

        /* Top Nav Header */
        .nav-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            width: 100%;
            height: 50px;
            margin-bottom: 10px;
        }

        .back-btn {
            font-size: 28px;
            color: #ffffff;
            cursor: pointer;
            transition: transform 0.2s ease, color 0.2s ease;
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .back-btn:hover {
            color: #FFD700;
            transform: translateX(-3px);
        }

        .nav-title {
            font-size: 19px;
            font-weight: 700;
            color: #ffffff;
            text-align: center;
            flex: 1;
            margin-right: 40px; /* offset back-btn width to center title */
        }

        /* Logo Area */
        .raja-logo-container {
            text-align: center;
            margin-top: 10px;
            margin-bottom: 25px;
        }

        .raja-logo-title {
            font-family: 'Cinzel', serif;
            font-size: 38px;
            font-weight: 800;
            letter-spacing: 5px;
            background: linear-gradient(180deg, #FFF 10%, #FFD700 60%, #E5A93B 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            filter: drop-shadow(0 2px 8px rgba(255, 215, 0, 0.25));
            line-height: 1.1;
        }

        .raja-logo-sub {
            font-family: 'Cinzel', serif;
            font-size: 15px;
            font-weight: 600;
            letter-spacing: 7px;
            color: #D4AF37;
            margin-top: 2px;
            text-shadow: 0 1px 4px rgba(0, 0, 0, 0.5);
        }

        /* Main Form Box */
        .forgot-box {
            flex: 1;
            display: flex;
            flex-direction: column;
            background: transparent;
            padding: 0;
            box-shadow: none;
            backdrop-filter: none;
        }

        .forgot-box .tit {
            font-size: 26px;
            font-weight: 700;
            color: #FFD700;
            margin-bottom: 8px;
            text-shadow: 0 2px 4px rgba(0,0,0,0.5);
        }

        .forgot-box .sub-desc {
            font-size: 13px;
            color: rgba(255, 255, 255, 0.7);
            line-height: 1.5;
            margin-bottom: 25px;
        }

        /* Input Labels */
        .input-label-container {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 10px;
            color: rgba(255, 255, 255, 0.9);
            font-size: 14px;
            font-weight: 500;
        }

        .input-label-container i {
            color: #FFD700;
            font-size: 16px;
        }

        .input-wrapper {
            display: flex;
            align-items: center;
            background: rgba(10, 25, 47, 0.7);
            border: 1px solid rgba(212, 175, 55, 0.35);
            border-radius: 12px;
            padding: 4px 14px;
            margin-bottom: 20px;
            min-height: 52px;
            transition: all 0.3s ease;
        }

        .input-wrapper:focus-within {
            border-color: #FFD700;
            box-shadow: 0 0 10px rgba(255, 215, 0, 0.25);
            background: rgba(10, 25, 47, 0.85);
        }

        .country-select {
            display: flex;
            align-items: center;
            gap: 6px;
            color: #ffffff;
            font-size: 15px;
            font-weight: 600;
            padding-right: 12px;
            margin-right: 12px;
            border-right: 1px solid rgba(255, 255, 255, 0.15);
        }

        .input-field {
            flex: 1;
            background: transparent !important;
            border: none !important;
            outline: none !important;
            color: #ffffff !important;
            font-size: 15px;
            font-family: 'Outfit', sans-serif;
            height: 44px;
            padding: 0;
        }

        .input-field::placeholder {
            color: rgba(255, 255, 255, 0.4);
        }

        .toggle-password {
            font-size: 16px;
            color: rgba(255, 255, 255, 0.5);
            cursor: pointer;
            padding: 10px;
            transition: color 0.2s ease;
        }

        .toggle-password:hover {
            color: #FFD700;
        }

        /* Checkbox Agreement */
        .agreement-container {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 30px;
            cursor: pointer;
            user-select: none;
            font-size: 13.5px;
            color: rgba(255, 255, 255, 0.75);
        }

        .checkbox-custom {
            width: 18px;
            height: 18px;
            border: 2px solid rgba(255, 255, 255, 0.4);
            border-radius: 4px; /* square checkbox */
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s ease;
        }

        .agreement-container.checked .checkbox-custom {
            border-color: #FFD700;
            background: #FFD700;
        }

        .checkbox-custom::after {
            content: '✓';
            color: #071224;
            font-size: 12px;
            font-weight: bold;
            display: none;
        }

        .agreement-container.checked .checkbox-custom::after {
            display: block;
        }

        .policy-link {
            color: #FFD700;
            text-decoration: none;
            font-weight: 500;
        }

        .policy-link:hover {
            text-decoration: underline;
        }

        /* Action Buttons */
        .btn-action-container {
            display: flex;
            flex-direction: column;
            gap: 15px;
            margin-bottom: 25px;
        }

        .btn-primary-gold {
            background: linear-gradient(180deg, #1d3d63 0%, #0f294a 100%);
            border: 1.5px solid #D4AF37;
            color: #FFD700;
            height: 52px;
            border-radius: 26px;
            font-size: 17px;
            font-weight: 700;
            letter-spacing: 0.5px;
            cursor: pointer;
            box-shadow: 0 4px 15px rgba(212, 175, 55, 0.25);
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .btn-primary-gold:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(212, 175, 55, 0.4);
            background: linear-gradient(180deg, #244975 0%, #13335c 100%);
        }

        .btn-secondary-outlined {
            background: rgba(10, 25, 47, 0.5);
            border: 1px solid rgba(255, 255, 255, 0.2);
            color: rgba(255, 255, 255, 0.85);
            height: 52px;
            border-radius: 26px;
            font-size: 17px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .btn-secondary-outlined:hover {
            border-color: #FFD700;
            color: #FFD700;
            background: rgba(255, 215, 0, 0.05);
            transform: translateY(-2px);
        }

        /* Alert Toast */
        .alert-toast {
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            z-index: 10000;
            width: 80%;
            max-width: 320px;
        }
        .msg-content {
            background: rgba(10, 25, 47, 0.95);
            border: 1px solid #FFD700;
            border-radius: 12px;
            color: #ffffff;
            padding: 12px 20px;
            text-align: center;
            font-size: 14px;
            font-weight: 500;
            box-shadow: 0 10px 25px rgba(0,0,0,0.6);
        }
    </style>
</head>

<body style="font-size: 12px;">
    <div id="app">
        <!-- Top Nav Header -->
        <div class="nav-header">
            <div class="back-btn" onclick="location.href='/login'">
                <i class="fa fa-angle-left"></i>
            </div>
            <div class="nav-title">Register</div>
        </div>

        <!-- Dynamic DiuWin GAMES Logo -->
        <div class="raja-logo-container" style="display: flex; align-items: center; justify-content: center; gap: 12px; margin-top: 15px; margin-bottom: 25px;">
            <img src="/images/diuwin_logo.jpg" alt="DiuWin Logo" style="width: 44px; height: 44px; object-fit: cover; object-position: 50% 12%; border-radius: 50%; border: 1.5px solid rgba(229, 192, 96, 0.4); box-shadow: 0 0 10px rgba(229, 192, 96, 0.3);">
            <div style="display: flex; flex-direction: column; text-align: left;">
                <div class="raja-logo-title" style="font-size: 32px; letter-spacing: 2px; line-height: 1;">DiuWin</div>
                <div class="raja-logo-sub" style="font-size: 13px; letter-spacing: 5px; margin-top: 2px;">GAMES</div>
            </div>
        </div>

        <!-- Register Box -->
        <div class="forgot-box">
            <div class="tit">Create Account</div>
            <div class="sub-desc">Register with your mobile phone number. Set up a secure password to protect your funds.</div>

            <div class="mian-from">
                <!-- Phone input label -->
                <div class="input-label-container">
                    <i class="fa fa-mobile" style="font-size: 20px;"></i>
                    <span>Phone number</span>
                </div>
                <!-- Phone input wrapper -->
                <div class="input-wrapper">
                    <div class="country-select">
                        <span>+91</span>
                    </div>
                    <input id="username" type="tel" maxlength="10" placeholder="Please Enter The Phone number" class="input-field" oninput="value=value.replace(/\D/g,'')">
                </div>

                <!-- Password label -->
                <div class="input-label-container">
                    <i class="fa fa-lock"></i>
                    <span>Set Password</span>
                </div>
                <!-- Password input wrapper -->
                <div class="input-wrapper">
                    <input id="password" type="password" placeholder="Please Enter The Password" class="input-field pw-input">
                    <span class="fa fa-fw fa-eye field_icon toggle-password"></span>
                </div>

                <!-- Agree Policy Checkbox -->
                <div class="agreement-container checked" id="agreement-checkbox-trigger">
                    <div class="checkbox-custom"></div>
                    <span>I agree to the <a href="#" class="policy-link" onclick="event.stopPropagation(); alert('Privacy Policy is being updated.');">Privacy policy</a></span>
                </div>

                <!-- Submit / Buttons -->
                <div class="btn-action-container">
                    <button id="submit" class="btn-primary-gold">
                        Register
                    </button>
                    <button class="btn-secondary-outlined" onclick="location.href='/login'">
                        Login
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Overlay Loader -->
    <div class="van-overlay" style="z-index: 2003; display: none; background: rgba(0,0,0,0.5); position: fixed; top: 0; left: 0; width: 100%; height: 100%;">
        <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); display: flex; flex-direction: column; align-items: center; gap: 10px;">
            <div class="van-loading__spinner" style="color: #FFD700; width: 30px; height: 30px; border: 3px solid rgba(255,215,0,0.2); border-top-color: #FFD700; border-radius: 50%; animation: spin 1s linear infinite;"></div>
        </div>
    </div>
    <div class="alert-toast"></div>

    <style>
        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
    </style>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script>
        function setCookie(cname, cvalue, exdays) {
            const d = new Date();
            d.setTime(d.getTime() + (exdays * 24 * 60 * 60 * 1000));
            let expires = "expires=" + d.toUTCString();
            document.cookie = cname + "=" + cvalue + ";" + expires + ";path=/";
        }
        function getCookie(cname) {
            let name = cname + "=";
            let decodedCookie = decodeURIComponent(document.cookie);
            let ca = decodedCookie.split(';');
            for (let i = 0; i < ca.length; i++) {
                let c = ca[i];
                while (c.charAt(0) == ' ') {
                    c = c.substring(1);
                }
                if (c.indexOf(name) == 0) {
                    return c.substring(name.length, c.length);
                }
            }
            return "";
        }
        function unsetCookie() {
            setCookie('token', '', 0);
            setCookie('auth', '', 0);
        }
    </script>
    <script>
        function alertMess(text) {
            let length = $('.alert-toast .msg').length;
            if (length == 0) {
                $('.alert-toast').append(
                    `
                    <div class="msg" style="animation: zoom-in 0.3s ease;">
                        <div class="msg-content"> ${text} </div>
                    </div>
                    `
                );
                setTimeout(() => {
                    $('.msg').fadeOut(200, function() {
                        $('.alert-toast .msg').remove();
                    });
                }, 1800);
            }
        }

        $('#agreement-checkbox-trigger').click(function() {
            $(this).toggleClass('checked');
        });

        function validateForm(username, password, invite, checkbox, text) {
            if (!username || !checkbox || !password) {
                alertMess(text);
                return false;
            } else {
                return true;
            }
        }

        $(document).on('click', '.toggle-password', function() {
            $(this).toggleClass("fa-eye fa-eye-slash");
            var input = $("#password");
            input.attr('type') === 'password' ? input.attr('type','text') : input.attr('type','password');
        });

        $('#submit').click(async (e) => { 
            e.preventDefault();
            let username = $('#username').val().trim();
            let password = $('#password').val().trim();
            let invite = '';
            let checkbox = $('#agreement-checkbox-trigger').hasClass('checked');
            let status = validateForm(username, password, invite, checkbox, 'Please fill in all fields and accept the policies');
            
            if (status) {
                $('.van-overlay').fadeIn(100);
                $.ajax({
                    type: "POST",
                    url: "/api/webapi/register",
                    data: {
                        username: username,
                        pwd: password,
                        invitecode: invite,
                    },
                    dataType: "json", 
                    success: function (response) {
                        if (response.status === true) {
                            $('.van-overlay').fadeOut(100);
                            alertMess(response.message);
                            setTimeout(() => {
                                location.href = '/login';
                            }, 1000);
                        } else {
                            $('.van-overlay').fadeOut(100);
                            alertMess(response.message);
                        }
                    },
                    error: function() {
                        $('.van-overlay').fadeOut(100);
                        alertMess('Network error, please try again.');
                    }
                });
            }
        });
    </script>
    <script>
        let getWBody = $('#app').width();
        $('html').css('font-size', `${getWBody / 10}px`);
        $(window).resize(() => {
            let getWBody = $('#app').width();
            $('html').css('font-size', `${getWBody / 10}px`);
        });

        var url = new URL(window.location.href);
        var c = url.searchParams.get("r_code");
        if (c) {
            setCookie('invite_code', c, 7);
        }
    </script>
</body>
</html>