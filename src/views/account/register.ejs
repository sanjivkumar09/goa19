<!DOCTYPE html>
<html translate="no" data-dpr="1" style="font-size: 49.36px;">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="robots" content="noindex,nofollow">
    <meta content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no" name="viewport">
    <title>DiuWin Games - Register</title>
    <link href="/css/account/chunk-vendors.css" rel="stylesheet" /> 
    <link href="/css/account/app.css" rel="stylesheet" />
    <link href="/css/account/chunk.css" rel="stylesheet" />
    <link href="/css/account/chunk-3abb8cfe.27bda068.css" rel="stylesheet" />
    <link href="/css/main.css" rel="stylesheet" />
    <link rel="shortcut icon" href="/images/bitbug_favicon.ico" type="image/x-icon" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.css" />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        * {
            box-sizing: border-box;
        }

        html, body {
            height: 100%;
            width: 100%;
            padding: 0;
            margin: 0;
            font-family: 'Outfit', sans-serif;
            background-color: #7b8494;
            color: #1e2329;
        }

        body {
            background-color: #7b8494;
            display: flex;
            justify-content: center;
            align-items: flex-start;
            overflow-y: auto;
        }

        #app {
            width: 100%;
            max-width: 480px;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            position: relative;
            background: #ffffff;
            box-shadow: 0 0 30px rgba(0, 0, 0, 0.15);
            padding: 0;
            box-sizing: border-box;
        }

        /* Top Header Banner with Image */
        .auth-top-banner {
            background: url('/images/login_header_bg.png') no-repeat center center;
            background-size: cover;
            background-color: #ff5e52;
            padding: 16px 20px 24px 20px;
            color: #ffffff;
            position: relative;
            box-shadow: 0 4px 15px rgba(255, 94, 82, 0.25);
        }

        .auth-banner-nav {
            display: flex;
            align-items: center;
            justify-content: space-between;
            width: 100%;
            height: 40px;
            margin-bottom: 12px;
        }

        .banner-back-btn {
            font-size: 22px;
            color: #ffffff;
            cursor: pointer;
            width: 36px;
            height: 36px;
            display: flex;
            align-items: center;
            justify-content: flex-start;
            transition: transform 0.2s ease;
        }

        .banner-back-btn:hover {
            transform: translateX(-3px);
        }

        .banner-brand-center {
            display: flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
            margin-right: 36px;
            flex: 1;
            justify-content: center;
        }

        .banner-brand-logo {
            width: 26px;
            height: 26px;
            border-radius: 50%;
            border: 1.5px solid #ffffff;
            object-fit: cover;
        }

        .banner-brand-title {
            font-size: 20px;
            font-weight: 800;
            color: #ffffff;
            letter-spacing: 0.5px;
        }

        .auth-banner-title {
            font-size: 24px;
            font-weight: 800;
            color: #ffffff;
            margin: 0 0 6px 0;
            letter-spacing: -0.3px;
        }

        .auth-banner-sub {
            font-size: 11.5px;
            color: rgba(255, 255, 255, 0.92);
            line-height: 1.45;
            margin: 0;
        }

        /* Main Form Section */
        .register-content-box {
            flex: 1;
            display: flex;
            flex-direction: column;
            background: #ffffff;
            padding: 20px 20px 30px 20px;
        }

        /* Input Labels */
        .input-label-container {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 8px;
            color: #1e2329;
            font-size: 13.5px;
            font-weight: 600;
        }

        .label-icon-box {
            width: 22px;
            height: 22px;
            border-radius: 6px;
            background: #ffebe9;
            color: #ff4d4f;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
        }

        .input-wrapper {
            display: flex;
            align-items: center;
            background: #ffffff;
            border: 1px solid #e1e4e8;
            border-radius: 12px;
            padding: 4px 14px;
            margin-bottom: 18px;
            min-height: 48px;
            transition: all 0.25s ease;
        }

        .input-wrapper:focus-within {
            border-color: #ff4d4f;
            box-shadow: 0 0 8px rgba(255, 77, 79, 0.2);
        }

        .country-select {
            display: flex;
            align-items: center;
            gap: 6px;
            color: #1e2329;
            font-size: 14px;
            font-weight: 600;
            padding-right: 12px;
            margin-right: 12px;
            border-right: 1px solid #ebeef5;
        }

        .input-field {
            flex: 1;
            background: transparent !important;
            border: none !important;
            outline: none !important;
            color: #1e2329 !important;
            font-size: 14px;
            font-family: 'Outfit', sans-serif;
            height: 42px;
            padding: 0;
        }

        .input-field::placeholder {
            color: #a8b0bd;
            font-size: 13px;
        }

        .toggle-password {
            font-size: 16px;
            color: #8b96a5;
            cursor: pointer;
            padding: 10px;
            transition: color 0.2s ease;
        }

        .toggle-password:hover {
            color: #ff4d4f;
        }

        /* Checkbox Policy */
        .agreement-container {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 25px;
            cursor: pointer;
            user-select: none;
            font-size: 13px;
            color: #5d6472;
        }

        .checkbox-custom {
            width: 18px;
            height: 18px;
            border: 2px solid #c5cbda;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s ease;
        }

        .agreement-container.checked .checkbox-custom {
            border-color: #ff4d4f;
            background: #ff4d4f;
        }

        .checkbox-custom::after {
            content: '';
            width: 6px;
            height: 6px;
            background: #ffffff;
            border-radius: 50%;
            display: none;
        }

        .agreement-container.checked .checkbox-custom::after {
            display: block;
        }

        .policy-link {
            color: #ff4d4f;
            text-decoration: none;
            font-weight: 600;
        }

        /* Action Buttons */
        .btn-action-container {
            display: flex;
            flex-direction: column;
            gap: 12px;
            margin-bottom: 25px;
        }

        .btn-primary-gold {
            background: linear-gradient(90deg, #ff7165 0%, #ff4c4c 100%);
            border: none;
            color: #ffffff;
            height: 48px;
            border-radius: 25px;
            font-size: 16px;
            font-weight: 700;
            letter-spacing: 0.3px;
            cursor: pointer;
            box-shadow: 0 4px 14px rgba(255, 76, 76, 0.35);
            transition: all 0.25s ease;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .btn-primary-gold:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 18px rgba(255, 76, 76, 0.45);
        }

        .btn-primary-gold:active {
            transform: translateY(0);
        }

        .btn-secondary-outlined {
            background: #ffffff;
            border: 1.5px solid #ff4d4f;
            color: #ff4d4f;
            height: 48px;
            border-radius: 25px;
            font-size: 16px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.25s ease;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .btn-secondary-outlined:hover {
            background: #fff2f0;
            transform: translateY(-2px);
        }

        /* Floating Support Bubble */
        .floating-support-bubble {
            position: fixed;
            bottom: 30px;
            right: calc(50% - 240px + 16px);
            width: 52px;
            height: 52px;
            border-radius: 50%;
            background: #ffffff;
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 9999;
            cursor: pointer;
            text-decoration: none;
            transition: transform 0.25s ease;
            border: 2px solid #ff7165;
        }

        @media (max-width: 480px) {
            .floating-support-bubble {
                right: 16px;
            }
        }

        .floating-support-bubble:hover {
            transform: scale(1.08);
        }

        .floating-support-bubble img {
            width: 32px;
            height: 32px;
            object-fit: contain;
        }

        /* Alert Toast */
        .alert-toast {
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            z-index: 10000;
            width: 80%;
            max-width: 320px;
        }
        .msg-content {
            background: linear-gradient(135deg, #ff7165 0%, #ff4c4c 100%);
            border: none;
            border-radius: 12px;
            color: #ffffff;
            padding: 12px 20px;
            text-align: center;
            font-size: 14px;
            font-weight: 700;
            box-shadow: 0 8px 25px rgba(255, 76, 76, 0.4);
        }
    </style>
</head>

<body style="font-size: 12px;">
    <div id="app">
        <!-- Top Header Banner (Image 2 Style) -->
        <div class="auth-top-banner">
            <div class="auth-banner-nav">
                <div class="banner-back-btn" onclick="location.href='/login'">
                    <i class="fa fa-angle-left"></i>
                </div>
                <div class="banner-brand-center" onclick="location.href='/home'">
                    <img src="/images/diuwin_logo.jpg" alt="DiuWin Logo" class="banner-brand-logo">
                    <span class="banner-brand-title">DiuWin</span>
                </div>
            </div>

            <h1 class="auth-banner-title">Register</h1>
            <p class="auth-banner-sub">Please register by phone number or email</p>
        </div>

        <!-- Register Box -->
        <div class="register-content-box">
            <div class="mian-from">
                <!-- Phone input label -->
                <div class="input-label-container">
                    <div class="label-icon-box">
                        <i class="fa fa-mobile" style="font-size: 14px;"></i>
                    </div>
                    <span>Phone number</span>
                </div>
                <!-- Phone input wrapper -->
                <div class="input-wrapper">
                    <div class="country-select">
                        <span>+91</span>
                    </div>
                    <input id="username" type="tel" maxlength="10" placeholder="Please Enter The Phone number" class="input-field" oninput="value=value.replace(/\D/g,'')">
                </div>

                <!-- Password label -->
                <div class="input-label-container">
                    <div class="label-icon-box">
                        <i class="fa fa-lock" style="font-size: 13px;"></i>
                    </div>
                    <span>Set Password</span>
                </div>
                <!-- Password input wrapper -->
                <div class="input-wrapper">
                    <input id="password" type="password" placeholder="Please Enter The Password" class="input-field pw-input">
                    <span class="fa fa-fw fa-eye field_icon toggle-password"></span>
                </div>

                <!-- Agree Policy Checkbox -->
                <div class="agreement-container checked" id="agreement-checkbox-trigger">
                    <div class="checkbox-custom"></div>
                    <span>I have read and agree <a href="#" class="policy-link" onclick="event.stopPropagation(); alert('Privacy Policy is being updated.');">【Privacy Agreement】</a></span>
                </div>

                <!-- Submit / Buttons -->
                <div class="btn-action-container">
                    <button id="submit" class="btn-primary-gold">
                        Register
                    </button>
                    <button class="btn-secondary-outlined" onclick="location.href='/login'">
                        I have an account, Log in
                    </button>
                </div>
            </div>
        </div>

        <!-- Floating Customer Support Widget -->
        <a href="/keFuMenu" class="floating-support-bubble" title="Customer Support">
            <img src="/images/customer-5ef38c22.png" alt="Support">
        </a>
    </div>

    <!-- Overlay Loader -->
    <div class="van-overlay" style="z-index: 2003; display: none; background: rgba(0,0,0,0.5); position: fixed; top: 0; left: 0; width: 100%; height: 100%;">
        <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); display: flex; flex-direction: column; align-items: center; gap: 10px;">
            <div class="van-loading__spinner" style="color: #ff4d4f; width: 30px; height: 30px; border: 3px solid rgba(255,77,79,0.2); border-top-color: #ff4d4f; border-radius: 50%; animation: spin 1s linear infinite;"></div>
        </div>
    </div>
    <div class="alert-toast"></div>

    <style>
        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
    </style>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script>
        function setCookie(cname, cvalue, exdays) {
            const d = new Date();
            d.setTime(d.getTime() + (exdays * 24 * 60 * 60 * 1000));
            let expires = "expires=" + d.toUTCString();
            document.cookie = cname + "=" + cvalue + ";" + expires + ";path=/";
        }
        function getCookie(cname) {
            let name = cname + "=";
            let decodedCookie = decodeURIComponent(document.cookie);
            let ca = decodedCookie.split(';');
            for (let i = 0; i < ca.length; i++) {
                let c = ca[i];
                while (c.charAt(0) == ' ') {
                    c = c.substring(1);
                }
                if (c.indexOf(name) == 0) {
                    return c.substring(name.length, c.length);
                }
            }
            return "";
        }
        function unsetCookie() {
            setCookie('token', '', 0);
            setCookie('auth', '', 0);
        }
    </script>
    <script>
        function alertMess(text) {
            let length = $('.alert-toast .msg').length;
            if (length == 0) {
                $('.alert-toast').append(
                    `
                    <div class="msg" style="animation: zoom-in 0.3s ease;">
                        <div class="msg-content"> ${text} </div>
                    </div>
                    `
                );
                setTimeout(() => {
                    $('.msg').fadeOut(200, function() {
                        $('.alert-toast .msg').remove();
                    });
                }, 1800);
            }
        }

        $('#agreement-checkbox-trigger').click(function() {
            $(this).toggleClass('checked');
        });

        function validateForm(username, password, invite, checkbox, text) {
            if (!username || !checkbox || !password) {
                alertMess(text);
                return false;
            } else {
                return true;
            }
        }

        $(document).on('click', '.toggle-password', function() {
            $(this).toggleClass("fa-eye fa-eye-slash");
            var input = $("#password");
            input.attr('type') === 'password' ? input.attr('type','text') : input.attr('type','password');
        });

        $('#submit').click(async (e) => { 
            e.preventDefault();
            let username = $('#username').val().trim();
            let password = $('#password').val().trim();
            let invite = '';
            let checkbox = $('#agreement-checkbox-trigger').hasClass('checked');
            let status = validateForm(username, password, invite, checkbox, 'Please fill in all fields and accept the policies');
            
            if (status) {
                $('.van-overlay').fadeIn(100);
                $.ajax({
                    type: "POST",
                    url: "/api/webapi/register",
                    data: {
                        username: username,
                        pwd: password,
                        invitecode: invite,
                    },
                    dataType: "json", 
                    success: function (response) {
                        if (response.status === true) {
                            $('.van-overlay').fadeOut(100);
                            alertMess(response.message);
                            setTimeout(() => {
                                location.href = '/login';
                            }, 1000);
                        } else {
                            $('.van-overlay').fadeOut(100);
                            alertMess(response.message);
                        }
                    },
                    error: function() {
                        $('.van-overlay').fadeOut(100);
                        alertMess('Network error, please try again.');
                    }
                });
            }
        });
    </script>
    <script>
        let getWBody = $('#app').width();
        $('html').css('font-size', `${getWBody / 10}px`);
        $(window).resize(() => {
            let getWBody = $('#app').width();
            $('html').css('font-size', `${getWBody / 10}px`);
        });

        var url = new URL(window.location.href);
        var c = url.searchParams.get("r_code");
        if (c) {
            setCookie('invite_code', c, 7);
        }
    </script>
</body>
</html>