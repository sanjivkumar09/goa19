<!DOCTYPE html>
<html lang="en" translate="no">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
	<meta name="google" content="notranslate">
	<meta name="robots" content="noindex,nofollow">
	<link rel="icon" type="image/x-icon" href="/images/bitbug_favicon.ico">
	<title>BDG Win</title>
	<link rel="stylesheet" href="/css/main.css">
	<link rel="stylesheet" href="/css/home-modern.css">
	<style>
		@keyframes shineEffect {
			0% {
				background-position: -200% center;
			}
			100% {
				background-position: 200% center;
			}
		}
		
		.game-card-shine {
			position: relative;
			overflow: hidden;
		}
		
		.game-card-shine::before {
			content: '';
			position: absolute;
			top: 0;
			left: -100%;
			width: 100%;
			height: 100%;
			background: linear-gradient(
				90deg,
				transparent 0%,
				rgba(255, 255, 255, 0.3) 40%,
				rgba(255, 255, 255, 0.5) 50%,
				rgba(255, 255, 255, 0.3) 60%,
				transparent 100%
			);
			animation: shineEffect 3s infinite;
			pointer-events: none;
			z-index: 10;
		}
		
		.game-card-shine:hover::before {
			animation: shineEffect 1.5s infinite;
		}
		
		/* Banner Carousel Styles */
		.banner-carousel {
			position: relative;
			width: 100%;
			max-width: 1040px;
			margin: 0 auto;
			overflow: hidden;
			border-radius: 12px;
			box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
		}
		
		.banner-slide {
			display: none;
			width: 100%;
			animation: fadeIn 0.8s ease-in-out;
		}
		
		.banner-slide.active {
			display: block;
		}
		
		.banner-slide img {
			width: 100%;
			height: auto;
			display: block;
			object-fit: cover;
			max-height: 280px;
		}
		
		@keyframes fadeIn {
			from {
				opacity: 0;
				transform: scale(1.05);
			}
			to {
				opacity: 1;
				transform: scale(1);
			}
		}
		
		/* Navigation Arrows */
		.banner-prev,
		.banner-next {
			position: absolute;
			top: 50%;
			transform: translateY(-50%);
			background: rgba(0, 0, 0, 0.5);
			color: #FFD700;
			border: none;
			font-size: 24px;
			padding: 12px 16px;
			cursor: pointer;
			border-radius: 50%;
			transition: all 0.3s ease;
			z-index: 10;
			backdrop-filter: blur(5px);
		}
		
		.banner-prev:hover,
		.banner-next:hover {
			background: rgba(212, 175, 55, 0.8);
			color: #000;
			transform: translateY(-50%) scale(1.1);
		}
		
		.banner-prev {
			left: 10px;
		}
		
		.banner-next {
			right: 10px;
		}
		
		/* Dots Indicator */
		.banner-dots {
			position: absolute;
			bottom: 15px;
			left: 50%;
			transform: translateX(-50%);
			display: flex;
			gap: 8px;
			z-index: 10;
		}
		
		.dot {
			width: 10px;
			height: 10px;
			border-radius: 50%;
			background: rgba(255, 255, 255, 0.5);
			cursor: pointer;
			transition: all 0.3s ease;
			border: 2px solid transparent;
		}
		
		.dot:hover {
			background: rgba(255, 255, 255, 0.8);
			transform: scale(1.2);
		}
		
		.dot.active {
			background: #FFD700;
			border-color: #fff;
			transform: scale(1.3);
		}
		
		/* Responsive Design */
		@media (max-width: 768px) {
			.banner-carousel {
				border-radius: 8px;
			}
			
			.banner-slide img {
				max-height: 180px;
			}
			
			.banner-prev,
			.banner-next {
				font-size: 18px;
				padding: 8px 12px;
			}
			
			.dot {
				width: 8px;
				height: 8px;
			}
		}
		
		/* Games Carousel Styles */
		.games-carousel {
			position: relative;
			width: 100%;
			max-width: 1040px;
			margin: 0 auto;
			padding: 20px 0;
		}
		
		.game-slide {
			display: none;
			width: 100%;
			animation: fadeIn 0.8s ease-in-out;
			padding: 0 50px;
		}
		
		.game-slide.active {
			display: flex;
			justify-content: center;
		}
		
		.game-slide .game-card {
			width: 100%;
			max-width: 400px;
		}
		
		.game-prev,
		.game-next {
			position: absolute;
			top: 40%;
			transform: translateY(-50%);
			background: rgba(0, 0, 0, 0.5);
			color: #FFD700;
			border: none;
			font-size: 24px;
			padding: 12px 16px;
			cursor: pointer;
			border-radius: 50%;
			transition: all 0.3s ease;
			z-index: 10;
			backdrop-filter: blur(5px);
		}
		
		.game-prev:hover,
		.game-next:hover {
			background: rgba(212, 175, 55, 0.8);
			color: #000;
			transform: translateY(-50%) scale(1.1);
		}
		
		.game-prev {
			left: 10px;
		}
		
		.game-next {
			right: 10px;
		}
		
		.game-dots {
			text-align: center;
			padding: 15px 0;
			display: flex;
			justify-content: center;
			gap: 8px;
		}
		
		@media (max-width: 768px) {
			.game-slide {
				padding: 0 45px;
			}
			
			.game-prev,
			.game-next {
				font-size: 18px;
				padding: 8px 12px;
			}
		}
	</style>
</head>
