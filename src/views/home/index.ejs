	<script>
		document.addEventListener('DOMContentLoaded', function() {
			const currentPath = window.location.pathname;
			document.querySelectorAll('.nav-item').forEach(item => {
				const href = item.getAttribute('href');
				if (currentPath === href || (currentPath === '/' && href === '/home')) {
					item.classList.add('active');
				} else {
					item.classList.remove('active');
				}
			});
		});
		
		// Banner Carousel Auto-Rotation
		let currentBannerIndex = 1;
		let bannerInterval;
		
		// Show specific banner
		function showBanner(n) {
			const slides = document.querySelectorAll('.banner-slide');
			const dots = document.querySelectorAll('.dot');
			
			if (n > slides.length) {
				currentBannerIndex = 1;
			}
			if (n < 1) {
				currentBannerIndex = slides.length;
			}
			
			// Hide all slides
			slides.forEach(slide => {
				slide.classList.remove('active');
			});
			
			// Remove active from all dots
			dots.forEach(dot => {
				dot.classList.remove('active');
			});
			
			// Show current slide and dot
			slides[currentBannerIndex - 1].classList.add('active');
			dots[currentBannerIndex - 1].classList.add('active');
		}
		
		// Next/Previous controls
		function changeBanner(n) {
			// Reset auto-rotation timer
			clearInterval(bannerInterval);
			currentBannerIndex += n;
			showBanner(currentBannerIndex);
			startBannerAutoRotation();
		}
		
		// Dot controls
		function currentBanner(n) {
			// Reset auto-rotation timer
			clearInterval(bannerInterval);
			currentBannerIndex = n;
			showBanner(currentBannerIndex);
			startBannerAutoRotation();
		}
		
		// Auto-rotation function
		function autoBanner() {
			currentBannerIndex++;
			showBanner(currentBannerIndex);
		}
		
		// Start auto-rotation
		function startBannerAutoRotation() {
			bannerInterval = setInterval(autoBanner, 3000); // Change banner every 3 seconds
		}
		
		// Initialize carousel when page loads
		document.addEventListener('DOMContentLoaded', function() {
			showBanner(currentBannerIndex);
			startBannerAutoRotation();
		});
		
		// Pause on hover
		document.querySelector('.banner-carousel')?.addEventListener('mouseenter', function() {
			clearInterval(bannerInterval);
		});
		
		// Resume on mouse leave
		document.querySelector('.banner-carousel')?.addEventListener('mouseleave', function() {
			startBannerAutoRotation();
		});
		
		// Touch swipe support for mobile
		let touchStartX = 0;
		let touchEndX = 0;
		
		document.querySelector('.banner-carousel')?.addEventListener('touchstart', function(e) {
			touchStartX = e.changedTouches[0].screenX;
		});
		
		document.querySelector('.banner-carousel')?.addEventListener('touchend', function(e) {
			touchEndX = e.changedTouches[0].screenX;
			handleSwipe();
		});
		
		function handleSwipe() {
			if (touchEndX < touchStartX - 50) {
				// Swipe left - next banner
				changeBanner(1);
			}
			if (touchEndX > touchStartX + 50) {
				// Swipe right - previous banner
				changeBanner(-1);
			}
		}
		
		// Games Carousel Auto-Rotation
		let currentGameIndex = 1;
		let gameInterval;

		// Show specific game
		function showGame(n) {
			const slides = document.querySelectorAll('.game-slide');
			const dots = document.querySelectorAll('.game-dots .dot');

			if (n > slides.length) {
				currentGameIndex = 1;
			}
			if (n < 1) {
				currentGameIndex = slides.length;
			}

			// Hide all slides
			slides.forEach(slide => {
				slide.classList.remove('active');
			});

			// Remove active class from dots
			dots.forEach(dot => {
				dot.classList.remove('active');
			});

			// Show current slide
			slides[currentGameIndex - 1].classList.add('active');
			dots[currentGameIndex - 1].classList.add('active');
		}

		// Next/previous controls
		function changeGame(n) {
			clearInterval(gameInterval);
			currentGameIndex += n;
			showGame(currentGameIndex);
			startGameAutoRotation();
		}

		// Dot controls
		function currentGame(n) {
			clearInterval(gameInterval);
			currentGameIndex = n;
			showGame(currentGameIndex);
			startGameAutoRotation();
		}

		// Auto rotation
		function autoGame() {
			currentGameIndex++;
			showGame(currentGameIndex);
		}

		// Start auto-rotation
		function startGameAutoRotation() {
			gameInterval = setInterval(autoGame, 4000); // Change game every 4 seconds
		}

		// Initialize games carousel
		if (document.querySelector('.games-carousel')) {
			showGame(currentGameIndex);
			startGameAutoRotation();
		}

		// Pause on hover
		document.querySelector('.games-carousel')?.addEventListener('mouseenter', function() {
			clearInterval(gameInterval);
		});

		// Resume on mouse leave
		document.querySelector('.games-carousel')?.addEventListener('mouseleave', function() {
			startGameAutoRotation();
		});

		// Touch support for games carousel
		let gameStartX = 0;
		let gameEndX = 0;

		document.querySelector('.games-carousel')?.addEventListener('touchstart', function(e) {
			gameStartX = e.changedTouches[0].screenX;
		});

		document.querySelector('.games-carousel')?.addEventListener('touchend', function(e) {
			gameEndX = e.changedTouches[0].screenX;
			if (gameStartX - gameEndX > 50) {
				changeGame(1);
			} else if (gameStartX - gameEndX < -50) {
				changeGame(-1);
			}
		});
		
		// Winning Information Feed
		const memberSuffixes = [
			'KGG', 'LKM', 'CTR', 'NKE', 'UTD', 'FCB', 'RMA', 'PSG', 'BAY', 'JUV',
			'ARS', 'CHE', 'LIV', 'MCI', 'TOT', 'INT', 'MIL', 'NAP', 'ROM', 'ATL',
			'SEV', 'VAL', 'DOR', 'LEI', 'WHU', 'EVE', 'WOL', 'CRY', 'BUR', 'SOU'
		];
		
		const gameTypes = ['WinGo', 'K3', '5D'];
		const gameNumbers = ['1', '3', '5', '7', '9'];
		
		function getRandomMember() {
			const suffix = memberSuffixes[Math.floor(Math.random() * memberSuffixes.length)];
			return 'Mem***' + suffix;
		}
		
		function getRandomGame() {
			return gameTypes[Math.floor(Math.random() * gameTypes.length)];
		}
		
		function getRandomGameNumber() {
			return gameNumbers[Math.floor(Math.random() * gameNumbers.length)];
		}
		
		function getRandomAmount() {
			const baseAmounts = [188, 288, 388, 488, 588, 688, 788, 888, 988, 1288, 1588, 1888, 2288, 2588, 2888];
			const base = baseAmounts[Math.floor(Math.random() * baseAmounts.length)];
			const decimal = Math.floor(Math.random() * 100);
			return base + '.' + (decimal < 10 ? '0' + decimal : decimal);
		}
		
		function getUserInitial(username) {
			return username.charAt(0).toUpperCase();
		}
		
		function getRandomAvatarColor() {
			const colors = [
				'linear-gradient(135deg, #667eea 0%, #764ba2 100%)',
				'linear-gradient(135deg, #f093fb 0%, #f5576c 100%)',
				'linear-gradient(135deg, #4facfe 0%, #00f2fe 100%)',
				'linear-gradient(135deg, #43e97b 0%, #38f9d7 100%)',
				'linear-gradient(135deg, #fa709a 0%, #fee140 100%)',
				'linear-gradient(135deg, #30cfd0 0%, #330867 100%)',
				'linear-gradient(135deg, #a8edea 0%, #fed6e3 100%)',
				'linear-gradient(135deg, #ff9a9e 0%, #fecfef 100%)'
			];
			return colors[Math.floor(Math.random() * colors.length)];
		}
		
		function createActivityItem() {
			const username = getRandomMember();
			const game = getRandomGame();
			const gameNum = getRandomGameNumber();
			const amount = getRandomAmount();
			const initial = getUserInitial(username);
			const avatarColor = getRandomAvatarColor();
			
			const activityHTML = '<div class="activity-item">' +
				'<div class="activity-user">' +
					'<div class="activity-avatar" style="background: ' + avatarColor + ';">' + initial + '</div>' +
					'<div class="activity-info">' +
						'<div class="activity-username">' + username + '</div>' +
						'<div class="activity-game"><span class="activity-game-icon">' + gameNum + '</span></div>' +
					'</div>' +
				'</div>' +
				'<div class="activity-win">' +
					'<div class="activity-amount">Receive ₹' + amount + '</div>' +
					'<div class="activity-status">Winning amount</div>' +
				'</div>' +
			'</div>';
			
			const feed = document.getElementById('activityFeed');
			if (feed) {
				feed.insertAdjacentHTML('afterbegin', activityHTML);
				
				const items = feed.querySelectorAll('.activity-item');
				if (items.length > 20) {
					items[items.length - 1].remove();
				}
			}
		}
		
		function initializeActivities() {
			for (let i = 0; i < 10; i++) {
				setTimeout(() => {
					createActivityItem();
				}, i * 300);
			}
		}
		
		function startActivityFeed() {
			setInterval(() => {
				createActivityItem();
			}, Math.random() * 6000 + 4000);
		}
		
		if (document.getElementById('activityFeed')) {
			initializeActivities();
			startActivityFeed();
		}
	</script>
</body>
</html>
