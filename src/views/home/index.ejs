<!DOCTYPE html>
<html lang="en" translate="no">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
	<meta name="google" content="notranslate">
	<meta name="robots" content="noindex,nofollow">
	<link rel="icon" type="image/x-icon" href="/images/bitbug_favicon.ico">
	<title>Goa Games</title>
	<link rel="stylesheet" href="/css/main.css">
	<link rel="stylesheet" href="/css/home-modern.css">
	<style>
		@keyframes shineEffect {
			0% {
				background-position: -200% center;
			}
			100% {
				background-position: 200% center;
			}
		}
		
		.game-card-shine {
			position: relative;
			overflow: hidden;
		}
		
		.game-card-shine::before {
			content: '';
			position: absolute;
			top: 0;
			left: -100%;
			width: 100%;
			height: 100%;
			background: linear-gradient(
				90deg,
				transparent 0%,
				rgba(255, 255, 255, 0.3) 40%,
				rgba(255, 255, 255, 0.5) 50%,
				rgba(255, 255, 255, 0.3) 60%,
				transparent 100%
			);
			animation: shineEffect 3s infinite;
			pointer-events: none;
			z-index: 10;
		}
		
		.game-card-shine:hover::before {
			animation: shineEffect 1.5s infinite;
		}
	</style>
</head>
<body class="home-page">
	<!-- Logo Header -->
	<div class="diuwin-logo">
		<a href="/" style="display: inline-block; cursor: pointer;">
			<img src="/images/logo-goagames.png" alt="Goa Games" style="height: 60px; width: auto;">
		</a>
	</div>

	<!-- Banner Section -->
	<div class="banner-section">
		<div class="bonus-banner">
			<div class="bonus-content">
				<h2>DAILY CHECK-IN<br>BONUS</h2>
				<p>RECHARGE &amp; CLAIM REWARD</p>
				<a href="/checkIn" class="bonus-btn">Claim Now</a>
			</div>
		</div>
	</div>

	<!-- Welcome Message -->
	<div class="welcome-text">
		<img src="/images/audio.webp" alt="Speaker" class="speaker-icon">
		<p>Welcome to Goa Games! Enjoy exciting games, rewards, and daily bonuses.</p>
		<a href="/promotion" class="detail-btn">Detail</a>
	</div>

	<!-- Lottery Section -->
	<div class="section-header">
		<h3>Lottery</h3>
		<a href="/win" class="more-link">More ›</a>
	</div>

	<div class="games-container">
		<div class="games-grid">
			<a class="game-card game-card-shine" href="/win" style="background: linear-gradient(180deg, rgba(10, 10, 30, 0.85) 0%, rgba(20, 20, 40, 0.95) 100%);">
				<div class="game-image" style="background: linear-gradient(135deg, rgba(212, 175, 55, 0.15) 0%, rgba(184, 134, 11, 0.15) 50%, rgba(212, 175, 55, 0.15) 100%), url('/images/bdg3.png'); background-size: cover; background-position: center; background-blend-mode: overlay;">
					<img src="/images/logo-wingo.webp" alt="WinGo" style="position: relative; z-index: 2; filter: drop-shadow(0 4px 8px rgba(0,0,0,0.5));">
				</div>
				<div class="game-name" style="background: linear-gradient(135deg, rgba(0, 0, 0, 0.6) 0%, rgba(0, 0, 0, 0.8) 100%), url('/images/bdg.png'); background-size: cover; background-position: center; background-blend-mode: multiply; position: relative; z-index: 1; color: #FFD700; font-weight: 700; text-shadow: 0 2px 4px rgba(0,0,0,0.8); letter-spacing: 1px;">WinGo</div>
			</a>
			<a class="game-card game-card-shine" href="/k3" style="background: linear-gradient(180deg, rgba(10, 10, 30, 0.85) 0%, rgba(20, 20, 40, 0.95) 100%);">
				<div class="game-image" style="background: linear-gradient(135deg, rgba(212, 175, 55, 0.15) 0%, rgba(184, 134, 11, 0.15) 50%, rgba(212, 175, 55, 0.15) 100%), url('/images/bdg1.png'); background-size: cover; background-position: center; background-blend-mode: overlay;">
					<img src="/images/logo-k333.webp" alt="K3" style="position: relative; z-index: 2; filter: drop-shadow(0 4px 8px rgba(0,0,0,0.5));">
				</div>
				<div class="game-name" style="background: linear-gradient(135deg, rgba(0, 0, 0, 0.6) 0%, rgba(0, 0, 0, 0.8) 100%), url('/images/bdg.png'); background-size: cover; background-position: center; background-blend-mode: multiply; position: relative; z-index: 1; color: #FFD700; font-weight: 700; text-shadow: 0 2px 4px rgba(0,0,0,0.8); letter-spacing: 1px;">K3</div>
			</a>
			<a class="game-card game-card-shine" href="/5d" style="background: linear-gradient(180deg, rgba(10, 10, 30, 0.85) 0%, rgba(20, 20, 40, 0.95) 100%);">
				<div class="game-image" style="background: linear-gradient(135deg, rgba(212, 175, 55, 0.15) 0%, rgba(184, 134, 11, 0.15) 50%, rgba(212, 175, 55, 0.15) 100%), url('/images/bdg.png'); background-size: cover; background-position: center; background-blend-mode: overlay;">
					<img src="/images/logo-lottery.webp" alt="5D" style="position: relative; z-index: 2; filter: drop-shadow(0 4px 8px rgba(0,0,0,0.5));">
				</div>
				<div class="game-name" style="background: linear-gradient(135deg, rgba(0, 0, 0, 0.6) 0%, rgba(0, 0, 0, 0.8) 100%), url('/images/bdg.png'); background-size: cover; background-position: center; background-blend-mode: multiply; position: relative; z-index: 1; color: #FFD700; font-weight: 700; text-shadow: 0 2px 4px rgba(0,0,0,0.8); letter-spacing: 1px;">5D</div>
			</a>
		</div>
	</div>

	<!-- Super Jackpot Section -->
	<div class="section-header">
		<h3>Super Jackpot</h3>
		<a href="/win" class="more-link">›</a>
	</div>
	<div class="jackpot-section">
		<p class="jackpot-info">When you win a super jackpot, you will receive additional rewards</p>
		<p class="jackpot-amount">Maximum bonus ₹300.00</p>
	</div>

	<!-- Slots Section -->
	<div class="section-header">
		<h3>Slots</h3>
		<a href="/win" class="more-link">›</a>
	</div>
	<div class="games-container">
		<div class="games-grid">
			<a class="game-card" href="/win">
				<div class="game-image">
					<img src="/images/bg1.png" alt="Win Crash">
				</div>
				<div class="game-name">Win Crash</div>
				<div class="game-desc">Win/Crash to Win</div>
			</a>
		</div>
	</div>

	<!-- Category Icons (Moved Below Games) -->
	<div class="category-section">
		<div class="category-grid">
			<a href="/win" class="category-item">
				<div class="category-icon">
					<img src="/images/s1.png" alt="Lottery">
				</div>
				<span class="category-name">Lottery</span>
			</a>
			<a href="/win" class="category-item">
				<div class="category-icon">
					<img src="/images/s2.png" alt="Super Jackpot">
				</div>
				<span class="category-name">Jackpot</span>
			</a>
			<a href="/win" class="category-item">
				<div class="category-icon">
					<img src="/images/s3.png" alt="Slots">
				</div>
				<span class="category-name">Slots</span>
			</a>
			<a href="/k3" class="category-item">
				<div class="category-icon">
					<img src="/images/s4.png" alt="Original">
				</div>
				<span class="category-name">Original</span>
			</a>
			<a href="/5d" class="category-item">
				<div class="category-icon">
					<img src="/images/s5.png" alt="Sports">
				</div>
				<span class="category-name">Sports</span>
			</a>
		</div>
	</div>

	<!-- Support Button -->
	<a href="/keFuMenu" class="support-btn" aria-label="Customer Support">
		<img src="/images/customer-5ef38c22.png" alt="Support">
	</a>

	<!-- Bottom Navigation -->
	<div class="bottom-nav">
		<div class="nav-container">
			<a href="/home" class="nav-item active">
				<img src="/images/home.png" alt="Home">
				<span>Home</span>
			</a>
			<a href="/checkIn" class="nav-item">
				<img src="/images/checkIn.png" alt="Activity">
				<span>Activity</span>
			</a>
			<a href="/promotion" class="nav-item">
				<img src="/images/invite.webp" alt="Promotion">
				<span>Promotion</span>
			</a>
			<a href="/wallet" class="nav-item">
				<img src="/images/wallet.png" alt="Wallet">
				<span>Wallet</span>
			</a>
			<a href="/mian" class="nav-item">
				<img src="/images/my.png" alt="Account">
				<span>Account</span>
			</a>
		</div>
	</div>

	<script>
		document.addEventListener('DOMContentLoaded', function() {
			const currentPath = window.location.pathname;
			document.querySelectorAll('.nav-item').forEach(item => {
				const href = item.getAttribute('href');
				if (currentPath === href || (currentPath === '/' && href === '/home')) {
					item.classList.add('active');
				} else {
					item.classList.remove('active');
				}
			});
		});
	</script>
</body>
</html>
