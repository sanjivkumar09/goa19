	<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
	<script>
		// Cookie helper to read logged in state
		function getCookie(cname) {
			let name = cname + "=";
			let decodedCookie = decodeURIComponent(document.cookie);
			let ca = decodedCookie.split(';');
			for (let i = 0; i < ca.length; i++) {
				let c = ca[i];
				while (c.charAt(0) == ' ') {
					c = c.substring(1);
				}
				if (c.indexOf(name) == 0) {
					return c.substring(name.length, c.length);
				}
			}
			return "";
		}

		// Dynamically render header buttons or profile avatar
		function updateHeaderStatus() {
			const token = getCookie('token');
			const auth = getCookie('auth');
			const headerContainer = $('#header-user-status');
			
			if (token && auth) {
				// User is logged in: show profile avatar
				headerContainer.html(`
					<div class="header-profile-icon-wrapper" onclick="location.href='/mian'">
						<i class="fa fa-user" style="font-size: 18px; color: #ff4d4f;"></i>
					</div>
				`);
			} else {
				// User is not logged in: show login & register
				headerContainer.html(`
					<a href="/login" class="header-btn-login">Log in</a>
					<a href="/register" class="header-btn-register">Register</a>
				`);
			}
		}

		$(document).ready(function() {
			updateHeaderStatus();
			
			// Highlight bottom nav active item based on current page
			const currentPath = window.location.pathname;
			document.querySelectorAll('.nav-item').forEach(item => {
				const href = item.getAttribute('href');
				if (currentPath === href || (currentPath === '/' && href === '/home')) {
					item.classList.add('active');
				} else {
					item.classList.remove('active');
				}
			});
		});
		
		// Category switcher filtering
		$('.category-tab-item').click(function() {
			$('.category-tab-item').removeClass('active');
			$(this).addClass('active');
			
			const filter = $(this).data('filter');
			
			if (filter === 'all') {
				$('#sec-lottery').fadeIn(200);
				$('#sec-popular').fadeIn(200);
				$('#sec-winners').fadeIn(200);
			} else if (filter === 'lottery') {
				$('#sec-lottery').fadeIn(200);
				$('#sec-popular').hide();
				$('#sec-winners').hide();
			} else if (filter === 'casino' || filter === 'slots') {
				$('#sec-lottery').hide();
				$('#sec-popular').fadeIn(200);
				$('#sec-winners').hide();
			}
		});

		// Banner Carousel Auto-Rotation
		let currentBannerIndex = 1;
		let bannerInterval;
		
		function showBanner(n) {
			const slides = document.querySelectorAll('.banner-slide');
			const dots = document.querySelectorAll('.dot');
			
			if (n > slides.length) { currentBannerIndex = 1; }
			if (n < 1) { currentBannerIndex = slides.length; }
			
			slides.forEach(slide => slide.classList.remove('active'));
			dots.forEach(dot => dot.classList.remove('active'));
			
			if(slides[currentBannerIndex - 1]) {
				slides[currentBannerIndex - 1].classList.add('active');
			}
			if(dots[currentBannerIndex - 1]) {
				dots[currentBannerIndex - 1].classList.add('active');
			}
		}
		
		function changeBanner(n) {
			clearInterval(bannerInterval);
			currentBannerIndex += n;
			showBanner(currentBannerIndex);
			startBannerAutoRotation();
		}
		
		function currentBanner(n) {
			clearInterval(bannerInterval);
			currentBannerIndex = n;
			showBanner(currentBannerIndex);
			startBannerAutoRotation();
		}
		
		function autoBanner() {
			currentBannerIndex++;
			showBanner(currentBannerIndex);
		}
		
		function startBannerAutoRotation() {
			bannerInterval = setInterval(autoBanner, 3000);
		}
		
		showBanner(currentBannerIndex);
		startBannerAutoRotation();
		
		// Winning Information Feed simulation
		const memberSuffixes = ['KGG', 'LKM', 'CTR', 'NKE', 'UTD', 'FCB', 'RMA', 'PSG', 'BAY', 'JUV'];
		const gameTypes = ['WinGo', 'K3', '5D'];
		const gameNumbers = ['1', '3', '5', '7', '9'];
		
		function getRandomMember() {
			return 'Mem***' + memberSuffixes[Math.floor(Math.random() * memberSuffixes.length)];
		}
		
		function getRandomGame() {
			return gameTypes[Math.floor(Math.random() * gameTypes.length)];
		}
		
		function getRandomGameNumber() {
			return gameNumbers[Math.floor(Math.random() * gameNumbers.length)];
		}
		
		function getRandomAmount() {
			const baseAmounts = [188, 288, 388, 488, 588, 688, 788, 888, 988, 1288, 1588, 1888];
			const base = baseAmounts[Math.floor(Math.random() * baseAmounts.length)];
			const decimal = Math.floor(Math.random() * 100);
			return base + '.' + (decimal < 10 ? '0' + decimal : decimal);
		}
		
		function getUserInitial(username) {
			return username.replace('Mem***', '').charAt(0).toUpperCase();
		}
		
		function getRandomAvatarColor() {
			const colors = [
				'linear-gradient(135deg, #ff7165 0%, #ff4c4c 100%)',
				'linear-gradient(135deg, #667eea 0%, #764ba2 100%)',
				'linear-gradient(135deg, #f093fb 0%, #f5576c 100%)',
				'linear-gradient(135deg, #4facfe 0%, #00f2fe 100%)',
				'linear-gradient(135deg, #43e97b 0%, #38f9d7 100%)',
				'linear-gradient(135deg, #fa709a 0%, #fee140 100%)'
			];
			return colors[Math.floor(Math.random() * colors.length)];
		}
		
		function createActivityItem() {
			const username = getRandomMember();
			const game = getRandomGame();
			const gameNum = getRandomGameNumber();
			const amount = getRandomAmount();
			const initial = getUserInitial(username);
			const avatarColor = getRandomAvatarColor();
			
			const activityHTML = `
				<div class="activity-item">
					<div class="activity-user">
						<div class="activity-avatar" style="background: ${avatarColor};">${initial}</div>
						<div>
							<div class="activity-username">${username}</div>
							<div class="activity-game-badge">${game} ${gameNum}Min</div>
						</div>
					</div>
					<div class="activity-win">
						<div class="activity-amount">₹${amount}</div>
						<div class="activity-status">Winning amount</div>
					</div>
				</div>
			`;
			
			const feed = document.getElementById('activityFeed');
			if (feed) {
				feed.insertAdjacentHTML('afterbegin', activityHTML);
				const items = feed.querySelectorAll('.activity-item');
				if (items.length > 6) {
					items[items.length - 1].remove();
				}
			}
		}
		
		function initializeActivities() {
			for (let i = 0; i < 5; i++) {
				setTimeout(createActivityItem, i * 400);
			}
		}
		
		function startActivityFeed() {
			setInterval(createActivityItem, Math.random() * 3000 + 2000);
		}
		
		if (document.getElementById('activityFeed')) {
			initializeActivities();
			startActivityFeed();
		}

		// Adapt root font-size based on screen width
		let getWBody = $('#app').width();
		$('html').css('font-size', `${getWBody / 10}px`);
		$(window).resize(() => {
			let getWBody = $('#app').width();
			$('html').css('font-size', `${getWBody / 10}px`);
		});
	</script>
