<!DOCTYPE html>
<html lang="en" translate="no">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
	<meta name="google" content="notranslate">
	<meta name="robots" content="noindex,nofollow">
	<link rel="icon" type="image/x-icon" href="/images/bitbug_favicon.ico">
	<title>DiuWin Games - Lobby</title>
	<link rel="stylesheet" href="/css/main.css">
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.css" />
	<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800&family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
	<style>
		/* Reset and Base Styles */
		html, body {
			height: 100%;
			width: 100%;
			padding: 0;
			margin: 0;
			font-family: 'Outfit', sans-serif;
			background-color: #071224;
			color: #ffffff;
		}

		body {
			background-image: linear-gradient(rgba(7, 18, 36, 0.94), rgba(15, 41, 74, 0.94)), url('/images/dark_blue_damask.jpg');
			background-size: cover, 300px 300px;
			background-repeat: no-repeat, repeat;
			background-attachment: fixed;
			display: flex;
			justify-content: center;
			align-items: flex-start;
			overflow-y: auto;
		}

		#app {
			width: 100%;
			max-width: 480px;
			min-height: 100vh;
			display: flex;
			flex-direction: column;
			position: relative;
			background: transparent;
			box-shadow: 0 0 30px rgba(0, 0, 0, 0.6);
			box-sizing: border-box;
			padding-bottom: 75px; /* Leave space for bottom nav */
		}

		/* Header Section */
		.header-container {
			display: flex;
			justify-content: space-between;
			align-items: center;
			padding: 12px 20px;
			background: rgba(10, 25, 47, 0.6);
			backdrop-filter: blur(10px);
			border-bottom: 1.5px solid rgba(212, 175, 55, 0.2);
			position: sticky;
			top: 0;
			z-index: 1000;
		}

		.raja-logo-container {
			display: flex;
			align-items: center;
			gap: 8px;
			cursor: pointer;
		}

		.diuwin-logo-img {
			width: 32px;
			height: 32px;
			object-fit: cover;
			object-position: 50% 12%;
			border-radius: 50%;
			border: 1.5px solid rgba(229, 192, 96, 0.4);
			box-shadow: 0 0 10px rgba(229, 192, 96, 0.3);
		}

		.logo-text-wrapper {
			display: flex;
			flex-direction: column;
		}

		.raja-logo-title {
			font-family: 'Outfit', sans-serif;
			font-size: 19px;
			font-weight: 800;
			letter-spacing: 0.5px;
			background: linear-gradient(180deg, #FFF 0%, #FFD700 100%);
			-webkit-background-clip: text;
			-webkit-text-fill-color: transparent;
			line-height: 1.1;
			text-transform: uppercase;
		}

		.raja-logo-sub {
			font-family: 'Outfit', sans-serif;
			font-size: 9px;
			font-weight: 700;
			letter-spacing: 2px;
			color: #D4AF37;
			text-transform: uppercase;
		}

		.header-actions {
			display: flex;
			gap: 12px;
			align-items: center;
		}

		.lang-dropdown {
			display: flex;
			align-items: center;
			justify-content: center;
			background: rgba(255, 255, 255, 0.08);
			border: 1px solid rgba(255, 255, 255, 0.15);
			border-radius: 8px;
			width: 38px;
			height: 32px;
			cursor: pointer;
			transition: all 0.3s ease;
		}

		.lang-dropdown:hover {
			border-color: #E5C060;
			background: rgba(229, 192, 96, 0.1);
		}

		.header-profile-icon-wrapper {
			width: 32px;
			height: 32px;
			display: flex;
			align-items: center;
			justify-content: center;
			cursor: pointer;
			transition: all 0.3s ease;
		}

		.header-profile-icon-wrapper:hover {
			transform: scale(1.1);
		}

		/* Guest Actions Section */
		.guest-actions-container {
			display: flex;
			gap: 15px;
			padding: 15px 20px;
		}

		.guest-btn {
			flex: 1;
			padding: 12px;
			border-radius: 12px;
			font-size: 15px;
			font-weight: 700;
			text-align: center;
			text-decoration: none;
			transition: all 0.3s ease;
		}

		.guest-btn-login {
			background: linear-gradient(180deg, #E5C060 0%, #B8860B 100%);
			color: #071224;
			border: none;
			box-shadow: 0 4px 15px rgba(184, 134, 11, 0.4);
		}

		.guest-btn-login:hover {
			transform: translateY(-2px);
			box-shadow: 0 6px 20px rgba(184, 134, 11, 0.6);
		}

		.guest-btn-register {
			background: rgba(10, 25, 47, 0.6);
			color: #E5C060;
			border: 1.5px solid #E5C060;
		}

		.guest-btn-register:hover {
			background: rgba(229, 192, 96, 0.1);
			transform: translateY(-2px);
		}

		/* Banner section */
		.banner-section {
			padding: 0 20px 20px 20px;
		}

		.banner-carousel {
			position: relative;
			width: 100%;
			overflow: hidden;
			border-radius: 16px;
			box-shadow: 0 8px 25px rgba(0, 0, 0, 0.5);
			border: 1px solid rgba(255, 255, 255, 0.05);
		}
		
		.banner-slide {
			display: none;
			width: 100%;
			animation: fadeIn 0.6s ease-in-out;
		}
		
		.banner-slide.active {
			display: block;
		}
		
		.banner-slide img {
			width: 100%;
			height: auto;
			display: block;
			object-fit: cover;
			max-height: 200px;
		}
		
		@keyframes fadeIn {
			from { opacity: 0; transform: scale(1.03); }
			to { opacity: 1; transform: scale(1); }
		}
		
		.banner-dots {
			position: absolute;
			bottom: 12px;
			left: 50%;
			transform: translateX(-50%);
			display: flex;
			gap: 6px;
			z-index: 10;
		}
		
		.dot {
			width: 8px;
			height: 8px;
			border-radius: 50%;
			background: rgba(255, 255, 255, 0.4);
			cursor: pointer;
			transition: all 0.3s ease;
		}
		
		.dot.active {
			background: #FFD700;
			transform: scale(1.2);
			box-shadow: 0 0 6px #FFD700;
		}

		/* Welcome announcement bar */
		.welcome-text {
			display: flex;
			align-items: center;
			background: rgba(10, 25, 47, 0.5);
			margin: 15px 20px;
			padding: 10px 16px;
			border-radius: 12px;
			border: 1px solid rgba(255, 255, 255, 0.05);
			gap: 12px;
		}

		.speaker-icon {
			width: 20px;
			height: 20px;
			object-fit: contain;
			filter: drop-shadow(0 0 4px #FFD700);
		}

		.welcome-text p {
			flex: 1;
			margin: 0;
			font-size: 12.5px;
			color: rgba(255, 255, 255, 0.8);
			line-height: 1.4;
			white-space: nowrap;
			overflow: hidden;
			text-overflow: ellipsis;
		}

		.detail-btn {
			background: linear-gradient(180deg, #1d3d63 0%, #0f294a 100%);
			border: 1px solid #D4AF37;
			color: #FFD700;
			padding: 4px 10px;
			border-radius: 10px;
			font-size: 11px;
			font-weight: 700;
			text-decoration: none;
			transition: all 0.3s ease;
		}

		.detail-btn:hover {
			box-shadow: 0 0 8px rgba(212, 175, 55, 0.4);
		}

		/* Feature Promo Banners */
		.feature-promo-container {
			display: flex;
			gap: 15px;
			padding: 0 20px 20px 20px;
		}

		.promo-card {
			flex: 1;
			background: linear-gradient(135deg, rgba(17, 34, 64, 0.8) 0%, rgba(10, 25, 47, 0.8) 100%);
			border: 1px solid rgba(229, 192, 96, 0.2);
			border-radius: 16px;
			padding: 12px 15px;
			display: flex;
			align-items: center;
			justify-content: space-between;
			text-decoration: none;
			box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
			transition: all 0.3s ease;
			overflow: hidden;
			position: relative;
		}

		.promo-card:hover {
			transform: translateY(-3px);
			border-color: #E5C060;
			box-shadow: 0 6px 20px rgba(229, 192, 96, 0.25);
		}

		.promo-card-info {
			display: flex;
			flex-direction: column;
			z-index: 2;
		}

		.promo-card-title {
			font-size: 12px;
			font-weight: 800;
			color: #ffffff;
			letter-spacing: 0.5px;
			margin: 0 0 2px 0;
			text-shadow: 0 2px 4px rgba(0, 0, 0, 0.5);
		}

		.promo-card-desc {
			font-size: 9px;
			color: #E5C060;
			font-weight: 700;
			text-transform: uppercase;
		}

		.promo-card-img {
			width: 44px;
			height: 44px;
			object-fit: contain;
			z-index: 2;
			transition: transform 0.5s ease;
		}

		.promo-card:hover .promo-card-img {
			transform: scale(1.1) rotate(5deg);
		}

		/* Category Switch Tabs */
		.category-nav-bar {
			display: flex;
			gap: 8px;
			padding: 0 20px 25px 20px;
			overflow-x: auto;
		}

		.category-nav-bar::-webkit-scrollbar {
			display: none;
		}

		.category-tab-item {
			flex-shrink: 0;
			display: flex;
			align-items: center;
			gap: 8px;
			padding: 8px 16px;
			border-radius: 20px;
			background: rgba(255, 255, 255, 0.04);
			border: 1px solid rgba(255, 255, 255, 0.08);
			cursor: pointer;
			transition: all 0.3s ease;
			color: rgba(255, 255, 255, 0.6);
		}

		.category-tab-item img {
			width: 22px;
			height: 22px;
			object-fit: contain;
			transition: all 0.3s ease;
		}

		.category-tab-item span {
			font-size: 13.5px;
			font-weight: 600;
		}

		.category-tab-item.active {
			background: linear-gradient(135deg, #1d3d63 0%, #0f294a 100%);
			border-color: #D4AF37;
			color: #FFD700;
			box-shadow: 0 4px 10px rgba(212, 175, 55, 0.25);
		}

		.category-tab-item.active img {
			filter: drop-shadow(0 0 5px rgba(212, 175, 55, 0.6));
		}

		/* Sections Base */
		.section-container {
			display: flex;
			flex-direction: column;
			margin-bottom: 30px;
			padding: 0 20px;
		}

		.section-header {
			display: flex;
			justify-content: space-between;
			align-items: center;
			margin-bottom: 15px;
		}

		.section-title-badge {
			display: flex;
			align-items: center;
			gap: 8px;
			background: rgba(10, 25, 47, 0.7);
			border: 1px solid rgba(212, 175, 55, 0.3);
			padding: 6px 14px;
			border-radius: 15px;
		}

		.section-title-badge i {
			color: #FFD700;
			font-size: 14px;
		}

		.section-title-badge h3 {
			margin: 0;
			font-size: 13.5px;
			font-weight: 700;
			letter-spacing: 0.5px;
			color: #ffffff;
			text-transform: uppercase;
		}

		.more-link {
			font-size: 13px;
			color: #FFD700;
			text-decoration: none;
			font-weight: 600;
		}

		.more-link:hover {
			text-decoration: underline;
		}

		/* Game Cards Styling */
		.games-grid {
			display: grid;
			grid-template-columns: repeat(3, 1fr);
			gap: 12px;
		}

		.game-card {
			display: flex;
			flex-direction: column;
			background: linear-gradient(180deg, #112240 0%, #0a192f 100%);
			border: 1px solid rgba(212, 175, 55, 0.15);
			border-radius: 16px;
			overflow: hidden;
			text-decoration: none;
			transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
			position: relative;
		}

		.game-card:hover {
			transform: translateY(-5px);
			border-color: #D4AF37;
			box-shadow: 0 8px 20px rgba(212, 175, 55, 0.25);
		}

		/* Highlight Shine Effect */
		.game-card::after {
			content: '';
			position: absolute;
			top: -50%;
			left: -60%;
			width: 30%;
			height: 200%;
			background: rgba(255, 255, 255, 0.13);
			transform: rotate(30deg);
			transition: all 0.5s ease;
			pointer-events: none;
		}

		.game-card:hover::after {
			left: 130%;
			transition: all 0.7s ease;
		}

		.game-card-img-wrapper {
			position: relative;
			width: 100%;
			aspect-ratio: 1;
			display: flex;
			align-items: center;
			justify-content: center;
			overflow: hidden;
		}

		/* Wingo Graphic details */
		.wingo-card-bg {
			background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
			width: 100%;
			height: 100%;
			display: flex;
			flex-direction: column;
			align-items: center;
			justify-content: center;
			position: relative;
		}

		.lottery-ball-circle {
			width: 48px;
			height: 48px;
			border-radius: 50%;
			background: radial-gradient(circle at 30% 30%, #ff5e62, #ff9966);
			box-shadow: 0 4px 10px rgba(0,0,0,0.3);
			display: flex;
			align-items: center;
			justify-content: center;
			font-size: 20px;
			font-weight: 800;
			color: white;
			border: 2px solid white;
		}

		.lottery-ball-circle-alt {
			position: absolute;
			width: 28px;
			height: 28px;
			border-radius: 50%;
			background: radial-gradient(circle at 30% 30%, #4facfe, #00f2fe);
			display: flex;
			align-items: center;
			justify-content: center;
			font-size: 12px;
			font-weight: 800;
			color: white;
			border: 1px solid white;
			bottom: 15px;
			right: 15px;
		}

		.gold-crown-overlay {
			position: absolute;
			top: 10px;
			left: 10px;
			color: #FFD700;
			font-size: 16px;
			filter: drop-shadow(0 2px 4px rgba(0,0,0,0.5));
			animation: bounce 2s infinite alternate;
		}

		@keyframes bounce {
			0% { transform: translateY(0); }
			100% { transform: translateY(-4px); }
		}

		/* K3 Dice graphic details */
		.k3-card-bg {
			background: linear-gradient(135deg, #0f2027 0%, #203a43 100%);
			width: 100%;
			height: 100%;
			display: flex;
			align-items: center;
			justify-content: center;
			position: relative;
		}

		.k3-dice-wrapper {
			display: flex;
			gap: 4px;
		}

		.k3-dice {
			width: 24px;
			height: 24px;
			background: #ffffff;
			border-radius: 4px;
			box-shadow: inset 0 0 5px rgba(0,0,0,0.2), 0 3px 6px rgba(0,0,0,0.3);
			display: flex;
			align-items: center;
			justify-content: center;
			position: relative;
		}

		.dice-dot-center {
			width: 6px;
			height: 6px;
			background: red;
			border-radius: 50%;
		}

		.dice-dot-multi {
			display: grid;
			grid-template-columns: repeat(2, 1fr);
			gap: 4px;
			padding: 3px;
			width: 100%;
			height: 100%;
			box-sizing: border-box;
		}

		.dice-dot-multi::before,
		.dice-dot-multi::after {
			content: '';
			background: #333;
			border-radius: 50%;
		}

		.gold-coins-overlay {
			position: absolute;
			bottom: 8px;
			left: 8px;
			color: #FFD700;
			font-size: 12px;
			display: flex;
			gap: 2px;
		}

		/* 5D Spheres details */
		.five-d-card-bg {
			background: linear-gradient(135deg, #134e5e 0%, #71b280 100%);
			width: 100%;
			height: 100%;
			display: flex;
			align-items: center;
			justify-content: center;
			position: relative;
		}

		.fived-sphere {
			width: 44px;
			height: 44px;
			border-radius: 50%;
			background: radial-gradient(circle at 30% 30%, #a8ff78, #78ffd6);
			border: 2px solid white;
			display: flex;
			align-items: center;
			justify-content: center;
			font-weight: 800;
			color: #134e5e;
			font-size: 18px;
			box-shadow: 0 4px 8px rgba(0,0,0,0.3);
		}

		/* Standard game images styling */
		.game-image-element {
			width: 100%;
			height: 100%;
			object-fit: cover;
		}

		.game-card-name-wrapper {
			padding: 8px 10px;
			text-align: center;
			background: rgba(10, 25, 47, 0.9);
			border-top: 1px solid rgba(255, 255, 255, 0.05);
		}

		.game-card-title {
			font-size: 12px;
			font-weight: 700;
			color: #FFD700;
			margin: 0 0 2px 0;
			letter-spacing: 0.5px;
		}

		.game-card-desc {
			font-size: 10px;
			color: rgba(255, 255, 255, 0.5);
			margin: 0;
		}

		/* Live Activity / Winners Feed */
		.live-activity-section {
			background: rgba(10, 25, 47, 0.5);
			border: 1px solid rgba(212, 175, 55, 0.15);
			border-radius: 16px;
			padding: 16px;
			margin: 0 20px 20px 20px;
			box-shadow: 0 4px 20px rgba(0,0,0,0.3);
		}

		.activity-header {
			display: flex;
			align-items: center;
			gap: 8px;
			margin-bottom: 15px;
			padding-bottom: 8px;
			border-bottom: 1px solid rgba(255, 215, 0, 0.15);
		}

		.activity-header h4 {
			color: #FFD700;
			font-size: 14px;
			font-weight: 700;
			margin: 0;
			text-transform: uppercase;
		}

		.activity-feed {
			max-height: 260px;
			overflow-y: hidden;
			display: flex;
			flex-direction: column;
			gap: 10px;
		}

		.activity-item {
			display: flex;
			align-items: center;
			justify-content: space-between;
			padding: 10px 12px;
			background: rgba(255, 255, 255, 0.03);
			border-radius: 10px;
			border: 1px solid rgba(255, 255, 255, 0.05);
			animation: slideInWinner 0.5s ease-out;
		}

		@keyframes slideInWinner {
			from { opacity: 0; transform: translateY(-10px); }
			to { opacity: 1; transform: translateY(0); }
		}

		.activity-user {
			display: flex;
			align-items: center;
			gap: 10px;
		}

		.activity-avatar {
			width: 32px;
			height: 32px;
			border-radius: 50%;
			display: flex;
			align-items: center;
			justify-content: center;
			color: white;
			font-weight: 700;
			font-size: 13px;
			border: 1px solid rgba(255, 255, 255, 0.2);
		}

		.activity-username {
			color: #ffffff;
			font-size: 12.5px;
			font-weight: 600;
		}

		.activity-game-badge {
			display: inline-block;
			background: rgba(255, 215, 0, 0.15);
			color: #FFD700;
			padding: 1px 6px;
			border-radius: 8px;
			font-size: 10px;
			font-weight: 700;
			margin-top: 2px;
		}

		.activity-win {
			text-align: right;
		}

		.activity-amount {
			color: #FFD700;
			font-weight: 700;
			font-size: 13px;
		}

		.activity-status {
			color: rgba(255, 255, 255, 0.4);
			font-size: 10px;
			margin-top: 1px;
		}

		/* Sticky Support Button */
		.support-btn {
			position: fixed;
			bottom: 85px;
			right: 20px;
			width: 48px;
			height: 48px;
			border-radius: 50%;
			background: linear-gradient(135deg, #FFD700 0%, #D4AF37 100%);
			border: 2px solid #ffffff;
			display: flex;
			align-items: center;
			justify-content: center;
			box-shadow: 0 4px 15px rgba(255, 215, 0, 0.4);
			cursor: pointer;
			z-index: 999;
			transition: all 0.3s ease;
		}

		.support-btn:hover {
			transform: scale(1.1) rotate(5deg);
		}

		.support-btn img {
			width: 24px;
			height: 24px;
			object-fit: contain;
			filter: drop-shadow(0 1px 2px rgba(0,0,0,0.3));
		}

		/* Bottom Navigation Bar */
		.bottom-nav {
			position: fixed;
			bottom: 0;
			left: 50%;
			transform: translateX(-50%);
			width: 100%;
			max-width: 480px;
			background: #0a192f;
			border-top: 1.5px solid #D4AF37;
			box-shadow: 0 -4px 20px rgba(0,0,0,0.5);
			z-index: 1000;
		}

		.nav-container {
			display: flex;
			justify-content: space-around;
