<!DOCTYPE html>
<html lang="en">
<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <link rel="icon" type="image/x-icon" href="/images/bitbug_favicon.ico">
    <title>Wallet - BDG Win</title>
    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="/css/pages-global.css">
    <style>
        body {
            background: #2a2a2a !important;
            margin: 0;
            padding: 0;
        }
        .wallet-header {
            background: linear-gradient(135deg, #D4AF37 0%, #C5A028 100%);
            padding: 30px 20px;
            text-align: center;
            box-shadow: 0 6px 25px rgba(212, 175, 55, 0.5);
        }
        .wallet-balance {
            font-size: 32px;
            font-weight: 900;
            color: #000000;
            text-shadow: 0 2px 4px rgba(255, 255, 255, 0.3);
        }
        .wallet-label {
            color: #000000;
            font-weight: 600;
            margin-top: 8px;
        }
    </style>
</head>
<body>
    <!-- Wallet Header -->
    <div class="wallet-header">
        <div class="wallet-icon">
            <img src="/images/wallet.png" alt="Wallet" style="width: 64px; height: 64px;">
        </div>
        <div class="wallet-balance" id="totalBalance">₹0.00</div>
        <div class="wallet-label">Total balance</div>
    </div>

    <!-- Main Content -->
    <div class="card" style="margin-top: -20px; border-radius: 24px 24px 0 0;">
        <!-- Balance Info -->
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 20px;">
            <div style="text-align: center; padding: 16px; background: var(--bg-gray); border-radius: 12px;">
                <div style="font-size: 24px; font-weight: bold; color: var(--primary-green);" id="mainWallet">₹0.00</div>
                <div style="font-size: 14px; color: var(--text-secondary); margin-top: 4px;">Main wallet</div>
            </div>
            <div style="text-align: center; padding: 16px; background: var(--bg-gray); border-radius: 12px;">
                <div style="font-size: 24px; font-weight: bold; color: var(--primary-green);" id="thirdPartyWallet">₹0.00</div>
                <div style="font-size: 14px; color: var(--text-secondary); margin-top: 4px;">3rd party wallet</div>
            </div>
        </div>

        <!-- Transfer Button -->
        <button class="btn-secondary" style="width: 100%; margin-bottom: 20px;" onclick="location.href='/wallet/transfer'">
            Main wallet transfer
        </button>

        <!-- Action Buttons -->
        <div class="wallet-actions">
            <a href="/wallet/recharge" class="wallet-action-btn">
                <img src="/images/recharge.png" alt="Deposit">
                <div class="label">Deposit</div>
            </a>
            <a href="/wallet/withdrawal" class="wallet-action-btn">
                <img src="/images/withdraw.png" alt="Withdraw">
                <div class="label">Withdraw</div>
            </a>
        </div>

        <!-- History Buttons -->
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 16px;">
            <a href="/wallet/rechargerecord" class="wallet-action-btn" style="padding: 12px;">
                <img src="/images/rechargeHistory.png" alt="Deposit History" style="width: 32px; height: 32px;">
                <div class="label" style="font-size: 14px;">Deposit history</div>
            </a>
            <a href="/wallet/withdrawalrecord" class="wallet-action-btn" style="padding: 12px;">
                <img src="/images/withdrawHistory.png" alt="Withdraw History" style="width: 32px; height: 32px;">
                <div class="label" style="font-size: 14px;">Withdrawal history</div>
            </a>
        </div>
    </div>

    <!-- Support Button -->
    <a href="/keFuMenu" class="support-btn">
        <img src="/images/customer-5ef38c22.png" alt="Support">
    </a>

    <!-- Bottom Navigation -->
    <%- include('../nav') -%>

    <!-- Scripts -->
	    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script>
        // Fetch wallet data
        function loadWalletData() {
            $.ajax({
                type: "GET",
                url: "/api/webapi/GetUserInfo",
                dataType: "json",
                success: function (response) {
                    if (response && response.data) {
                    let user = response.data;
                        let balance = parseFloat(user.money_user || 0).toFixed(2);
                        
                        // Update balances
                        $('#totalBalance').text("₹" + balance);
                        $('#mainWallet').text("₹" + balance);
                        $('#thirdPartyWallet').text("₹0.00"); // Can be updated based on your logic
                    }
                },
                error: function() {
                    console.error("Failed to load wallet data");
                }
            });
        }

        // Load data on page load
        $(document).ready(function() {
            loadWalletData();
        });
    </script>	
</body>
</html>
	