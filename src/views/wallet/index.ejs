<!DOCTYPE html>
<html lang="en">
<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <link rel="icon" type="image/x-icon" href="/images/bitbug_favicon.ico">
    <title>Wallet - DiuWin</title>
    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="/css/pages-global.css">
    <style>
        body {
            margin: 0;
            padding: 0;
            background-color: #7b8494;
        }
        .wallet-app-wrap {
            max-width: 480px;
            margin: 0 auto;
            min-height: 100vh;
            background: #f4f5f8;
            padding-bottom: 80px;
            box-shadow: 0 0 30px rgba(0, 0, 0, 0.15);
            position: relative;
        }
        .wallet-header {
            background: linear-gradient(180deg, #ff5e52 0%, #ff7b71 100%);
            padding: 30px 20px;
            text-align: center;
            box-shadow: 0 4px 15px rgba(255, 94, 82, 0.3);
            border-radius: 0 0 20px 20px;
            color: #ffffff;
        }
        .wallet-balance {
            font-size: 32px;
            font-weight: 900;
            color: #ffffff;
            text-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
        }
        .wallet-label {
            color: rgba(255, 255, 255, 0.9);
            font-weight: 600;
            font-size: 13.5px;
            margin-top: 6px;
        }
        .wallet-card-container {
            background: #ffffff;
            margin: -16px 14px 16px 14px;
            padding: 20px;
            border-radius: 16px;
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.05);
            border: 1px solid #ebeef5;
        }
        .wallet-actions {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
            margin-top: 16px;
        }
        .wallet-action-btn {
            background: #f9fafb;
            border: 1px solid #ebeef5;
            border-radius: 14px;
            padding: 14px;
            display: flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
            color: #1e2329;
            font-weight: 700;
            font-size: 14px;
            transition: all 0.2s ease;
        }
        .wallet-action-btn:hover {
            border-color: #ff7875;
            background: #fff5f5;
        }
        .wallet-action-btn img {
            width: 36px;
            height: 36px;
            object-fit: contain;
        }
    </style>
</head>
<body>
    <div class="wallet-app-wrap">
        <!-- Wallet Header -->
        <div class="wallet-header">
            <div class="wallet-icon">
                <img src="/images/wallet.png" alt="Wallet" style="width: 56px; height: 56px; filter: drop-shadow(0 2px 6px rgba(0,0,0,0.2));">
            </div>
            <div class="wallet-balance" id="totalBalance">₹0.00</div>
            <div class="wallet-label">Total balance</div>
        </div>

        <!-- Main Content -->
        <div class="wallet-card-container">
            <!-- Balance Info -->
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 16px;">
                <div style="text-align: center; padding: 14px; background: #f9fafb; border-radius: 12px; border: 1px solid #ebeef5;">
                    <div style="font-size: 20px; font-weight: 800; color: #ff4d4f;" id="mainWallet">₹0.00</div>
                    <div style="font-size: 12.5px; color: #7e8a9b; margin-top: 4px; font-weight: 600;">Main wallet</div>
                </div>
                <div style="text-align: center; padding: 14px; background: #f9fafb; border-radius: 12px; border: 1px solid #ebeef5;">
                    <div style="font-size: 20px; font-weight: 800; color: #5d6472;" id="thirdPartyWallet">₹0.00</div>
                    <div style="font-size: 12.5px; color: #7e8a9b; margin-top: 4px; font-weight: 600;">3rd party wallet</div>
                </div>
            </div>

            <!-- Transfer Button -->
            <button class="btn-secondary" style="width: 100%; margin-bottom: 16px; border-radius: 20px; font-weight: 700; padding: 10px;" onclick="location.href='/wallet/transfer'">
                Main wallet transfer
            </button>

            <!-- Action Buttons -->
            <div class="wallet-actions">
                <a href="/wallet/recharge" class="wallet-action-btn">
                    <img src="/images/recharge.png" alt="Deposit">
                    <div>Deposit</div>
                </a>
                <a href="/wallet/withdrawal" class="wallet-action-btn">
                    <img src="/images/withdraw.png" alt="Withdraw">
                    <div>Withdraw</div>
                </a>
            </div>

            <!-- History Buttons -->
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 12px;">
                <a href="/wallet/rechargerecord" class="wallet-action-btn" style="padding: 12px;">
                    <img src="/images/rechargeHistory.png" alt="Deposit History" style="width: 28px; height: 28px;">
                    <div style="font-size: 13px;">Deposit history</div>
                </a>
                <a href="/wallet/withdrawalrecord" class="wallet-action-btn" style="padding: 12px;">
                    <img src="/images/withdrawHistory.png" alt="Withdraw History" style="width: 28px; height: 28px;">
                    <div style="font-size: 13px;">Withdraw history</div>
                </a>
            </div>
        </div>

        <!-- Support Button -->
        <a href="/keFuMenu" class="support-btn">
            <img src="/images/customer-5ef38c22.png" alt="Support">
        </a>

        <!-- Bottom Navigation -->
        <%- include('../nav') -%>
    </div>

    <!-- Scripts -->
	    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script>
        // Fetch wallet data
        function loadWalletData() {
            $.ajax({
                type: "GET",
                url: "/api/webapi/GetUserInfo",
                dataType: "json",
                success: function (response) {
                    if (response && response.data) {
                    let user = response.data;
                        let balance = parseFloat(user.money_user || 0).toFixed(2);
                        
                        // Update balances
                        $('#totalBalance').text("₹" + balance);
                        $('#mainWallet').text("₹" + balance);
                        $('#thirdPartyWallet').text("₹0.00"); // Can be updated based on your logic
                    }
                },
                error: function() {
                    console.error("Failed to load wallet data");
                }
            });
        }

        // Load data on page load
        $(document).ready(function() {
            loadWalletData();
        });
    </script>	
</body>
</html>
	