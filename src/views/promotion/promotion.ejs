<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <link rel="icon" type="image/x-icon" href="/images/bitbug_favicon.ico">
    <title>Promotion - BDG Win</title>
    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="/css/pages-global.css">
    <style>
        body {
            background: #2a2a2a !important;
            margin: 0;
            padding: 0;
        }
        
        .promo-header {
            background: linear-gradient(135deg, #D4AF37 0%, #C5A028 100%);
            padding: 40px 20px;
            color: #000000;
            text-align: center;
            border-radius: 0 0 24px 24px;
            box-shadow: 0 6px 25px rgba(212, 175, 55, 0.5);
        }
        
        .promo-header h1 {
            font-size: 24px;
            margin: 0 0 8px 0;
            color: #000000;
            font-weight: 900;
            text-shadow: 0 1px 2px rgba(255, 255, 255, 0.3);
        }
        
        .promo-header p {
            font-size: 14px;
            opacity: 0.9;
            margin: 0;
            color: #000000;
            font-weight: 600;
        }
        
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 12px;
            padding: 20px;
            margin-top: -30px;
        }
        
        .stat-card {
            background: rgba(30, 30, 46, 0.8);
            padding: 20px;
            border-radius: 16px;
            text-align: center;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
            border: 2px solid rgba(212, 175, 55, 0.3);
            backdrop-filter: blur(10px);
        }
        
        .stat-value {
            font-size: 24px;
            font-weight: 900;
            color: #D4AF37;
            margin-bottom: 4px;
            text-shadow: 0 2px 8px rgba(212, 175, 55, 0.5);
        }
        
        .stat-label {
            font-size: 12px;
            color: #e0e0e0;
            font-weight: 600;
        }
        
        .commission-card {
            background: rgba(30, 30, 46, 0.8);
            margin: 16px;
            padding: 20px;
            border-radius: 16px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
            border: 2px solid rgba(212, 175, 55, 0.3);
            backdrop-filter: blur(10px);
        }
        
        .commission-title {
            font-size: 16px;
            font-weight: 900;
            margin-bottom: 16px;
            color: #D4AF37;
            text-shadow: 0 2px 6px rgba(212, 175, 55, 0.3);
        }
        
        .commission-item {
            display: flex;
            justify-content: space-between;
            padding: 12px 0;
            border-bottom: 1px solid rgba(212, 175, 55, 0.1);
        }
        
        .commission-item:last-child {
            border-bottom: none;
        }
        
        .commission-label {
            font-size: 14px;
            color: #e0e0e0;
            font-weight: 500;
        }
        
        .commission-value {
            font-size: 16px;
            font-weight: 900;
            color: #D4AF37;
            text-shadow: 0 2px 6px rgba(212, 175, 55, 0.3);
        }
        
        .action-buttons {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 12px;
            padding: 0 16px 16px;
        }
        
        .copy-btn {
            background: linear-gradient(135deg, #D4AF37 0%, #C5A028 100%);
            color: #000000;
            padding: 16px;
            border-radius: 25px;
            text-align: center;
            font-weight: 900;
            cursor: pointer;
            border: none;
            font-size: 14px;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(212, 175, 55, 0.4);
            text-shadow: 0 1px 2px rgba(255, 255, 255, 0.3);
        }
        
        .copy-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(212, 175, 55, 0.6);
        }
        
        .copy-btn:active {
            transform: translateY(0) scale(0.98);
        }
        
        .team-link {
            background: rgba(30, 30, 46, 0.8);
            margin: 16px;
            padding: 16px;
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            text-decoration: none;
            color: #e0e0e0;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
            border: 2px solid rgba(212, 175, 55, 0.2);
            transition: all 0.3s ease;
        }
        
        .team-link:hover {
            border-color: #D4AF37;
            box-shadow: 0 6px 20px rgba(212, 175, 55, 0.4);
        }
        
        .team-link img {
            width: 32px;
            height: 32px;
            margin-right: 12px;
            filter: drop-shadow(0 2px 4px rgba(212, 175, 55, 0.3));
        }
        
        .team-link span {
            flex: 1;
            font-weight: 700;
        }
        
        .team-link::after {
            content: '›';
            font-size: 24px;
            color: #D4AF37;
        }
        
        .support-btn {
            position: fixed;
            bottom: 100px;
            right: 20px;
            width: 56px;
            height: 56px;
            background: linear-gradient(135deg, #D4AF37 0%, #C5A028 100%);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 4px 20px rgba(212, 175, 55, 0.6);
            z-index: 999;
            cursor: pointer;
            transition: all 0.3s ease;
            animation: supportPulse 2s infinite;
        }
        
        .support-btn:hover {
            transform: scale(1.1);
            box-shadow: 0 6px 25px rgba(212, 175, 55, 0.8);
        }
        
        .support-btn img {
            width: 32px;
            height: 32px;
            filter: brightness(0);
        }
        
        @keyframes supportPulse {
            0%, 100% {
                box-shadow: 0 4px 20px rgba(212, 175, 55, 0.6);
            }
            50% {
                box-shadow: 0 6px 30px rgba(212, 175, 55, 0.9);
            }
        }
    </style>
</head>
<body>
    <!-- Promo Header -->
    <div class="promo-header">
        <h1>Refer & Earn</h1>
        <p>Share your referral code and earn commission!</p>
    </div>

    <!-- Stats Grid -->
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-value" id="f1">0</div>
            <div class="stat-label">Direct subordinates</div>
        </div>
        <div class="stat-card">
            <div class="stat-value" id="f1_today">0</div>
            <div class="stat-label">Today's registrations</div>
        </div>
        <div class="stat-card">
            <div class="stat-value" id="f_total">0</div>
            <div class="stat-label">Team subordinates</div>
        </div>
        <div class="stat-card">
            <div class="stat-value" id="f_all_today">0</div>
            <div class="stat-label">Team registrations (today)</div>
        </div>
    </div>

    <!-- Commission Card -->
    <div class="commission-card">
        <div class="commission-title">Commission Details</div>
        <div class="commission-item">
            <span class="commission-label">Total Commission</span>
            <span class="commission-value">₹<span id="roses_all">0</span></span>
        </div>
        <div class="commission-item">
            <span class="commission-label">Today's Commission</span>
            <span class="commission-value">₹<span id="roses_today">0</span></span>
        </div>
        <div class="commission-item">
            <span class="commission-label" id="roses_f1">Direct Commission: 0</span>
        </div>
        <div class="commission-item">
            <span class="commission-label" id="roses_f">Team Commission: 0</span>
        </div>
    </div>

    <!-- Action Buttons -->
    <div class="action-buttons">
        <button class="copy-btn" id="copyCode">Copy Code</button>
        <button class="copy-btn" id="copyLink">Copy Refer Link</button>
    </div>

    <!-- Team Link -->
    <a href="/myTeam" class="team-link">
        <img src="/images/team.png" alt="Team">
        <span>My Team</span>
    </a>

    <!-- Support Button -->
    <a href="/keFuMenu" class="support-btn">
        <img src="/images/customer-5ef38c22.png" alt="Support">
    </a>

    <!-- Bottom Navigation -->
    <%- include('../nav') -%>

    <!-- Scripts -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script>
        let referralCode = '';
        let referralLink = '';

        // Alert message function
        function alertMess(text) {
            $('body').append(`
                <div style="position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); background: linear-gradient(135deg, #D4AF37 0%, #C5A028 100%); color: #000000; padding: 16px 24px; border-radius: 16px; z-index: 9999; animation: fadeInOut 2s; font-weight: 700; box-shadow: 0 8px 25px rgba(212, 175, 55, 0.6); text-shadow: 0 1px 2px rgba(255, 255, 255, 0.3);">
                    ${text}
                </div>
            `);
            setTimeout(() => {
                $('body > div:last').fadeOut(300, function() { $(this).remove(); });
            }, 1500);
        }

        // Copy to clipboard function
        function copyToClipboard(text) {
            const tempInput = document.createElement('input');
            tempInput.value = text;
            document.body.appendChild(tempInput);
            tempInput.select();
            document.execCommand('copy');
            document.body.removeChild(tempInput);
            alertMess('Copied to clipboard!');
        }

        // Load promotion data
        function loadPromotionData() {
            $.ajax({
                type: "POST",
                url: "/api/webapi/promotion",
                dataType: "json",
                success: function (response) {
                    if (response && response.invite && response.info) {
                        // Update statistics
                        $('#f1').text(response.invite.f1 || 0);
                        $('#f1_today').text(response.invite.f1_today || 0);
                        $('#f_all_today').text(response.invite.f_all_today || 0);
                        $('#f_total').text(response.invite.total_f || 0);
                        
                        // Update commissions
                        $('#roses_f1').text("Direct Commission: " + (response.invite.roses_f1 || 0));
                        $('#roses_f').text("Team Commission: " + (response.invite.roses_f || 0));
                        $('#roses_all').text(response.invite.roses_all || 0);
                        $('#roses_today').text(response.invite.roses_today || 0);
                        
                        // Store referral info
                        referralCode = response.info[0].code;
                        referralLink = window.location.origin + `/register?r_code=${referralCode}`;
                    }
                },
                error: function() {
                    console.error("Failed to load promotion data");
                }
            });
        }

        // Copy code button
        $('#copyCode').click(function() {
            if (referralCode) {
                copyToClipboard(referralCode);
            }
        });

        // Copy link button
        $('#copyLink').click(function() {
            if (referralLink) {
                copyToClipboard(referralLink);
            }
        });

        // Load data on page ready
        $(document).ready(function() {
            loadPromotionData();
        });
    </script>
    <style>
        @keyframes fadeInOut {
            0% { opacity: 0; transform: translate(-50%, -40%); }
            20% { opacity: 1; transform: translate(-50%, -50%); }
            80% { opacity: 1; transform: translate(-50%, -50%); }
            100% { opacity: 0; transform: translate(-50%, -60%); }
        }
    </style>
</body>
</html>
