<link rel="stylesheet" href="/css/main.css">
<link rel="stylesheet" href="/css/home-modern.css">
<style>
    /* Navigation Container - Force position */
    #nav_checkUrl,
    .nav.c-pr {
        position: fixed !important;
        bottom: 0 !important;
        left: 0 !important;
        right: 0 !important;
        top: auto !important;
        width: 100% !important;
        z-index: 9999 !important;
        pointer-events: auto !important;
    }
    
    .block-click {
        pointer-events: auto !important;
    }
    
    .van-hairline--top-bottom,
    .van-tabbar,
    .van-tabbar--fixed {
        background: rgba(42, 42, 42, 0.98) !important;
        backdrop-filter: blur(20px) !important;
        -webkit-backdrop-filter: blur(20px) !important;
        box-shadow: 0 -4px 25px rgba(0, 0, 0, 0.6), 0 0 0 1px rgba(212, 175, 55, 0.1) !important;
        border-top: 2px solid rgba(212, 175, 55, 0.2) !important;
        position: fixed !important;
        top: auto !important;
        bottom: 0 !important;
        left: 0 !important;
        right: 0 !important;
        width: 100% !important;
        height: 70px !important;
        padding: 8px 0 !important;
        display: flex !important;
        justify-content: space-evenly !important;
        align-items: center !important;
        z-index: 9999 !important;
        margin: 0 !important;
        transform: none !important;
    }
    .van-tabbar-item {
        transition: all 0.3s ease;
        margin: 0 2px;
        flex-direction: column !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        padding: 6px 8px !important;
        border-radius: 12px !important;
        cursor: pointer;
        min-width: 60px;
        max-width: 80px;
        flex: 1 1 0;
        height: 100%;
    }
    .van-tabbar-item:hover {
        background: rgba(212, 175, 55, 0.1) !important;
        transform: translateY(-2px);
    }
    .van-tabbar-item__text {
        display: flex !important;
        flex-direction: column !important;
        align-items: center !important;
        justify-content: center !important;
        gap: 2px !important;
        width: 100%;
    }
    .van-tabbar-item__text img {
        width: 26px;
        height: 26px;
        margin-bottom: 4px !important;
        filter: grayscale(1) opacity(0.5);
        transition: all 0.3s ease;
        display: block;
    }
    .van-tabbar-item__text > div {
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        width: 26px;
        height: 26px;
    }
    .van-tabbar-item__text > div.muan {
        width: 26px;
        height: 26px;
    }
    .van-tabbar-item__text > div.muan img {
        width: 26px !important;
        height: 26px !important;
    }
    .van-tabbar-item:hover .van-tabbar-item__text img {
        transform: scale(1.15);
        filter: grayscale(0) opacity(0.8);
    }
    .van-tabbar-item.block-click .van-tabbar-item__text img {
        filter: grayscale(0) opacity(1) drop-shadow(0 0 8px rgba(212, 175, 55, 0.6));
        transform: scale(1.1);
    }
    .van-tabbar-item__text .name {
        font-size: 11px;
        font-weight: 600;
        color: #9ca3af;
        margin: 0 !important;
        padding: 0 !important;
        text-align: center;
        transition: all 0.3s ease;
        line-height: 1.2;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 100%;
    }
    .van-tabbar-item.block-click .van-tabbar-item__text .name {
        color: #D4AF37;
        font-weight: 700;
        text-shadow: 0 0 10px rgba(212, 175, 55, 0.5);
    }
    .van-tabbar-item.block-click {
        background: rgba(212, 175, 55, 0.15) !important;
        box-shadow: 0 0 15px rgba(212, 175, 55, 0.3);
        transform: scale(1.05);
    }
    .van-tabbar-item:hover .van-tabbar-item__text .name {
        color: #fbbf24;
    }
    /* Add padding to body to prevent content from hiding under fixed navbar */
    body {
        padding-bottom: 75px !important;
        margin: 0 !important;
    }
    
    /* Responsive adjustments */
    @media (max-width: 400px) {
        .van-tabbar-item__text .name {
            font-size: 10px;
        }
        .van-tabbar-item__text img {
            width: 24px;
            height: 24px;
        }
        .van-tabbar-item__text > div {
            width: 24px;
            height: 24px;
        }
        .van-tabbar-item__text > div.muan img {
            width: 24px !important;
            height: 24px !important;
        }
    }
    
    @media (min-width: 768px) {
        .van-tabbar {
            max-width: 600px;
            left: 50% !important;
            transform: translateX(-50%);
            border-radius: 20px 20px 0 0;
        }
    }
</style>
<div data-v-432e6ed0="" class="nav c-pr" id="nav_checkUrl" data-url="">
    <div class="van-hairline--top-bottom van-tabbar van-tabbar--fixed">
        <div class="van-tabbar-item" data-url="/home" onclick="location.href='/home'">
            <div class="van-tabbar-item__icon">
                <!---->
            </div>
            <div class="van-tabbar-item__text">
                <div>
                    <img src="/images/home1.png">
                </div>
                <span class="name">Home</span>
            </div>
        </div>
        <div class="van-tabbar-item" data-url="/checkIn" onclick="location.href='/checkIn'">
            <div class="van-tabbar-item__icon">
                <!---->
            </div>
            <div class="van-tabbar-item__text">
                <div>
                    <img src="/images/checked.png">
                </div>
                <span class="name">Rewards</span>
            </div>
        </div>
        <div class="van-tabbar-item" data-url="/promotion" onclick="location.href='/promotion'">
            <div class="van-tabbar-item__icon">
                <!---->
            </div>
            <div class="van-tabbar-item__text">
                <div class="muan">
                    <img src="/images/invite.webp" class="img">
                </div>
                <span class="name">Promotion</span>
            </div>
        </div>
        <div class="van-tabbar-item" data-url="/wallet" onclick="location.href='/wallet'">
            <div class="van-tabbar-item__icon">
                <!---->
            </div>
            <div class="van-tabbar-item__text">
                <div>
                    <img src="/images/wallet.png">
                </div>
                <span class="name">Wallet</span>
            </div>
        </div>
        <div class="van-tabbar-item" data-url="/mian" onclick="location.href='/mian'">
            <div class="van-tabbar-item__icon">
                <!---->
            </div>
            <div class="van-tabbar-item__text">
                <div>
                    <img src="/images/my.png">
                </div>
                <span class="name">Account</span>
            </div>
        </div>
    </div>
</div>
<script>
    let url = window.location.pathname;
    let check = document.querySelector(`.van-tabbar-item[data-url='${url}']`);
    document.querySelector('#nav_checkUrl').setAttribute('data-url', url);
    if (check) check.classList.add('block-click');
    let pathname = document.querySelector('#nav_checkUrl').getAttribute('data-url');
    let listNavs = document.querySelector('#nav_checkUrl .van-hairline--top-bottom').children;
    let select = 0;
    switch (pathname) {
        case '/home':
            select = 0;
            break;
        case '/checkIn':
            select = 1;
            break;
        case '/promotion':
            select = 2;
            break;
        case '/wallet':
            select = 3;
            break;
        case '/mian':
            select = 4;
            break;
        default:
            break;
    }

    let arr = [
        { id: 1, src: '/images/home.png' },
        { id: 2, src: '/images/checkIn.png' },
        { id: 3, src: '/images/invite.webp' },
        { id: 4, src: '/images/wallet2.png' },
        { id: 5, src: '/images/me2.png' },
    ];

    listNavs[select].children[1].children[0].children[0].setAttribute('src', arr[select].src); // img
    listNavs[select].children[1].children[1].classList.add('action'); // name active
</script>