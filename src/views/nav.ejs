<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.css" />
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<style>
    /* Global DIUWIN Bottom Navigation Bar */
    .bottom-nav {
        position: fixed !important;
        bottom: 0 !important;
        left: 50% !important;
        transform: translateX(-50%) !important;
        width: 100% !important;
        max-width: 480px !important;
        background: #0a192f !important;
        border-top: 1.5px solid #D4AF37 !important;
        box-shadow: 0 -4px 20px rgba(0,0,0,0.6) !important;
        z-index: 10000 !important;
        box-sizing: border-box !important;
    }

    .nav-container {
        display: flex !important;
        justify-content: space-around !important;
        align-items: center !important;
        padding: 8px 0 !important;
        margin: 0 !important;
        width: 100% !important;
    }

    .nav-item {
        display: flex !important;
        flex-direction: column !important;
        align-items: center !important;
        justify-content: center !important;
        text-decoration: none !important;
        color: rgba(255, 255, 255, 0.5) !important;
        font-size: 11px !important;
        font-weight: 500 !important;
        gap: 4px !important;
        transition: all 0.3s ease !important;
        flex: 1 !important;
        text-align: center !important;
        background: transparent !important;
        border: none !important;
    }

    .nav-item i {
        font-size: 18px !important;
        transition: all 0.3s ease !important;
        color: rgba(255, 255, 255, 0.5) !important;
    }

    .nav-item span {
        font-size: 11px !important;
        font-family: 'Outfit', sans-serif !important;
        color: rgba(255, 255, 255, 0.5) !important;
    }

    .nav-item.active,
    .nav-item.active i,
    .nav-item.active span {
        color: #FFD700 !important;
        font-weight: 700 !important;
    }

    .nav-item:hover,
    .nav-item:hover i,
    .nav-item:hover span {
        color: #FFD700 !important;
    }

    /* Prevent bottom content from being obscured */
    body {
        padding-bottom: 75px !important;
    }
</style>

<div class="bottom-nav" id="global-bottom-nav">
    <div class="nav-container">
        <a href="/home" class="nav-item" data-url="/home">
            <i class="fa fa-gamepad"></i>
            <span>Games</span>
        </a>
        <a href="/promotion" class="nav-item" data-url="/promotion">
            <i class="fa fa-share-alt"></i>
            <span>Affiliate</span>
        </a>
        <a href="/wallet" class="nav-item" data-url="/wallet">
            <i class="fa fa-credit-card"></i>
            <span>Wallet</span>
        </a>
        <a href="/checkIn" class="nav-item" data-url="/checkIn">
            <i class="fa fa-calendar-check-o"></i>
            <span>Activity</span>
        </a>
        <a href="/mian" class="nav-item" data-url="/mian">
            <i class="fa fa-user"></i>
            <span>Profile</span>
        </a>
    </div>
</div>

<script>
    (function() {
        const currentPath = window.location.pathname;
        document.querySelectorAll('#global-bottom-nav .nav-item').forEach(item => {
            const href = item.getAttribute('data-url');
            if (currentPath === href || (currentPath === '/' && href === '/home')) {
                item.classList.add('active');
            } else {
                item.classList.remove('active');
            }
        });
    })();
</script>